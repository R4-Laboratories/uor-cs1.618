diff --git a/scripts/construct-exporter-backport.py b/scripts/construct-exporter-backport.py
new file mode 100644
index 0000000000000000000000000000000000000000..1670776a6bfaf86d7e5b21f4740a59a2f2082870
--- /dev/null
+++ b/scripts/construct-exporter-backport.py
@@ -0,0 +1,88 @@
+#!/usr/bin/env python3
+"""Reproduce the closed diagnostic Lean authority from an already restored Git tree."""
+import hashlib
+import io
+import json
+from pathlib import Path
+import subprocess
+import sys
+import tarfile
+
+REVISION = '2a13f942b04f0828e03c5d7db7e4db6ecb626d6e'
+TREE = '747d3c5c4ed0d7984a9ebcadc665b10417e5ea84'
+ROOT = Path(__file__).resolve().parent.parent
+
+
+def require(condition, message):
+    # These are authority gates, not debugging assertions: -O must retain them.
+    if not condition:
+        raise ValueError(message)
+
+
+def construct(repo):
+    def git(*args):
+        return subprocess.check_output(['git', '-C', str(repo), *args])
+    require(git('rev-parse', 'HEAD').decode().strip() == REVISION,
+            'compiler revision differs from the pinned authority')
+    require(git('rev-parse', 'HEAD^{tree}').decode().strip() == TREE,
+            'compiler tree differs from the pinned authority')
+    require(not git('status', '--porcelain', '--untracked-files=all').strip(),
+            'compiler checkout is not clean')
+    rows = []
+    output = io.BytesIO()
+    with tarfile.open(fileobj=output, mode='w', format=tarfile.USTAR_FORMAT) as archive:
+        for raw in git('ls-tree', '-rz', 'HEAD', '--', 'lean/').split(b'\0'):
+            if not raw:
+                continue
+            metadata, raw_path = raw.split(b'\t')
+            mode, kind, oid = metadata.decode().split()
+            path = raw_path.decode()
+            require(kind == 'blob' and mode in ('100644', '100755'),
+                    f'unsupported compiler member kind or mode: {path}')
+            name = path.removeprefix('lean/')
+            require(path.startswith('lean/') and not any(part.startswith('.') for part in Path(name).parts),
+                    f'unsupported compiler member path: {path}')
+            data = git('cat-file', 'blob', oid)
+            require((repo / path).read_bytes() == data,
+                    f'compiler member differs from Git: {path}')
+            header = tarfile.TarInfo(name)
+            header.mode = int(mode, 8) & 0o777
+            header.size = len(data)
+            archive.addfile(header, io.BytesIO(data))
+            rows.append({'path': name, 'mode': header.mode, 'sha256': hashlib.sha256(data).hexdigest()})
+    data = output.getvalue()
+    # Independent member-byte/mode equality, including exact membership.
+    with tarfile.open(fileobj=io.BytesIO(data)) as archive:
+        members = archive.getmembers()
+        require(len(members) == len(rows), 'archive membership differs from Git')
+        for member, row in zip(members, rows):
+            require(member.isfile() and member.name == row['path'] and member.mode == row['mode'],
+                    'archive member kind, path or mode differs from Git')
+            require(archive.extractfile(member).read() == git('show', 'HEAD:lean/' + member.name),
+                    f'archive member bytes differ from Git: {member.name}')
+    descriptor = {
+        'schema': 'prismpm/exporter-source/1', 'id': 'numeric-task2c', 'diagnostic_only': True,
+        'upstream_repository': 'https://github.com/afflom/lean4-prod',
+        'upstream_base': '991956fe427bb646498fd0912c89b71be71e7beb',
+        'compiler_revision': REVISION, 'compiler_tree': TREE,
+        'distribution_repository': 'https://github.com/R4-Laboratories/uor-cs1.618',
+        'distribution_commit': '3e58e37161a6b8584c913b486484848bf3f3c046',
+        'distribution_path': 'scripts/numeric/compiler-candidate',
+        'bundle_sha256': 'ad555eb1d133fa3cbe04362606da005c112565ba9255806c4e67d47e390734e4',
+        'patch_sha256': '0278ee47e9210484a4481b0afe1589a1da29f31fc5e624adb94580c065e31373',
+        'base_sdk_digest': 'sha256:d6c263a733a6bc36e0458c3f5b9a1f5ea9c14dfbe8c257d3f650a960b5fe633c',
+        'toolchain': 'leanprover/lean4:v4.32.1',
+        'archive_sha256': hashlib.sha256(data).hexdigest(),
+        'compiled_closure': 'Tracked lean/ files only; Rust generator dependencies remain at the released dependency pins.',
+        'members': rows,
+    }
+    destination = ROOT / 'vendor/lean4-prod/backports/numeric-task2c'
+    destination.mkdir(parents=True, exist_ok=True)
+    (destination / 'lean.tar').write_bytes(data)
+    (destination / 'descriptor.json').write_text(json.dumps(descriptor, sort_keys=True, separators=(',', ':')) + '\n')
+    print(descriptor['archive_sha256'])
+    print(hashlib.sha256((destination / 'descriptor.json').read_bytes()).hexdigest())
+
+
+if __name__ == '__main__':
+    construct(Path(sys.argv[1]).resolve())
diff --git a/scripts/construct-exporter-backport.test.mjs b/scripts/construct-exporter-backport.test.mjs
new file mode 100644
index 0000000000000000000000000000000000000000..8ff5eaf8683bbe81a31d60b27c5c0f8e7fe7ab1b
--- /dev/null
+++ b/scripts/construct-exporter-backport.test.mjs
@@ -0,0 +1,55 @@
+import assert from 'node:assert/strict';
+import { copyFileSync, mkdirSync, mkdtempSync, readFileSync, rmSync, writeFileSync } from 'node:fs';
+import { tmpdir } from 'node:os';
+import { join } from 'node:path';
+import { spawnSync } from 'node:child_process';
+import { fileURLToPath } from 'node:url';
+import test from 'node:test';
+
+const root = fileURLToPath(new URL('../', import.meta.url));
+const artifactPath = 'vendor/lean4-prod/backports/numeric-task2c';
+
+for (const optimization of ['flag', 'environment']) {
+  test(`optimized constructor refuses a wrong revision without writing artifacts (${optimization})`, () => {
+    const work = mkdtempSync(join(tmpdir(), 'exporter-construction-'));
+    try {
+      const repo = join(work, 'source');
+      mkdirSync(join(repo, 'lean'), { recursive: true });
+      writeFileSync(join(repo, 'lean', 'Wrong.lean'), 'def wrongRevision := true\n');
+      for (const args of [
+        ['init', '--quiet'], ['add', 'lean'],
+        ['-c', 'user.name=Fixture', '-c', 'user.email=fixture@example.invalid',
+          '-c', 'commit.gpgsign=false', 'commit', '--quiet', '-m', 'Wrong compiler revision'],
+      ]) {
+        const result = spawnSync('git', ['-C', repo, ...args], { encoding: 'utf8', timeout: 10000 });
+        assert.equal(result.status, 0, result.stderr);
+      }
+      mkdirSync(join(work, 'scripts'));
+      const script = join(work, 'scripts', 'construct-exporter-backport.py');
+      copyFileSync(join(root, 'scripts', 'construct-exporter-backport.py'), script);
+      const destination = join(work, artifactPath);
+      mkdirSync(destination, { recursive: true });
+      const before = new Map();
+      for (const name of ['lean.tar', 'descriptor.json']) {
+        const bytes = readFileSync(join(root, artifactPath, name));
+        before.set(name, bytes);
+        writeFileSync(join(destination, name), bytes);
+      }
+      const result = spawnSync('python3', [
+        ...(optimization === 'flag' ? ['-O'] : []), script, repo,
+      ], {
+        encoding: 'utf8', timeout: 10000,
+        env: { ...process.env, PYTHONOPTIMIZE: optimization === 'environment' ? '1' : '' },
+      });
+      assert.equal(result.error, undefined);
+      assert.equal(result.signal, null);
+      assert.notEqual(result.status, 0, 'wrong source must fail under optimized Python');
+      assert.match(result.stderr, /compiler revision differs/);
+      for (const [name, bytes] of before) {
+        assert.deepEqual(readFileSync(join(destination, name)), bytes, `${name} changed on refusal`);
+      }

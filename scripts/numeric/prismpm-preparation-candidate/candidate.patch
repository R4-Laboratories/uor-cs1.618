+// Test-only bridge for genuine outputs of the same new CLI in the unchanged
+// SDK. This exposes no production admission API and takes no source selector;
+// each reader resolves its authority exclusively from retained receipts.
+fn replay_retained_backport_projects(root: &std::path::Path) {
+    use crate::exporter::Source;
+    assert_eq!(Source::default(), Source::Released);
+    let mut baseline = None;
+    for (name, expected) in [
+        ("default", Source::Released),
+        ("released", Source::Released),
+        ("numeric-task2c", Source::NumericTask2c),
+    ] {
+        let result: crate::controller::VerifyResult =
+            serde_json::from_slice(&std::fs::read(root.join(format!("{name}.json"))).unwrap())
+                .unwrap();
+        let project = root.join(name);
+        let build_root = project.join(".prism/build").join(&result.build_id);
+        safe_path(&result.verified_root).unwrap();
+        let verified = project.join(&result.verified_root);
+        let read_tree = |path: &std::path::Path| {
+            walkdir::WalkDir::new(path)
+                .min_depth(1)
+                .into_iter()
+                .filter_map(|entry| {
+                    let entry = entry.unwrap();
+                    assert!(!entry.file_type().is_symlink());
+                    if entry.file_type().is_dir() {
+                        return None;
+                    }
+                    assert!(entry.file_type().is_file());
+                    Some((
+                        entry
+                            .path()
+                            .strip_prefix(path)
+                            .unwrap()
+                            .to_str()
+                            .unwrap()
+                            .to_owned(),
+                        std::fs::read(entry.path()).unwrap(),
+                    ))
+                })
+                .collect::<BTreeMap<String, Vec<u8>>>()
+        };
+        let mut build_files = read_tree(&build_root);
+        let build_manifest = build_files.remove("manifest.json").unwrap();
+        let verification_files = read_tree(&verified);
+        let lock =
+            crate::sdk::parse_lock(&std::fs::read(project.join("prismpm.lock")).unwrap()).unwrap();
+        let binding =
+            validate_with_authority(&build_manifest, &build_files, &verification_files, || {
+                Ok(lock.value().clone())
+            })
+            .unwrap();
+        assert_eq!(binding.family, "application");
+        assert_eq!(binding.build_id, result.build_id);
+        assert_eq!(binding.attestation_id, result.attestation_id);
+        let manifest = canonical_json(&verification_files["manifest.json"], false).unwrap();
+        let execution = &manifest["processes"].as_array().unwrap().last().unwrap()["exporter"];
+        assert_eq!(
+            Source::from_receipt(&execution["acquisition"]).unwrap(),
+            expected
+        );
+        assert_eq!(
+            execution["acquisition"]["mode"],
+            if expected == Source::Released {
+                "sdk-seed"
+            } else {
+                "source-backport"
+            }
+        );
+        if name == "default" {
+            baseline = Some(result.build_id.clone());
+        }
+        if name == "released" {

+/// Private execution accounting; serialized process evidence retains its existing
+/// normalized streams and closed fields. Charge original bytes before normalization.
+#[derive(Debug)]
+pub(crate) struct MeasuredProcess {
+    record: ProcessRecord,
+    raw_stdout_bytes: usize,
+    raw_stderr_bytes: usize,
+}
+impl MeasuredProcess {
+    pub(crate) fn charge(
+        self,
+        remaining: &mut (usize, usize),
+    ) -> Result<ProcessRecord, PrismError> {
+        let stdout = remaining
+            .0
+            .checked_sub(self.raw_stdout_bytes)
+            .ok_or_else(|| {
+                PrismError::new("PP5007", "native frontend total stdout limit exceeded")
+            })?;
+        let stderr = remaining
+            .1
+            .checked_sub(self.raw_stderr_bytes)
+            .ok_or_else(|| {
+                PrismError::new("PP5007", "native frontend total stderr limit exceeded")
+            })?;
+        *remaining = (stdout, stderr);
+        Ok(self.record)
+    }
+}

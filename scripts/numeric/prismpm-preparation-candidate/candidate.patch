+        || value["compiler_revision"] != source.revision()
+        || value["toolchain"] != "leanprover/lean4:v4.32.1"
+        || !matches!(
+            value["platform"].as_str(),
+            Some("linux/amd64" | "linux/arm64")
+        )
+    {
+        return Err(fail());
+    }

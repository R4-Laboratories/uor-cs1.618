+    #[test]
+    fn backport_authority_registry_is_closed_and_original_pins_are_unchanged() {
+        assert_eq!(Source::default(), Source::parse("released").unwrap());
+        assert_eq!(
+            Source::Released.archive_sha256(),
+            "7a1a716a57040ea2307f7a34e895a75ebdca7438cf9d5d0364007acb594366bf"
+        );
+        for supplied in [
+            "",
+            "numeric-task2c/../released",
+            "/tmp/lean.tar",
+            "https://github.com/afflom/lean4-prod",
+            "2a13f942b04f0828e03c5d7db7e4db6ecb626d6e",
+        ] {
+            assert_eq!(Source::parse(supplied).unwrap_err().code, "PP1001");
+        }
+        let candidate = Source::parse("numeric-task2c").unwrap();
+        let descriptor: serde_json::Value = serde_json::from_slice(candidate.descriptor()).unwrap();
+        assert_eq!(descriptor["archive_sha256"], candidate.archive_sha256());
+        assert_eq!(descriptor["compiler_revision"], candidate.revision());
+        assert_eq!(descriptor["id"], candidate.id());
+        assert_eq!(descriptor["diagnostic_only"], true);
+        assert_eq!(
+            descriptor["distribution_commit"],
+            "3e58e37161a6b8584c913b486484848bf3f3c046"
+        );
+        assert_eq!(
+            Source::from_archive(&candidate.archive_sha256()).unwrap(),
+            candidate
+        );
+        let register: toml::Value =
+            toml::from_str(include_str!("../../model/dependencies.toml")).unwrap();
+        let dependency = &register["dependency"].as_array().unwrap()[0];
+        assert_eq!(
+            dependency["revision"].as_str(),
+            Some(Source::Released.revision())

+ assert.equal(frontend.schema,'prismpm/library-frontend/1');assert.equal(frontend.profile,'lean-frontend-lcnf/1');assert.equal(frontend.working_directory,'$LIBRARY_WORK');
+ hex(frontend.launcher_sha256);hex(frontend.lean_sha256);same(frontend.environment,{LC_ALL:'C',LANG:'C',LEAN_PATH:output,LEAN_NUM_THREADS:'2'});
+ assert(Array.isArray(frontend.modules)&&frontend.modules.length>0);assert(processes.length>=frontend.modules.length+1);
+ assert.equal(processes[0].tool,'library-lean-version');same(processes[0].argv,['--version']);
+ assert.match(processes[0].stdout,/^Lean \(version 4\.32\.1, (?:x86_64|aarch64)-unknown-linux-gnu, commit f054605aea4b840552cca2e725580bffd1e1b704, Release\)\n$/);
+ assert.equal(processes[0].stderr,'');
+ const done=new Set(builtins),all=new Set();
+ for(const [index,module] of frontend.modules.entries()){
+  keys(module,['name','source','imports','runtime','artifacts']);assert(name(module.name));assert(!all.has(module.name));all.add(module.name);
+  assert.equal(module.runtime,module.name.startsWith('LexLeanRuntime.'));assert(module.runtime||!reserved(module.name));
+  const check=b=>{keys(b,['path','byte_length','sha256']);hex(b.sha256);assert(Number.isSafeInteger(b.byte_length)&&b.byte_length>0);};
+  check(module.source);assert.equal(module.source.path,module.name.replaceAll('.','/')+'.lean');
+  assert(Array.isArray(module.imports)&&module.imports.includes('Init'));same(module.imports,[...new Set(module.imports)].sort());
+  assert(module.imports.every(n=>done.has(n)));done.add(module.name);
+  same(module.artifacts.map(a=>a.path),artifactPaths(module.name));module.artifacts.forEach(check);
+  assert.equal(processes[index+1].tool,'library-lean-frontend');same(processes[index+1].argv,frontendArguments(module.name));
+ }
+ let pending=[...frontend.modules],seen=new Set(builtins);
+ for(const module of frontend.modules){const next=pending.filter(m=>m.imports.every(i=>seen.has(i))).sort((a,b)=>a.name<b.name?-1:1)[0];assert(next);assert.equal(next.name,module.name);seen.add(module.name);pending=pending.filter(m=>m.name!==module.name);}

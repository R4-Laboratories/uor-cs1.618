+//! Closed, compiled compiler-source authorities. Never caller paths or URLs.
+use crate::PrismError;
+use sha2::{Digest, Sha256};
+
+#[derive(Clone, Copy, Debug, Default, PartialEq, Eq)]
+pub(crate) enum Source {
+    #[default]
+    Released,
+    NumericTask2c,
+}
+
+impl Source {
+    pub(crate) fn parse(id: &str) -> Result<Self, PrismError> {
+        match id {
+            "released" => Ok(Self::Released),
+            "numeric-task2c" => Ok(Self::NumericTask2c),
+            _ => Err(PrismError::new(
+                "PP1001",
+                "unknown closed exporter source ID",
+            )),
+        }
+    }
+    pub(crate) fn id(self) -> &'static str {
+        match self {
+            Self::Released => "released",
+            Self::NumericTask2c => "numeric-task2c",
+        }
+    }
+    pub(crate) fn archive(self) -> &'static [u8] {
+        match self {
+            Self::Released => super::ARCHIVE,
+            Self::NumericTask2c => {
+                include_bytes!("../../vendor/lean4-prod/backports/numeric-task2c/lean.tar")
+            }
+        }
+    }
+    pub(crate) fn archive_path(self) -> &'static str {
+        match self {
+            Self::Released => "vendor/lean4-prod/lean.tar",
+            Self::NumericTask2c => "vendor/lean4-prod/backports/numeric-task2c/lean.tar",
+        }
+    }
+    pub(crate) fn archive_sha256(self) -> String {
+        format!("{:x}", Sha256::digest(self.archive()))
+    }
+    pub(crate) fn descriptor(self) -> &'static [u8] {
+        match self {
+            Self::Released => b"prismpm/exporter-source/released/1\0",
+            Self::NumericTask2c => {
+                include_bytes!("../../vendor/lean4-prod/backports/numeric-task2c/descriptor.json")
+            }
+        }
+    }
+    pub(crate) fn descriptor_sha256(self) -> String {
+        format!("{:x}", Sha256::digest(self.descriptor()))
+    }
+    pub(crate) fn revision(self) -> &'static str {
+        match self {
+            Self::Released => "991956fe427bb646498fd0912c89b71be71e7beb",
+            Self::NumericTask2c => "2a13f942b04f0828e03c5d7db7e4db6ecb626d6e",
+        }
+    }
+    pub(crate) fn from_archive(digest: &str) -> Result<Self, PrismError> {
+        let mut matches = [Self::Released, Self::NumericTask2c]
+            .into_iter()
+            .filter(|source| source.archive_sha256() == digest);
+        match (matches.next(), matches.next()) {
+            (Some(source), None) => Ok(source),
+            _ => Err(PrismError::new(
+                "PP5008",
+                "exporter source archive is not uniquely registered",
+            )),
+        }
+    }
+    /// Existing receipts have only the original authority; candidate evidence
+    /// names a closed registry member and its exact descriptor, never new pins.
+    pub(crate) fn from_receipt(receipt: &serde_json::Value) -> Result<Self, PrismError> {
+        if receipt["mode"] == "source-backport" {
+            if receipt["source_id"] == Self::NumericTask2c.id()
+                && receipt["descriptor_sha256"] == Self::NumericTask2c.descriptor_sha256()
+            {
+                return Ok(Self::NumericTask2c);
+            }
+            return Err(PrismError::new(
+                "PP5008",
+                "exporter source descriptor differs",
+            ));
+        }
+        Ok(Self::Released)
+    }
+    pub(crate) fn frame(self, bytes: &mut Vec<u8>) {
+        for field in [
+            b"prismpm/exporter-source/1".as_slice(),
+            self.id().as_bytes(),
+            self.descriptor(),
+        ] {
+            bytes.extend_from_slice(&(field.len() as u64).to_be_bytes());
+            bytes.extend_from_slice(field);
+        }
+    }
+}
+

+ const wanted=new Set(frontend.modules.filter(m=>!m.runtime).flatMap(m=>m.imports).filter(i=>i.startsWith('LexLeanRuntime.')));
+ for(let changed=true;changed;){changed=false;for(const n of [...wanted]){const m=runtime.find(r=>r.name===n);assert(m,'known pinned runtime');for(const dep of m.imports.filter(i=>!builtins.includes(i)))if(!wanted.has(dep)){wanted.add(dep);changed=true;}}}
+ same(frontend.modules.filter(m=>m.runtime).map(m=>m.name).sort(),[...wanted].sort());
+ for(const module of frontend.modules.filter(m=>m.runtime)){const expected=runtime.find(r=>r.name===module.name);same(module.source,expected.source);same(module.imports,expected.imports);}
+ for(const row of processes.slice(0,frontend.modules.length+1)){
+  keys(row,['tool','argv','executable_sha256','exit_code','stdout','stderr']);assert.equal(row.exit_code,0);assert.equal(row.executable_sha256,frontend.lean_sha256);

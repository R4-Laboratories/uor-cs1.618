diff --git a/lean/Conformance/NumericClosureFixture.lean b/lean/Conformance/NumericClosureFixture.lean
new file mode 100644
index 0000000000000000000000000000000000000000..aa737405f8f3342e5a4066634ab52be70a93445e
--- /dev/null
+++ b/lean/Conformance/NumericClosureFixture.lean
@@ -0,0 +1,90 @@
+import Conformance.LexLeanPortable
+
+/-! Compiler-owned probes; not replacements for generated application modules. -/
+namespace NumericRenamed
+open SemanticFixture.Portable.LexLeanRuntime
+-- Outside the roots' namespace and deliberately unrelated to instance spelling.
+@[implicit_reducible] def sourceDictionary : ToMathInt UInt32 := inferInstance
+@[implicit_reducible] def targetDictionary : Fixed UInt64 := inferInstance
+end NumericRenamed
+
+namespace NumericFixture
+open SemanticFixture.Portable
+
+def step (x : UInt32) : Option UInt32 := LexLeanRuntime.checkedAdd x 1
+
+def repeat4 (x : UInt32) : Option UInt32 := do
+  let a ← step x
+  let b ← step a
+  let c ← step b
+  step c
+
+def signedStep (x : Int16) : Option Int16 := LexLeanRuntime.checkedAdd x 1
+
+def signedTwice (x : Int16) : Option Int16 := do
+  let a ← signedStep x
+  signedStep a
+
+def widen (x : UInt32) : Option UInt64 := LexLeanRuntime.checkedConvert x
+def unsignedSigned (x : UInt16) : Option Int64 := LexLeanRuntime.checkedConvert x
+def narrow (x : Int64) : Option Int16 := LexLeanRuntime.checkedConvert x
+def signedUnsigned (x : Int16) : Option UInt32 := LexLeanRuntime.checkedConvert x
+def wideSigned (x : UInt64) : Option Int64 := LexLeanRuntime.checkedConvert x
+def renamed (x : UInt32) : Option UInt64 :=
+  @LexLeanRuntime.checkedConvert UInt32 UInt64 NumericRenamed.sourceDictionary
+    NumericRenamed.targetDictionary x
+
+structure Counter where
+  value : UInt32
+  count : UInt32
+
+def countStep (delta : UInt32) (state : Option Counter) : Option Counter := do
+  let state ← state
+  let value ← LexLeanRuntime.checkedAdd state.value delta
+  let count ← LexLeanRuntime.checkedAdd state.count 1
+  pure ⟨value, count⟩
+
+def countedLoop : Nat → UInt32 → Option Counter → Option Counter
+  | 0, _, state => state
+  | n + 1, delta, state => countedLoop n delta (countStep delta state)
+
+def counted (fuel : Nat) (delta x : UInt32) : Option Counter :=
+  if fuel ≤ 128 then countedLoop fuel delta (some ⟨x, 0⟩) else none
+
+-- Four independent semantic mutations: nominal dictionary type alone is insufficient.
+@[implicit_reducible] def badSource : LexLeanRuntime.ToMathInt UInt32 where
+  toInt := fun x => Int.ofNat x.toNat + 1
+
+@[implicit_reducible] def badMinimum : LexLeanRuntime.Fixed UInt64 :=
+  { (inferInstance : LexLeanRuntime.Fixed UInt64) with minimum := 1 }
+@[implicit_reducible] def badMaximum : LexLeanRuntime.Fixed UInt64 :=
+  { (inferInstance : LexLeanRuntime.Fixed UInt64) with maximum := 100 }
+@[implicit_reducible] def badFromInt : LexLeanRuntime.Fixed UInt64 :=
+  { (inferInstance : LexLeanRuntime.Fixed UInt64) with fromInt := fun _ => 0 }
+
+-- Safe and kernel-total does not mean erasable under bounded target arithmetic.
+-- NumericConversion inserts these calls after extraction so simplifier DCE
+-- cannot remove the eager computations before the production pass is tested.
+def maxNat : Nat := 18446744073709551615
+def oneNat : Nat := 1
+def canonicalAfter (_ : Nat) : LexLeanRuntime.Fixed UInt64 := inferInstance
+def canonicalAfterAlias : Nat → LexLeanRuntime.Fixed UInt64 := canonicalAfter
+def overflowAlias : Nat := maxNat + oneNat
+def hiddenScalarDictionary : LexLeanRuntime.Fixed UInt64 :=
+  canonicalAfterAlias overflowAlias
+def hiddenBranchDictionary : LexLeanRuntime.Fixed UInt64 :=
+  if maxNat + oneNat == 0 then badMaximum else inferInstance
+
+def alteredSource (x : UInt32) : Option UInt64 :=
+  @LexLeanRuntime.checkedConvert UInt32 UInt64 badSource inferInstance x
+def alteredMinimum (x : UInt32) : Option UInt64 :=
+  @LexLeanRuntime.checkedConvert UInt32 UInt64 inferInstance badMinimum x
+def alteredMaximum (x : UInt32) : Option UInt64 :=
+  @LexLeanRuntime.checkedConvert UInt32 UInt64 inferInstance badMaximum x
+def alteredFromInt (x : UInt32) : Option UInt64 :=
+  @LexLeanRuntime.checkedConvert UInt32 UInt64 inferInstance badFromInt x
+
+-- A dictionary escaping conversion remains outside the first-order target subset.
+def liveDictionary (x : UInt32) : Option UInt64 × LexLeanRuntime.Fixed UInt64 :=
+  (LexLeanRuntime.checkedConvert x, inferInstance)
+end NumericFixture
diff --git a/lean/Conformance/NumericConversion.lean b/lean/Conformance/NumericConversion.lean

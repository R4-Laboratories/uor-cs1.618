index 0000000000000000000000000000000000000000..edcd2b23719c375a090b4a9edc59bc1c4f629e55
--- /dev/null
+++ b/lean/Conformance/NumericConversion.lean
@@ -0,0 +1,76 @@
+import Prod.Export
+import Conformance.NumericClosureFixture
+
+open Lean Compiler LCNF
+
+private partial def changeConversion (code : Code .pure) (wrongResult : Bool)
+    : Code .pure :=
+  match code with
+  | .let decl rest =>
+    let decl := match decl.value with
+      | .const name _ _ =>
+        if Prod.isLexLeanRuntimeName name && Prod.lastComponent name == "checkedConvert" && wrongResult
+        then { decl with type := mkApp (mkConst ``Option [levelZero]) (mkConst ``UInt8) }
+        else decl
+      | _ => decl
+    .let decl (changeConversion rest wrongResult)
+  | _ => code
+
+run_meta do
+  let roots := #[``NumericFixture.counted, ``NumericFixture.narrow, ``NumericFixture.renamed,
+    ``NumericFixture.repeat4, ``NumericFixture.signedTwice, ``NumericFixture.signedUnsigned,
+    ``NumericFixture.unsignedSigned, ``NumericFixture.wideSigned, ``NumericFixture.widen]
+  let exported ← Prod.exportNames roots "Numeric"
+  for marker in ["(unsupported ", "(extern ", "(opaque ", "(type \"SemanticFixture.Portable.LexLeanRuntime.Fixed\""] do
+    unless (exported.ir.splitOn marker).length == 1 do
+      throwError "canonical numeric export retained {marker}"
+  IO.FS.createDirAll "../output/numeric"
+  IO.FS.writeFile "../output/numeric/kernel.ir" exported.ir
+  IO.FS.writeFile "../output/numeric/coverage.json" exported.coverage
+  IO.FS.writeFile "../output/numeric/roots.json" exported.roots
+  for root in [``NumericFixture.alteredSource, ``NumericFixture.alteredMinimum,
+      ``NumericFixture.alteredMaximum, ``NumericFixture.alteredFromInt] do
+    let rejected ← try
+      let _ ← Prod.exportNames #[root] "Rejected"
+      pure false
+    catch error =>
+      let message ← error.toMessageData.toString
+      unless (message.splitOn "noncanonical checkedConvert").length > 1 do
+        throwError "wrong rejection for {root}: {message}"
+      pure true
+    unless rejected do throwError "altered conversion admitted: {root}"
+  let live ← Prod.exportNames #[``NumericFixture.liveDictionary] "LiveDictionary"
+  unless (live.ir.splitOn "(unsupported ").length > 1 &&
+      (live.coverage.splitOn "Fixed").length > 1 do
+    throwError "live generic dictionary was silently erased or omitted from coverage"
+  IO.FS.writeFile "../output/numeric/live-dictionary.ir" live.ir
+  let extracted ← Prod.extractNames #[``NumericFixture.widen]
+  let some decl := extracted[0]!.decl? | throwError "missing widen declaration"
+  let .code code := decl.value | throwError "missing widen code"
+  for wrongResult in [false, true] do
+    let mutant := if wrongResult then
+      { decl with value := .code (changeConversion code true) }
+    else
+      { decl with params := decl.params.map fun p => { p with type := mkConst ``UInt8 } }
+    let rejected ← try
+      let _ ← Prod.normalizeConversions mutant
+      pure false
+    catch error =>
+      let message ← error.toMessageData.toString
+      unless (message.splitOn "operand/result type mismatch").length > 1 do
+        throwError "wrong typed rejection: {message}"
+      pure true
+    unless rejected do throwError "mistyped conversion admitted"
+  -- Test the normalization pass, not Lean simplifier DCE: insert a real unused
+  -- bounded-target failure into already-extracted LCNF and lower through production.
+  let large : LetDecl .pure := ⟨⟨`large⟩, `large, mkConst ``Nat, .lit (.nat 18446744073709551615)⟩
+  let one : LetDecl .pure := ⟨⟨`one⟩, `one, mkConst ``Nat, .lit (.nat 1)⟩
+  let failure : LetDecl .pure := ⟨⟨`unusedFailure⟩, `unusedFailure, mkConst ``Nat,
+    .const ``Nat.add [] #[.fvar large.fvarId, .fvar one.fvarId]⟩
+  let failing := { decl with name := `NumericFixture.unusedFailure,
+    value := .code (.let large (.let one (.let failure code))) }
+  let (ir, _, _) ← Prod.emitKernelIr { tagged := #[failing.name] } "UnusedFailure"
+    #[{ name := failing.name, decl? := some failing, skipReason := "" }]
+  unless (ir.splitOn "(add ").length > 1 do throwError "unused failing computation erased"
+  IO.FS.writeFile "../output/numeric/unused-failure.ir" ir
+  logInfo "numeric conversions: canonical, renamed, four semantic and two type refusals, live residue, and failing unused operation"
diff --git a/lean/Prod/Conversion.lean b/lean/Prod/Conversion.lean
new file mode 100644
index 0000000000000000000000000000000000000000..4127d1ccb4eea150781fcd9a21fdfe5cebd39b00
--- /dev/null
+++ b/lean/Prod/Conversion.lean
@@ -0,0 +1,179 @@
+import Prod.Lower
+import Lean.Compiler.LCNF.FVarUtil
+
+/-! Normalize only canonical, closed checked-conversion dictionaries. This pass
+runs before type discovery and lowering, which must see exactly the same graph.
+It is not general dead-code elimination or runtime dictionary support. -/
+open Lean Compiler LCNF
+namespace Prod
+
+private abbrev Values := Std.HashMap Name Expr
+private abbrev Types := Std.HashMap Name Expr
+private abbrev Consumed := Std.HashSet Name
+private abbrev ConvertM := StateT Consumed CoreM
+
+private def fixedBounds (name : Name) : Option (Int × Int) :=
+  if name == ``UInt8 then some (0, 255)
+  else if name == ``UInt16 then some (0, 65535)
+  else if name == ``UInt32 then some (0, 4294967295)
+  else if name == ``UInt64 then some (0, 18446744073709551615)
+  else if name == ``Int8 then some (-128, 127)
+  else if name == ``Int16 then some (-32768, 32767)
+  else if name == ``Int32 then some (-2147483648, 2147483647)
+  else if name == ``Int64 then some (-9223372036854775808, 9223372036854775807)
+  else none
+
+private def canonicalToInt (name : Name) : Option Expr :=
+  if name == ``Int then
+    some (.lam `value (mkConst ``Int) (.bvar 0) .default)
+  else if [``Int8, ``Int16, ``Int32, ``Int64].contains name then
+    some (mkConst (name ++ `toInt))
+  else if [``UInt8, ``UInt16, ``UInt32, ``UInt64].contains name then
+    some (.lam `value (mkConst name)
+      (mkApp (mkConst ``Int.ofNat) (mkApp (mkConst (name ++ `toNat)) (.bvar 0))) .default)
+  else none
+
+/-- Only reconstruct closed total kernel terms. Unknown arguments stay unknown,
+    and thus cannot authorize removal of a live dictionary graph. -/
+private def closedValue? (values : Values) (value : LetValue .pure) : CoreM (Option Expr) := do
+  match value with
+  | .const name levels args =>
+    let some info := (← getEnv).find? name | return none
+    if info.isPartial then return none
+    match info with
+    | .defnInfo defn =>
+      match defn.safety with
+      | .safe => pure ()
+      | _ => return none
+    | .ctorInfo _ => pure ()
+    | _ => return none
+    let mut term := mkConst name levels
+    for arg in args do
+      match arg with
+      | .type type =>
+        if type.hasFVar || type.hasLooseBVars || type.hasMVar then return none
+        term := mkApp term type
+      | .fvar id =>
+        let some arg := values[id.name]? | return none
+        term := mkApp term arg
+      | .erased => return none
+    return some term
+  | .proj name index id =>
+    return (values[id.name]?).map (Expr.proj name index)
+  | _ => return none
+
+private def typeArgument (dictionary : Expr) (classPart : String) : MetaM (Name × Expr) := do
+  let type ← Meta.whnf (← Meta.inferType dictionary)
+  let .app (.const className _) argument := type
+    | throwError "noncanonical checkedConvert dictionary type"
+  unless isLexLeanRuntimeName className && lastComponent className == classPart do
+    throwError "noncanonical checkedConvert dictionary class"
+  return (className, argument)
+
+private def validateConversion (source target operand result : Expr) : CoreM Unit :=
+  Meta.MetaM.run' do
+    let (sourceClass, sourceType) ← typeArgument source "ToMathInt"
+    let (targetClass, targetType) ← typeArgument target "Fixed"
+    let .const sourceName _ := sourceType
+      | throwError "noncanonical checkedConvert source type"
+    let .const targetName _ := targetType
+      | throwError "noncanonical checkedConvert target type"
+    let some interpretation := canonicalToInt sourceName
+      | throwError "noncanonical checkedConvert source interpretation"
+    let some (minimum, maximum) := fixedBounds targetName
+      | throwError "noncanonical checkedConvert target bounds"
+    unless (← Meta.isDefEq operand sourceType) &&
+        (← Meta.isDefEq result (mkApp (mkConst ``Option [levelZero]) targetType)) do
+      throwError "checkedConvert operand/result type mismatch"
+    -- Infer/check every reconstructed term before trusting projection reduction.
+    let _ ← Meta.check source
+    let _ ← Meta.check target
+    let checks := #[(Expr.proj sourceClass 0 source, interpretation),
+      (Expr.proj targetClass 1 target, mkConst (targetName ++ `ofInt)),
+      (Expr.proj targetClass 2 target, toExpr minimum),
+      (Expr.proj targetClass 3 target, toExpr maximum)]
+    for (actual, expected) in checks do
+      unless (← Meta.isDefEq actual expected) do
+        throwError "noncanonical checkedConvert dictionary semantics"
+
+private def addParams (types : Types) (params : Array (Param .pure)) : Types :=
+  params.foldl (fun types param => types.insert param.fvarId.name param.type) types
+
+private partial def normalizeCode (values : Values) (types : Types)
+    (code : Code .pure) : ConvertM (Code .pure) := do
+  match code with
+  | .let decl rest =>
+    let mut value := decl.value
+    if let .const name levels args := value then
+      if isLexLeanRuntimeName name && lastComponent name == "checkedConvert" then
+        let #[sourceType, targetType, .fvar source, .fvar target, .fvar input] := args
+          | throwError "noncanonical checkedConvert argument shape"
+        unless (match sourceType with | .erased | .type _ => true | _ => false) &&
+            (match targetType with | .erased | .type _ => true | _ => false) do
+          throwError "noncanonical checkedConvert type arguments"
+        let some sourceExpr := values[source.name]?
+          | throwError "noncanonical checkedConvert open source dictionary"
+        let some targetExpr := values[target.name]?
+          | throwError "noncanonical checkedConvert open target dictionary"
+        let some operand := types[input.name]?
+          | throwError "checkedConvert operand/result type mismatch"
+        validateConversion sourceExpr targetExpr operand decl.type
+        modify fun consumed => (consumed.insert source.name).insert target.name
+        value := .const name levels #[.fvar input]
+    let resolved ← closedValue? values decl.value
+    let values := match resolved with
+      | some term => values.insert decl.fvarId.name term
+      | none => values
+    return .let { decl with value } (← normalizeCode values
+      (types.insert decl.fvarId.name decl.type) rest)
+  | .fun decl rest =>
+    let types := types.insert decl.fvarId.name decl.type
+    let body ← normalizeCode values (addParams types decl.params) decl.value
+    return .fun (.mk decl.fvarId decl.binderName decl.params decl.type body)
+      (← normalizeCode values types rest)
+  | .jp decl rest =>
+    let body ← normalizeCode values (addParams types decl.params) decl.value
+    return .jp (.mk decl.fvarId decl.binderName decl.params decl.type body)
+      (← normalizeCode values types rest)
+  | .cases cases =>
+    let alts ← cases.alts.mapM fun alt => do
+      match alt with
+      | .alt name params body =>
+        return .alt name params (← normalizeCode values (addParams types params) body)
+      | .default body => return .default (← normalizeCode values types body)
+    return .cases (cases.updateAlts alts)
+  | _ => return code
+
+/-- Backward liveness deletes only previously validated closed dictionary lets.
+    Any other use retains the graph, including unsupported generic residue. -/
+private partial def pruneConsumed (code : Code .pure) : StateM Consumed (Code .pure) := do
+  match code with
+  | .let decl rest =>
+    let rest ← pruneConsumed rest
+    if (← get).contains decl.fvarId.name && !(anyFVar (· == decl.fvarId) rest) then
+      TraverseFVar.forFVarM (fun id => modify (·.insert id.name)) decl.value
+      return rest
+    return .let decl rest
+  | .fun decl rest =>
+    let rest ← pruneConsumed rest
+    let body ← pruneConsumed decl.value
+    return .fun (.mk decl.fvarId decl.binderName decl.params decl.type body) rest
+  | .jp decl rest =>
+    let rest ← pruneConsumed rest
+    let body ← pruneConsumed decl.value
+    return .jp (.mk decl.fvarId decl.binderName decl.params decl.type body) rest
+  | .cases cases =>
+    let alts ← cases.alts.mapM fun alt => do
+      match alt with
+      | .alt name params body => return .alt name params (← pruneConsumed body)
+      | .default body => return .default (← pruneConsumed body)
+    return .cases (cases.updateAlts alts)
+  | _ => return code
+
+def normalizeConversions (decl : Decl .pure) : CoreM (Decl .pure) := do
+  let .code code := decl.value | return decl
+  let (code, consumed) ← (normalizeCode {} (addParams {} decl.params) code).run {}
+  let (code, _) := (pruneConsumed code).run consumed
+  return { decl with value := .code code }
+
+end Prod

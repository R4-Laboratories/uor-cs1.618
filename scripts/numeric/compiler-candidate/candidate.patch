@@ -0,0 +1,48 @@
+#!/usr/bin/env bash
+# Run inside the pinned SDK. No downloads, pin overrides, skip-to-success, or golden edits.
+set -uo pipefail
+export CARGO_NET_OFFLINE=true
+repo_root=$(cd "$(dirname "$0")/.." && pwd -P)
+logs=${1:-"$repo_root/output/numeric-source-stage"}
+mkdir -p "$logs"
+logs=$(cd "$logs" && pwd -P)
+cd "$repo_root"
+status=0
+: > "$logs/status.tsv"
+run_gate() {
+  local label=$1
+  shift
+  printf '%q ' "$@" > "$logs/$label.command"
+  printf '\n' >> "$logs/$label.command"
+  "$@" > "$logs/$label.log" 2>&1
+  local result=$?
+  printf '%s\t%s\n' "$label" "$result" | tee -a "$logs/status.tsv"
+  if [ "$result" -ne 0 ]; then status=1; fi
+}
+run_gate identity bash -c 'set -euo pipefail; git rev-parse HEAD; git diff --binary; lean --version; lake --version; rustc -vV; cargo -V; node --version'
+run_gate focused bash scripts/check-numeric-conversion.sh
+run_gate named-fixture-candidate bash scripts/regenerate-numeric-named-fixture.sh
+run_gate lean-fixtures bash -c 'cd lean && lake build ProofFixtures PrismPMGeneratedFixture'
+run_gate default-export bash -c 'cd lean && lake exe prod-export'
+run_gate default-golden git diff --exit-code -- lean/Conformance/golden.ir
+run_gate subset bash -c 'cd rust && cargo run --locked --offline -p prod-cli -- subset ../subset.json --output ../specs/lean-for-production.md'
+run_gate subset-golden git diff --exit-code -- specs/lean-for-production.md
+run_gate roots bash -c 'cd rust && cargo run --locked --offline -p prod-cli -- roots check ../roots.json'
+for gate in generated-fixtures named-export portable-package specialized-index scalar-length typed-decimal shared-decidable owned-accumulator; do
+  run_gate "$gate" bash "scripts/check-$gate.sh"
+done
+run_gate accumulator-provenance node scripts/check-owned-accumulator-provenance.mjs
+run_gate workspace bash -c 'cd rust && cargo test --locked --offline --workspace --no-fail-fast'
+run_gate assertions bash -c 'cd rust && cargo test --locked --offline --workspace --profile release-assertions --no-fail-fast'
+run_gate no-alloc bash -c 'cd rust && cargo test --locked --offline -p prod-core --test no_alloc -- --test-threads=1'
+run_gate fmt bash -c 'cd rust && cargo fmt --all -- --check'
+run_gate clippy bash -c 'cd rust && cargo clippy --locked --offline --all-targets -- -D warnings'
+run_gate wasm bash -c 'cd rust && cargo build --locked --offline -p prod-ir -p prod-codegen -p prod-wasm --target wasm32-unknown-unknown'
+for gate in core-wasm view text-view workspace-view; do
+  run_gate "$gate" bash "scripts/check-$gate.sh"
+done
+# Exact existing integration recipes; failure stays a failure if SDK tools are absent.
+run_gate wasm-sdk-fixture just wasm-sdk-fixture
+run_gate uor-fixture just uor-fixture
+run_gate whitespace git diff --check
+exit "$status"

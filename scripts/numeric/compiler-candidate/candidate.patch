@@ -0,0 +1,38 @@
+#!/usr/bin/env bash
+set -euo pipefail
+repo_root=$(cd "$(dirname "$0")/.." && pwd -P)
+# Keep generated IR/source/executables so CI can retain real evidence on failure.
+output="$repo_root/output/numeric"
+mkdir -p "$output"
+cd "$repo_root/lean"
+lake build Conformance.NumericClosureFixture ProdLib
+lake env lean Conformance/NumericClosure.lean
+lake env lean Conformance/NumericConversion.lean
+cd "$repo_root/rust"
+RUSTC_WRAPPER= cargo run --locked --offline -p prod-cli -- gen \
+  "$output/kernel.ir" --output "$output/numeric-generated.rs"
+RUSTC_WRAPPER= cargo run --locked --offline -p prod-cli -- gen \
+  "$output/unused-failure.ir" --output "$output/failure-generated.rs"
+if RUSTC_WRAPPER= cargo run --locked --offline -p prod-cli -- gen \
+    "$output/live-dictionary.ir" --output "$output/forbidden.rs" >"$output/live-dictionary-rejection.log" 2>&1; then
+  echo 'live generic dictionary unexpectedly admitted by codegen' >&2
+  exit 1
+fi
+grep -E 'PolymorphicType|polymorphic|unsupported' "$output/live-dictionary-rejection.log"
+cp "$repo_root/rust/prod-core/src/error.rs" "$output/compute-error.rs"
+cp "$repo_root/rust/prod-codegen/tests/fixtures/numeric_generated_test.rs" "$output/replay.rs"
+for optimization in 0 2; do
+  rustc --edition=2024 -C "opt-level=$optimization" "$output/replay.rs" -o "$output/replay-$optimization"
+  "$output/replay-$optimization"
+  rustc --edition=2024 -C "opt-level=$optimization" --target wasm32-unknown-unknown \
+    --crate-type cdylib "$output/replay.rs" -o "$output/replay-$optimization.wasm"
+  node --input-type=module - "$output/replay-$optimization.wasm" <<'JS'
+import fs from 'node:fs';
+import assert from 'node:assert/strict';
+const module = await WebAssembly.compile(fs.readFileSync(process.argv[2]));
+assert.deepEqual(WebAssembly.Module.imports(module), []);
+const instance = await WebAssembly.instantiate(module, {});
+assert.equal(instance.exports.numeric_check(), 0);
+JS
+done
+echo 'numeric helper/conversion refusals and generated native/import-free Wasm replay passed'

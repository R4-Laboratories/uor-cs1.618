+fn backport_acquisition(project: &Path) -> Result<serde_json::Value, PrismError> {
+    let inventory = crate::sdk::exporter_seed_inventory(project)?.ok_or_else(|| {
+        PrismError::new(
+            "PP5008",
+            "source backport requires the current native SDK lock and installed inventory",
+        )
+    })?;
+    let lock = crate::sdk::execution_lock(project)?;
+    let architecture = match std::env::consts::ARCH {
+        "x86_64" => "amd64",
+        "aarch64" => "arm64",
+        _ => {
+            return Err(PrismError::new(
+                "PP5008",
+                "source backport requires a supported native platform",
+            ))
+        }
+    };
+    let source = Source::NumericTask2c;
+    let receipt = serde_json::json!({
+        "schema": "prismpm/exporter-acquisition/2", "mode": "source-backport",
+        "source_id": source.id(), "descriptor_sha256": source.descriptor_sha256(),
+        "archive_sha256": source.archive_sha256(), "compiler_revision": source.revision(),
+        "toolchain": "leanprover/lean4:v4.32.1", "platform": format!("{}/{architecture}", std::env::consts::OS),
+        "inventory_sha256": inventory, "sdk_lock_digest": lock.digest()
+    });
+    validate_acquisition_authority(&receipt, "", lock.value())?;
+    Ok(receipt)
+}

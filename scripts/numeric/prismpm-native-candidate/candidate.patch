+fn validate_backport_receipt(value: &serde_json::Value) -> Result<(), PrismError> {
+    let source = Source::from_receipt(value)?;
+    let fail = || PrismError::new("PP5008", "source-backport acquisition evidence differs");
+    let fields = [
+        "archive_sha256",
+        "compiler_revision",
+        "descriptor_sha256",
+        "inventory_sha256",
+        "mode",
+        "platform",
+        "schema",
+        "sdk_lock_digest",
+        "source_id",
+        "toolchain",
+    ];
+    if value
+        .as_object()
+        .is_none_or(|object| object.keys().map(String::as_str).ne(fields))
+        || source != Source::NumericTask2c
+        || value["schema"] != "prismpm/exporter-acquisition/2"
+        || value["archive_sha256"] != source.archive_sha256()
+        || value["compiler_revision"] != source.revision()
+        || value["toolchain"] != "leanprover/lean4:v4.32.1"
+        || !matches!(
+            value["platform"].as_str(),
+            Some("linux/amd64" | "linux/arm64")
+        )
+    {
+        return Err(fail());
+    }
+    for (field, prefix) in [("inventory_sha256", ""), ("sdk_lock_digest", "sha256:")] {
+        let digest = value[field]
+            .as_str()
+            .and_then(|s| s.strip_prefix(prefix))
+            .ok_or_else(fail)?;
+        if digest.len() != 64
+            || !digest
+                .bytes()
+                .all(|b| b.is_ascii_digit() || (b'a'..=b'f').contains(&b))
+        {
+            return Err(fail());
+        }
+    }
+    Ok(())
+}

+    def test_deadline_guard_restores_nested_timers_and_refuses_foreign_state(self):
+        original_handler = signal.getsignal(signal.SIGALRM)
+        original_timer = signal.getitimer(signal.ITIMER_REAL)
+        self.assertEqual(original_timer, (0.0, 0.0))
+        self.assertEqual(original_handler, signal.SIG_DFL)
+        try:
+            foreign = lambda _signum, _frame: None
+            signal.signal(signal.SIGALRM, foreign)
+            with self.assertRaisesRegex(RuntimeError, "foreign alarm"):
+                with candidate.deadline_scope(time.monotonic() + 1):
+                    self.fail("foreign handler was admitted")
+            self.assertIs(signal.getsignal(signal.SIGALRM), foreign)
+            signal.signal(signal.SIGALRM, original_handler)
+            signal.setitimer(signal.ITIMER_REAL, 5, 7)
+            with self.assertRaisesRegex(RuntimeError, "foreign alarm"):
+                with candidate.deadline_scope(time.monotonic() + 1):
+                    self.fail("foreign timer was admitted")
+            remaining, interval = signal.getitimer(signal.ITIMER_REAL)
+            self.assertGreater(remaining, 4)
+            self.assertEqual(interval, 7)
+            signal.setitimer(signal.ITIMER_REAL, 0)
+            previous_mask = signal.pthread_sigmask(signal.SIG_BLOCK, {signal.SIGALRM})
+            try:
+                with self.assertRaisesRegex(RuntimeError, "blocked candidate deadline signal"):
+                    with candidate.deadline_scope(time.monotonic() + 1):
+                        self.fail("blocked deadline signal was admitted")
+            finally:
+                signal.pthread_sigmask(signal.SIG_SETMASK, previous_mask)
+            with self.assertRaisesRegex(RuntimeError, "deadline"):
+                with candidate.deadline_scope(time.monotonic() + 0.15):
+                    with self.assertRaisesRegex(RuntimeError, "deadline"):
+                        with candidate.deadline_scope(time.monotonic() + 0.02):
+                            time.sleep(2)
+                    self.assertIs(signal.getsignal(signal.SIGALRM), candidate._deadline_expired)
+                    self.assertGreater(signal.getitimer(signal.ITIMER_REAL)[0], 0)
+                    time.sleep(2)  # The earlier outer deadline remains active.
+            self.assertEqual(signal.getsignal(signal.SIGALRM), original_handler)
+            self.assertEqual(signal.getitimer(signal.ITIMER_REAL), original_timer)
+            with self.assertRaisesRegex(ValueError, "ordinary failure"):
+                with candidate.deadline_scope(time.monotonic() + 1):
+                    raise ValueError("ordinary failure")
+            with candidate.deadline_scope(time.monotonic() + 1):
+                pass
+            self.assertEqual(signal.getsignal(signal.SIGALRM), original_handler)
+            self.assertEqual(signal.getitimer(signal.ITIMER_REAL), original_timer)
+            errors = []
+            def worker():
+                try:
+                    with candidate.deadline_scope(time.monotonic() + 1):
+                        pass
+                except RuntimeError as error:
+                    errors.append(str(error))
+            thread = threading.Thread(target=worker)
+            thread.start()
+            thread.join(timeout=2)
+            self.assertEqual(errors, ["candidate deadline requires main thread"])
+        finally:
+            signal.setitimer(signal.ITIMER_REAL, 0)
+            signal.signal(signal.SIGALRM, original_handler)
+        self.assertIsNone(candidate._ACTIVE_DEADLINE)

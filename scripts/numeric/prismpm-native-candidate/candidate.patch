index 0000000000000000000000000000000000000000..cb6dcee63d2f599880225f4f8c5d6b1d95878da1
--- /dev/null
+++ b/scripts/conditional-capture-candidate-command.test.mjs
@@ -0,0 +1,87 @@
+// Local launcher logic/process controls; not actual SDK supervisor qualification.
+import assert from 'node:assert/strict';
+import {readFileSync} from 'node:fs';
+import {spawnSync} from 'node:child_process';
+import {fileURLToPath} from 'node:url';
+import test from 'node:test';
+
+const path = fileURLToPath(new URL('./conditional-capture-candidate-command.mjs', import.meta.url));
+const source = readFileSync(path, 'utf8');
+const exactTest = 'oci::publication_context::capture_tests::actual_source_free_capture_constructs_complete_conditional_context';
+const result = {status: 0, signal: null, timedOut: false, overflow: false, aborted: false,
+  orphaned: false, close_observed: true, retirement: {unitFixture: true},
+  stdout: Buffer.from('original stdout'), stderr: Buffer.from('original stderr')};
+let sequence = 0;
+async function unitLauncher({argv = ['/candidate-input/current-test-elf', '/workspace/conditional-capture', '12'],
+  original = result, throwResult = false, directory = true, realpath = '/workspace/conditional-capture'} = {}) {
+  const saved = process.argv;
+  const calls = [], writes = [];
+  const key = `candidateLauncherUnit${++sequence}`;
+  globalThis[key] = {writeFileSync: (...args) => writes.push(args),
+    lstatSync: () => ({isDirectory: () => directory}), realpathSync: () => realpath,
+    executeOwnedSdkCommand: async (...args) => {
+      calls.push(args);
+      if (throwResult) throw Object.assign(Error('fixture failure'), {result: original});
+      return original;
+    }};
+  // Only the test's in-memory copy substitutes dependencies. The on-disk
+  // launcher and both supervisor authority files remain unchanged.
+  const fsImport = "import {writeFileSync, lstatSync, realpathSync} from 'node:fs';";
+  const ownerImport = "import {executeOwnedSdkCommand} from './sdk-command-owner.mjs';";
+  assert(source.includes(fsImport) && source.includes(ownerImport));
+  const unit = source.replace(fsImport, `const {writeFileSync,lstatSync,realpathSync} = globalThis.${key};`)
+    .replace(ownerImport, `const {executeOwnedSdkCommand} = globalThis.${key};`);
+  process.argv = ['node', path, ...argv];
+  try {
+    await import(`data:text/javascript;base64,${Buffer.from(unit).toString('base64')}#${sequence}`);
+    return {calls, writes};
+  } finally {
+    process.argv = saved;
+    delete globalThis[key];
+  }
+}
+
+test('fixed candidate ELF, original exact case and entire original supervisor profile', async () => {
+  const {calls, writes} = await unitLauncher();
+  assert.equal(calls.length, 1);
+  assert.equal(calls[0][0], '/candidate-input/current-test-elf');
+  assert.deepEqual(calls[0][1], ['--exact', exactTest, '--nocapture']);
+  assert.deepEqual(calls[0][2], {profile: 'qualification', environment: process.env,
+    timeout: 12000, limit: 32 * 1024 * 1024, aggregate: true, interruptions: true});
+  assert.deepEqual(writes.map(w => w[0]), ['/workspace/conditional-capture/stdout',
+    '/workspace/conditional-capture/stderr', '/workspace/conditional-capture/command-result.json']);
+  assert(writes.every(w => w[2].flag === 'wx' && w[2].mode === 0o600));
+  assert.equal(writes[0][1], result.stdout);
+  assert.equal(writes[1][1], result.stderr);
+  assert.deepEqual(JSON.parse(writes[2][1]), {status: 0, signal: null, timedOut: false,
+    overflow: false, aborted: false, orphaned: false, close_observed: true, retirement: {unitFixture: true}});
+});
+
+test('failed supervisor result retains exact stdout, stderr and failure fields', async () => {
+  const failed = {...result, status: null, timedOut: true, overflow: true, aborted: true,
+    orphaned: true, close_observed: false, retirement: {unitFixture: 'unqualified'}};
+  const {writes} = await unitLauncher({original: failed, throwResult: true});
+  assert.equal(writes[0][1], result.stdout);
+  assert.equal(writes[1][1], result.stderr);
+  assert.equal(JSON.parse(writes[2][1]).retirement.unitFixture, 'unqualified');
+  assert.equal(JSON.parse(writes[2][1]).timedOut, true);
+});
+
+test('refuses alternative ELF/work/timeout/arity and aliased or missing directory', async () => {
+  for (const argv of [[], ['/workspace/conditional-capture/current-test-elf', '/workspace/conditional-capture', '1'],
+    ['/candidate-input/current-test-elf', '/other', '1'],
+    ...['0', '-1', '1.5', '2401', 'Infinity'].map(seconds =>
+      ['/candidate-input/current-test-elf', '/workspace/conditional-capture', seconds])]) {
+    await assert.rejects(unitLauncher({argv}));
+  }
+  await assert.rejects(unitLauncher({directory: false}));
+  await assert.rejects(unitLauncher({realpath: '/aliased'}));
+});
+
+test('actual Node process refuses wrong ELF before starting supervisor', () => {
+  const child = spawnSync(process.execPath, [path, '/wrong-elf', '/workspace/conditional-capture', '1'],
+    {timeout: 5000, maxBuffer: 1024 * 1024});
+  assert.equal(child.status, 1);
+  assert.match(child.stderr.toString(), /AssertionError/);
+  assert.equal(child.stdout.length, 0);
+});
diff --git a/scripts/conditional-capture-candidate.py b/scripts/conditional-capture-candidate.py
new file mode 100644
index 0000000000000000000000000000000000000000..b2b1eaee8058888a8882f9f468de6df8b039a0ca
--- /dev/null
+++ b/scripts/conditional-capture-candidate.py
@@ -0,0 +1,1696 @@
+"""Closed candidate-source-v1 transport components; never SDK acceptance.
+
+The source parent owns inspected actors and read-only candidate views. Stage
+admission describes complete measured bytes and EOF, never SDK or production
+acceptance. Actual Docker enforcement requires separate platform qualification.
+"""
+import hashlib
+from contextlib import contextmanager
+import importlib.util
+import os
+from pathlib import Path, PurePosixPath
+import re
+import signal
+import stat
+import sys
+import time
+import threading
+
+UTILITY_NAME = "conditional-capture-sdk.py"
+UTILITY_SHA256 = "ca09b9de3bf57c3e2dc16e11d4d1a527b9b2f1f271566bb7a87846d0a24f8e9a"
+ENTRY_NAME = "conditional-capture-candidate.py"
+BOOTSTRAP_NAME = "conditional-capture-bootstrap.py"
+MAX_MODULE = 1024 * 1024
+MAX_BOOTSTRAP = 32 * 1024
+
+
+def _identity(info):
+    return (info.st_dev, info.st_ino, info.st_mode, info.st_nlink, info.st_size, info.st_mtime_ns, info.st_ctime_ns)
+
+
+def _utility():
+    # No ambient source search, pyc execution or unauthenticated loader reread.
+    path = Path(__file__).absolute().with_name(UTILITY_NAME)
+    if path.resolve() != path:
+        raise RuntimeError("utility path must be exact and unaliased")
+    before = os.lstat(path)
+    if not stat.S_ISREG(before.st_mode) or before.st_nlink != 1 or before.st_size > MAX_MODULE:
+        raise RuntimeError("bounded singly linked utility required")
+    fd = os.open(path, os.O_RDONLY | os.O_NOFOLLOW | os.O_CLOEXEC)
+    with os.fdopen(fd, "rb") as stream:
+        if _identity(os.fstat(stream.fileno())) != _identity(before):
+            raise RuntimeError("utility changed before admission")
+        body = stream.read(MAX_MODULE + 1)
+        if _identity(os.fstat(stream.fileno())) != _identity(before) or _identity(os.lstat(path)) != _identity(before):
+            raise RuntimeError("utility changed during admission")
+    if hashlib.sha256(body).hexdigest() != UTILITY_SHA256:
+        raise RuntimeError("utility digest mismatch")
+    spec = importlib.util.spec_from_file_location("candidate_capture_utility", path)
+    module = importlib.util.module_from_spec(spec)
+    exec(compile(body, str(path), "exec"), module.__dict__)
+    return module
+
+
+legacy = _utility()
+require, encoded, sha, Reader = legacy.require, legacy.encoded, legacy.sha, legacy.Reader
+SOURCE_PLAN_SCHEMA = "prismpm/conditional-candidate-source-plan/1"
+INPUT_SCHEMA = "prismpm/conditional-candidate-capture-input/1"
+RESPONSE_SCHEMA = "prismpm/conditional-candidate-capture-response/1"
+STAGE_SCHEMA = "prismpm/conditional-candidate-stage-admission/1"
+ROUTE = "candidate-source-v1"
+SDK_IMAGE = "ghcr.io/uor-foundation/prismpm-sdk@sha256:d6c263a733a6bc36e0458c3f5b9a1f5ea9c14dfbe8c257d3f650a960b5fe633c"
+AUTHORITY = tuple("scripts/" + name for name in (
+    BOOTSTRAP_NAME, "conditional-capture-candidate-command.mjs", ENTRY_NAME,
+    UTILITY_NAME, "sdk-command-owner.mjs", "sdk-command-owner.py"))
+FIXTURES = ("examples/Calculator/src", "stdlib/src/Foundation", "stdlib/src/Production")
+DESCRIPTOR_NAME = "candidate-input.json"
+MANIFEST_NAME = "candidate-transfer-manifest.json"
+
+
+def tick(deadline):
+    require(time.monotonic() < deadline, "candidate input deadline")
+
+
+_ACTIVE_DEADLINE = None
+LISTING_REAP_SECONDS = 1
+
+
+def _deadline_expired(_signum, _frame):
+    raise RuntimeError("candidate input deadline")
+
+
+@contextmanager
+def deadline_scope(deadline):
+    """Main-thread POSIX wall-clock guard for synchronous unchanged primitives.
+
+    Only same-owner nesting is admitted. A timed-out legacy Git scan may spend
+    its existing bounded five seconds reaping; listing cleanup is capped below.
+    These are failure cleanup allowances, never additional successful work.
+    """
+    global _ACTIVE_DEADLINE
+    require(threading.current_thread() is threading.main_thread(), "candidate deadline requires main thread")
+    require(signal.SIGALRM not in signal.pthread_sigmask(signal.SIG_BLOCK, set()),
+            "blocked candidate deadline signal")
+    previous = _ACTIVE_DEADLINE
+    handler = signal.getsignal(signal.SIGALRM)
+    timer = signal.getitimer(signal.ITIMER_REAL)
+    if previous is None:
+        require(handler == signal.SIG_DFL and timer == (0.0, 0.0), "foreign alarm handler or timer")
+    else:
+        require(handler is _deadline_expired and timer[1] == 0, "foreign nested alarm handler or timer")
+        deadline = min(deadline, previous)
+    tick(deadline)
+    try:
+        _ACTIVE_DEADLINE = deadline
+        signal.signal(signal.SIGALRM, _deadline_expired)
+        signal.setitimer(signal.ITIMER_REAL, max(0.000001, deadline - time.monotonic()))
+        yield
+        tick(deadline)
+    finally:
+        signal.setitimer(signal.ITIMER_REAL, 0)
+        _ACTIVE_DEADLINE = previous
+        signal.signal(signal.SIGALRM, handler)
+        if previous is not None and previous > time.monotonic():
+            signal.setitimer(signal.ITIMER_REAL, max(0.000001, previous - time.monotonic()))
+
+
+def measured_listing(executable, deadline):
+    """One actual listing, bounded output, retained diagnostics on every failure."""
+    with deadline_scope(deadline):
+        return _measured_listing(executable, deadline)
+
+
+def _measured_listing(executable, deadline):
+    tick(deadline)
+    # Keep a pending work alarm from interrupting Popen after the OS child
+    # exists but before its handle is under our finally/retirement custody.
+    previous_mask = signal.pthread_sigmask(signal.SIG_BLOCK, {signal.SIGALRM})
+    child = None
+    channels = {}
+    failure, result = None, None
+    try:
+        child = legacy.subprocess.Popen([str(executable), "--list", "--format=terse"],
+                                        stdout=legacy.subprocess.PIPE, stderr=legacy.subprocess.PIPE,
+                                        start_new_session=True)
+        channels = {child.stdout.fileno(): bytearray(), child.stderr.fileno(): bytearray()}
+        active = set(channels)
+        signal.pthread_sigmask(signal.SIG_SETMASK, previous_mask)
+        while active:
+            tick(deadline)
+            ready = legacy.select.select(list(active), [], [], max(0, deadline - time.monotonic()))[0]
+            require(ready, "candidate listing deadline")
+            for fd in ready:
+                part = os.read(fd, 65536)
+                if not part:
+                    active.remove(fd)
+                else:
+                    available = legacy.MIB - sum(map(len, channels.values()))
+                    channels[fd].extend(part[:available])
+                    require(len(part) <= available, "bounded actual listing output")
+        tick(deadline)
+        status = child.wait(timeout=max(0, deadline - time.monotonic()))
+        require(status == 0, "actual test listing failed")
+        body = bytes(channels[child.stdout.fileno()])
+        legacy.checked_listing(body)
+        lines = body.decode().splitlines()
+        require(len(lines) == len(set(lines)) and all(line.endswith(": test") for line in lines),
+                "closed distinct library test inventory required")
+        result = (sha(body), len(lines))
+    except BaseException as error:
+        failure = error
+    finally:
+        # A work deadline must not interrupt bounded child retirement. Do not
+        # restart the work budget after cleanup or launch a second listing.
+        signal.pthread_sigmask(signal.SIG_BLOCK, {signal.SIGALRM})
+        signal.setitimer(signal.ITIMER_REAL, 0)
+        try:
+            if child is not None and child.poll() is None:
+                try:
+                    os.killpg(child.pid, signal.SIGKILL)
+                except ProcessLookupError:
+                    pass
+                child.wait(timeout=LISTING_REAP_SECONDS)
+        except BaseException as error:
+            failure = RuntimeError("listing child retirement unqualified: " + str(error)
+                                   + ("; original failure: " + str(failure) if failure else ""))
+        finally:
+            stdout, stderr = b"", b""
+            if child is not None:
+                stdout, stderr = (bytes(channels.get(channel.fileno(), b""))
+                                  for channel in (child.stdout, child.stderr))
+                child.stdout.close()
+                child.stderr.close()
+            if signal.SIGALRM in signal.sigpending():
+                signal.sigwait({signal.SIGALRM})
+            signal.pthread_sigmask(signal.SIG_SETMASK, previous_mask)
+    if failure is None:
+        try:
+            tick(deadline)
+        except BaseException as error:
+            failure = error
+    if failure is not None:
+        failure.stdout, failure.stderr = stdout, stderr
+        failure.listing_pid = child.pid if child is not None else None
+        raise failure
+    return result
+
+
+def scalar(value):
+    require(isinstance(value, str) and not any(0xD800 <= ord(c) <= 0xDFFF for c in value),
+            "Unicode scalar path required")
+    return value
+
+
+def ordered(rows):
+    return sorted(rows, key=lambda record: scalar(record["path"]).encode("utf-8"))
+
+
+def validate_rows(rows, *, ancestors=True):
+    legacy.validate_rows(rows)
+    for record in rows:
+        scalar(record["path"])
+        if record["kind"] == "link":
+            scalar(record["target"])
+    require(rows == ordered(rows), "UTF-8 ordered inventory required")
+    kinds = {record["path"]: record["kind"] for record in rows}
+    for record in rows:
+        paths = [record["path"]]
+        if record["kind"] == "link":
+            target = os.path.normpath(str(PurePosixPath(record["path"]).parent / record["target"]))
+            paths.append(target)
+        for path in paths:
+            for parent in PurePosixPath(path).parents:
+                if str(parent) != ".":
+                    require(kinds.get(str(parent)) == "directory" or
+                            (not ancestors and str(parent) not in kinds),
+                            "undeclared or alias inventory parent")
+    return rows
+
+
+def union_rows(source, fixtures):
+    validate_rows(source)
+    validate_rows(fixtures, ancestors=False)
+    merged = {record["path"]: record for record in source}
+    for record in fixtures:
+        require(record["path"] not in merged or merged[record["path"]] == record,
+                "source/fixture conflict")
+        merged[record["path"]] = record
+    union = validate_rows(ordered(list(merged.values())))
+    selected = [record for record in union if any(record["path"] == root or
+                record["path"].startswith(root + "/") for root in FIXTURES)]
+    require(selected == fixtures and all(any(record == {"path": root, "kind": "directory"}
+                for record in fixtures) for root in FIXTURES), "complete fixture closure required")
+    require(all(record["kind"] != "link" for record in fixtures), "fixture aliases forbidden")
+    return union
+
+
+def digest(value):
+    return sha(encoded(value))
+
+
+def valid_digest(value):
+    return isinstance(value, str) and re.fullmatch(r"[0-9a-f]{64}", value) is not None
+
+
+def validate_source_plan(value):
+    keys = {"schema", "route", "source_root", "source_selection", "source", "fixture_inputs",
+            "source_sha256", "fixture_inputs_sha256", "union", "union_sha256", "authority",
+            "executable_bytes", "executable_sha256", "listing_sha256", "test_count",
+            "remaining_seconds", "sdk_image"}
+    require(type(value) is dict and set(value) == keys, "closed candidate input descriptor")
+    require(value["schema"] == SOURCE_PLAN_SCHEMA and value["route"] == ROUTE, "candidate input version")
+    require(value["source_selection"] in ("tracked", "private"), "closed source selection")
+    scalar(value["source_root"])
+    legacy.alias_root(value["source_root"])
+    if value["source_selection"] == "private":
+        require(re.fullmatch(r"/tmp/prismpm-publication-capture-[A-Za-z0-9_-]{6,64}/source",
+                             value["source_root"]), "closed private source owner")
+    require(value["source_root"] != "/workspace/conditional-capture", "compiled root overlaps work")
+    union = union_rows(value["source"], value["fixture_inputs"])
+    validate_rows(value["union"])
+    require(encoded(value["union"]) == encoded(union) and value["source_sha256"] == digest(value["source"])
+            and value["fixture_inputs_sha256"] == digest(value["fixture_inputs"])
+            and value["union_sha256"] == digest(value["union"]), "candidate inventory digest/union mismatch")
+    source = {r["path"]: r for r in value["source"]}
+    require(all(name in source and source[name]["kind"] == "file" for name in AUTHORITY),
+            "complete source authority required")
+    require(type(value["authority"]) is list
+            and encoded(value["authority"]) == encoded([source[name] for name in AUTHORITY]),
+            "closed source authority")
+    require(source["scripts/" + UTILITY_NAME]["sha256"] == UTILITY_SHA256,
+            "original utility digest required")
+    for name, maximum in ((BOOTSTRAP_NAME, MAX_BOOTSTRAP), (ENTRY_NAME, MAX_MODULE),
+                          (UTILITY_NAME, MAX_MODULE)):
+        require(0 < source["scripts/" + name]["bytes"] <= maximum, "bootstrap capsule byte bound")
+    require(type(value["executable_bytes"]) is int and 4 <= value["executable_bytes"] <= legacy.MAX_ELF
+            and valid_digest(value["executable_sha256"]) and valid_digest(value["listing_sha256"]),
+            "closed exact ELF measurement")
+    require(type(value["test_count"]) is int and 1 <= value["test_count"] <= 100000,
+            "closed actual test count")
+    require(type(value["remaining_seconds"]) is int and 0 < value["remaining_seconds"] <=
+            legacy.DEADLINE_SECONDS - legacy.RETIREMENT_RESERVE_SECONDS, "bounded remaining seconds")
+    require(value["sdk_image"] == SDK_IMAGE, "unchanged SDK distribution required")
+    require(len(encoded(value)) <= legacy.MAX_JSON, "candidate descriptor byte bound")
+    return value
+
+
+def measure_inputs(source: Path, executable: Path, remaining_seconds: int) -> dict:
+    require(type(remaining_seconds) is int and 0 < remaining_seconds <= 1980, "bounded measurement seconds")
+    deadline = time.monotonic() + remaining_seconds
+    with deadline_scope(deadline):
+        return _measure_inputs(source, executable, remaining_seconds, deadline)
+
+
+def _measure_inputs(source, executable, remaining_seconds, deadline):
+    executable_before = legacy.identity(os.lstat(executable))
+    source = Path(source)
+    require(source.is_absolute() and source.resolve(strict=True) == source, "unaliased source root required")
+    legacy.alias_root(str(source))
+    rows = validate_rows(ordered(legacy.source_rows(source)))
+    fixtures = validate_rows(ordered(legacy.fixture_rows(source)), ancestors=False)
+    union = union_rows(rows, fixtures)
+    tick(deadline)
+    body = measure_regular(executable, legacy.MAX_ELF, deadline, elf=True)
+    authority = {r["path"]: r for r in rows}
+    require(all(name in authority for name in AUTHORITY), "complete source authority required")
+    for name in (ENTRY_NAME, BOOTSTRAP_NAME):
+        actual = legacy.read_regular(Path(__file__).with_name(name), MAX_MODULE)
+        require(authority["scripts/" + name]["sha256"] == sha(actual), "current source authority mismatch")
+    listing_sha256, test_count = measured_listing(executable, deadline)
+    value = {"schema": SOURCE_PLAN_SCHEMA, "route": ROUTE, "source_root": str(source),
+             "source_selection": "tracked" if os.path.lexists(source / ".git") else "private",
+             "source": rows, "fixture_inputs": fixtures, "source_sha256": digest(rows),
+             "fixture_inputs_sha256": digest(fixtures), "union": union, "union_sha256": digest(union),
+             "authority": [authority[name] for name in AUTHORITY],
+             "executable_bytes": body["bytes"], "executable_sha256": body["sha256"],
+             "listing_sha256": listing_sha256, "test_count": test_count,
+             "remaining_seconds": remaining_seconds, "sdk_image": SDK_IMAGE}
+    require(legacy.identity(os.lstat(executable)) == executable_before, "ELF changed during measurement")
+    tick(deadline)
+    return validate_source_plan(value)
+
+
+def validate_runtime(value):
+    require(type(value) is dict and set(value) == {"sdk_image", "config_digest", "os", "architecture",
+            "inventory_sha256", "image_authority"}, "closed observed SDK runtime")
+    require(value["sdk_image"] == SDK_IMAGE and value["os"] == "linux"
+            and value["architecture"] in ("amd64", "arm64")
+            and isinstance(value["config_digest"], str)
+            and re.fullmatch(r"sha256:[0-9a-f]{64}", value["config_digest"])
+            and valid_digest(value["inventory_sha256"]), "actual SDK identity shape")
+    records = value["image_authority"]
+    require(type(records) is list and len(records) == 2, "closed image authority")
+    for record, name in zip(records, (UTILITY_NAME, "conditional-capture-command.mjs")):
+        require(type(record) is dict and set(record) == {"path", "bytes", "sha256"}
+                and record["path"] == str(legacy.SDK_ROOT / "scripts" / name)
+                and type(record["bytes"]) is int and 0 < record["bytes"] <= legacy.MAX_FILE
+                and valid_digest(record["sha256"]), "measured image authority shape")
+    return value
+
+
+def bind_runtime(source_plan, runtime_observation):
+    validate_source_plan(source_plan)
+    validate_runtime(runtime_observation)
+    # Canonical roundtrip takes an independent immutable-by-custody snapshot.
+    value = legacy.json.loads(encoded(source_plan))
+    value["schema"] = INPUT_SCHEMA
+    value["runtime"] = legacy.json.loads(encoded(runtime_observation))
+    return validate_descriptor(value)
+
+
+def validate_descriptor(value):
+    require(type(value) is dict and value.get("schema") == INPUT_SCHEMA and "runtime" in value,
+            "runtime-bound candidate descriptor required")
+    plan = {key: item for key, item in value.items() if key != "runtime"}
+    plan["schema"] = SOURCE_PLAN_SCHEMA
+    validate_source_plan(plan)
+    validate_runtime(value["runtime"])
+    require(len(encoded(value)) <= legacy.MAX_JSON, "candidate descriptor byte bound")
+    return value
+
+
+def transfer_manifest(descriptor):
+    return [{"path": "candidate-source/" + r["path"], "bytes": r["bytes"], "sha256": r["sha256"]}
+            for r in descriptor["union"] if r["kind"] == "file"] + [
+            {"path": "current-test-elf", "bytes": descriptor["executable_bytes"],
+             "sha256": descriptor["executable_sha256"]}]
+
+
+def completion_marker(descriptor):
+    return {"kind": "inputs-complete", "descriptor_sha256": digest(descriptor),
+            "transfer_manifest_sha256": digest(transfer_manifest(descriptor))}
+
+
+def measure_regular(path, limit, deadline, *, elf=False):
+    """Streaming bounded readback; compare original no-follow metadata identity."""
+    tick(deadline)
+    before = os.lstat(path)
+    require(stat.S_ISREG(before.st_mode) and before.st_nlink == 1 and 0 <= before.st_size <= limit,
+            "bounded singly linked readback file")
+    fd = os.open(path, os.O_RDONLY | os.O_NOFOLLOW | os.O_NONBLOCK | os.O_CLOEXEC)
+    actual = hashlib.sha256()
+    with os.fdopen(fd, "rb") as stream:
+        require(legacy.identity(os.fstat(stream.fileno())) == legacy.identity(before), "readback file replaced")
+        remaining, first = before.st_size, True
+        while remaining:
+            tick(deadline)
+            part = stream.read(min(remaining, legacy.MIB))
+            require(part, "short readback file")
+            if first and elf:
+                require(part.startswith(b"\x7fELF"), "exact readback ELF required")
+            first = False
+            actual.update(part)
+            remaining -= len(part)
+        require(not elf or not first, "nonempty readback ELF required")
+        require(stream.read(1) == b"" and legacy.identity(os.fstat(stream.fileno())) == legacy.identity(before)
+                and legacy.identity(os.lstat(path)) == legacy.identity(before), "readback file changed")
+    return {"bytes": before.st_size, "sha256": actual.hexdigest()}
+
+
+def complete_tree(root, deadline):
+    """Complete readback: no legacy source/cache exclusions, no symlink descent."""
+    rows, total = [], 0
+    def visit(name):
+        nonlocal total
+        tick(deadline)
+        require(len(rows) < 100000, "candidate readback count bound")
+        info = os.lstat(root / name)
+        if stat.S_ISREG(info.st_mode):
+            total += info.st_size
+            require(total <= legacy.MAX_TREE, "candidate readback byte bound")
+        record = ({"path": name, "kind": "file", "executable": bool(info.st_mode & 0o100),
+                   **measure_regular(root / name, legacy.MAX_FILE, deadline)}
+                  if stat.S_ISREG(info.st_mode) else legacy.row(root, name))
+        rows.append(record)
+        if record["kind"] == "directory":
+            for child in sorted(os.listdir(root / name), key=lambda text: scalar(text).encode("utf-8")):
+                visit(name + "/" + child)
+    for name in sorted(os.listdir(root), key=lambda text: scalar(text).encode("utf-8")):
+        visit(name)
+    return validate_rows(ordered(rows))
+
+
+def _exclusive(path, body, mode=0o400):
+    fd = os.open(path, os.O_WRONLY | os.O_CREAT | os.O_EXCL | os.O_NOFOLLOW | os.O_CLOEXEC, 0o600)
+    with os.fdopen(fd, "wb") as output:
+        output.write(body)
+        output.flush()
+        os.fchmod(output.fileno(), mode)
+
+
+def _receive(reader, path, length, expected, mode, deadline, *, elf=False):
+    fd = os.open(path, os.O_WRONLY | os.O_CREAT | os.O_EXCL | os.O_NOFOLLOW | os.O_CLOEXEC, 0o600)
+    actual = hashlib.sha256()
+    first = True
+    with os.fdopen(fd, "wb") as output:
+        remaining = length
+        while remaining:
+            tick(deadline)
+            part = reader.exact(min(legacy.MIB, remaining))
+            if first and elf:
+                require(part.startswith(b"\x7fELF"), "received exact ELF required")
+            first = False
+            output.write(part)
+            actual.update(part)
+            remaining -= len(part)
+        require(actual.hexdigest() == expected, "received body digest mismatch")
+        output.flush()
+        require(os.fstat(output.fileno()).st_nlink == 1, "received hardlink refused")
+        os.fchmod(output.fileno(), mode)
+
+
+def _capsules(destination, descriptor):
+    authority = {r["path"]: r for r in descriptor["authority"]}
+    root = destination / "authority"
+    require(root.resolve() == root and stat.S_ISDIR(os.lstat(root).st_mode), "exact authority directory")
+    require(set(os.listdir(root)) == {UTILITY_NAME, ENTRY_NAME}, "closed authority capsule files")
+    for name in (UTILITY_NAME, ENTRY_NAME):
+        body = legacy.read_regular(root / name, MAX_MODULE)
+        record = authority["scripts/" + name]
+        require(len(body) == record["bytes"] and sha(body) == record["sha256"], "authority capsule mismatch")
+
+
+def verify_materialized(destination, descriptor, deadline):
+    with deadline_scope(deadline):
+        return _verify_materialized(destination, descriptor, deadline)
+
+
+def _verify_materialized(destination, descriptor, deadline):
+    validate_descriptor(descriptor)
+    tick(deadline)
+    require(destination.resolve() == destination and stat.S_ISDIR(os.lstat(destination).st_mode),
+            "exact materialized root")
+    require(stat.S_IMODE(os.lstat(destination).st_mode) == 0o500, "normalized input directory")
+    require(set(os.listdir(destination)) == {"authority", "candidate-source", "current-test-elf",
+            DESCRIPTOR_NAME, MANIFEST_NAME}, "closed materialized root")
+    root = destination / "candidate-source"
+    require(stat.S_ISDIR(os.lstat(root).st_mode) and root.resolve() == root, "exact candidate source root")
+    require(complete_tree(root, deadline) == descriptor["union"], "complete source readback mismatch")
+    require(ordered(legacy.fixture_rows(root)) == descriptor["fixture_inputs"], "fixture readback mismatch")
+    for record in [{"path": "", "kind": "directory"}] + descriptor["union"]:
+        if record["kind"] != "link":
+            mode = 0o500 if record["kind"] == "directory" or record.get("executable") else 0o400
+            require(stat.S_IMODE(os.lstat(root / record["path"]).st_mode) == mode, "normalized source mode")
+    _capsules(destination, descriptor)
+    for name in (UTILITY_NAME, ENTRY_NAME):
+        require(stat.S_IMODE(os.lstat(destination / "authority" / name).st_mode) == 0o400,
+                "normalized authority mode")
+    require(stat.S_IMODE(os.lstat(destination / "authority").st_mode) == 0o500,
+            "normalized authority directory")
+    body = measure_regular(destination / "current-test-elf", legacy.MAX_ELF, deadline, elf=True)
+    require(body == {"bytes": descriptor["executable_bytes"], "sha256": descriptor["executable_sha256"]}
+            and stat.S_IMODE(os.lstat(destination / "current-test-elf").st_mode)
+            == 0o500, "exact ELF readback mismatch")
+    for name, value in ((DESCRIPTOR_NAME, descriptor), (MANIFEST_NAME, transfer_manifest(descriptor))):
+        require(legacy.read_regular(destination / name, legacy.MAX_JSON) == encoded(value)
+                and stat.S_IMODE(os.lstat(destination / name).st_mode) == 0o400, "canonical input metadata")
+    tick(deadline)
+    return {"schema": STAGE_SCHEMA, "route": ROUTE, "descriptor_sha256": digest(descriptor),
+            "source_sha256": descriptor["source_sha256"], "union_sha256": descriptor["union_sha256"],
+            "fixture_inputs_sha256": descriptor["fixture_inputs_sha256"],
+            "transfer_manifest_sha256": digest(transfer_manifest(descriptor)),
+            "authority": descriptor["authority"], "executable_sha256": descriptor["executable_sha256"]}
+
+
+def _materialize(reader, destination, descriptor, deadline, *, bootstrapped=False):
+    with deadline_scope(deadline):
+        return _materialize_body(reader, destination, descriptor, deadline, bootstrapped=bootstrapped)
+
+
+def _materialize_body(reader, destination, descriptor, deadline, *, bootstrapped=False):
+    validate_descriptor(descriptor)
+    tick(deadline)
+    reader.deadline = min(reader.deadline, deadline)
+    require(destination.is_absolute() and destination.parent.resolve() == destination.parent,
+            "unaliased destination parent required")
+    if bootstrapped:
+        require(destination == Path("/workspace") and set(os.listdir(destination)) == {"authority"},
+                "occupied stage destination")
+        _capsules(destination, descriptor)
+    else:
+        require(not os.path.lexists(destination), "occupied destination")
+        destination.mkdir(mode=0o700)
+    root = destination / "candidate-source"
+    root.mkdir(mode=0o700)
+    for record in descriptor["union"]:
+        tick(deadline)
+        path = root / record["path"]
+        if record["kind"] == "directory":
+            path.mkdir(mode=0o700)
+        elif record["kind"] == "file":
+            _receive(reader, path, record["bytes"], record["sha256"],
+                     0o400, deadline)
+    for record in descriptor["union"]:
+        if record["kind"] == "link":
+            os.symlink(record["target"], root / record["path"])
+    _receive(reader, destination / "current-test-elf", descriptor["executable_bytes"],
+             descriptor["executable_sha256"], 0o400, deadline, elf=True)
+    require(reader.line() == completion_marker(descriptor), "descriptor-bound completion marker required")
+    reader.exhausted()  # No admission until actual EOF; deadline still shared.
+    if not bootstrapped:
+        (destination / "authority").mkdir(mode=0o700)
+        for name in (UTILITY_NAME, ENTRY_NAME):
+            _exclusive(destination / "authority" / name, legacy.read_regular(root / "scripts" / name, MAX_MODULE))
+    for name, value in ((DESCRIPTOR_NAME, descriptor), (MANIFEST_NAME, transfer_manifest(descriptor))):
+        _exclusive(destination / name, encoded(value))
+    for record in reversed(descriptor["union"]):
+        if record["kind"] == "file":
+            (root / record["path"]).chmod(0o500 if record["executable"] else 0o400)
+        elif record["kind"] == "directory":
+            (root / record["path"]).chmod(0o500)
+    root.chmod(0o500)
+    (destination / "current-test-elf").chmod(0o500)
+    (destination / "authority").chmod(0o500)
+    destination.chmod(0o500)
+    result = verify_materialized(destination, descriptor, deadline)
+    result["input_eof_observed"] = True
+    return result
+
+
+def materialize_inputs(reader, destination: Path, descriptor: dict, deadline: float) -> dict:
+    """Receive bodies after the descriptor line into a new destination."""
+    return _materialize(reader, destination, descriptor, deadline)
+
+
+def input_identities(source, executable, descriptor, deadline):
+    """Outer owner holds this bounded snapshot across every subsequent send/recheck."""
+    with deadline_scope(deadline):
+        return _input_identities(source, executable, descriptor)
+
+
+def _input_identities(source, executable, descriptor):
+    return {"source_root": legacy.identity(os.lstat(source)),
+            "source": {r["path"]: legacy.identity(os.lstat(source / r["path"])) for r in descriptor["union"]},
+            "executable": legacy.identity(os.lstat(executable))}
+
+
+def write_inputs(stream, source, executable, descriptor, deadline, identities):
+    """Main-thread bounded sender; identity snapshot belongs to the outer owner."""
+    with deadline_scope(deadline):
+        return _write_inputs(stream, source, executable, descriptor, deadline, identities)
+
+
+def _write_inputs(stream, source, executable, descriptor, deadline, identities):
+    validate_descriptor(descriptor)
+    require(str(source) == descriptor["source_root"] and source.resolve() == source, "exact sender source root")
+    require(input_identities(source, executable, descriptor, deadline) == identities, "input metadata changed before transfer")
+    require(ordered(legacy.source_rows(source)) == descriptor["source"]
+            and ordered(legacy.fixture_rows(source)) == descriptor["fixture_inputs"], "source changed before transfer")
+    legacy.write_bounded(stream, encoded(descriptor), deadline)
+    for record in transfer_manifest(descriptor):
+        path = source / record["path"][len("candidate-source/"):] if record["path"].startswith("candidate-source/") else executable
+        before = os.lstat(path)
+        require(stat.S_ISREG(before.st_mode) and before.st_nlink == 1 and before.st_size == record["bytes"],
+                "bounded singly linked sender input")
+        fd = os.open(path, os.O_RDONLY | os.O_NOFOLLOW | os.O_CLOEXEC)
+        actual = hashlib.sha256()
+        with os.fdopen(fd, "rb") as body:
+            require(legacy.identity(os.fstat(body.fileno())) == legacy.identity(before), "sender input replaced")
+            remaining = record["bytes"]
+            while remaining:
+                tick(deadline)
+                part = body.read(min(legacy.MIB, remaining))
+                require(part, "sender input shortened")
+                actual.update(part)
+                legacy.write_bounded(stream, part, deadline)
+                remaining -= len(part)
+            require(body.read(1) == b"" and actual.hexdigest() == record["sha256"]
+                    and legacy.identity(os.fstat(body.fileno())) == legacy.identity(before)
+                    and legacy.identity(os.lstat(path)) == legacy.identity(before), "sender input changed")
+    require(input_identities(source, executable, descriptor, deadline) == identities
+            and ordered(legacy.source_rows(source)) == descriptor["source"]
+            and ordered(legacy.fixture_rows(source)) == descriptor["fixture_inputs"], "input changed during transfer")
+    legacy.write_bounded(stream, encoded(completion_marker(descriptor)), deadline)
+    # The caller closes the stream. It must not interpret a written marker as EOF.
+
+
+def stage(context):
+    with deadline_scope(context["deadline"]):
+        return _stage(context)
+
+
+def _stage(context):
+    require(set(context) == {"mode", "deadline", "descriptor_sha256", "bootstrap", "capsules"}
+            and context["mode"] == "stage-v1", "closed bootstrap stage entry")
+    reader = Reader(sys.stdin.buffer, context["deadline"])
+    descriptor = validate_descriptor(reader.line())
+    context["deadline"] = min(context["deadline"], time.monotonic() + descriptor["remaining_seconds"])
+    require(digest(descriptor) == context["descriptor_sha256"], "bootstrap descriptor mismatch")
+    authority = {r["path"]: r for r in descriptor["authority"]}
+    require(authority["scripts/" + BOOTSTRAP_NAME]["sha256"] == sha(context["bootstrap"])
+            and authority["scripts/" + BOOTSTRAP_NAME]["bytes"] == len(context["bootstrap"]),
+            "actual bootstrap bytes mismatch")
+    for record, name in zip(context["capsules"], (UTILITY_NAME, ENTRY_NAME)):
+        require(record == {key: authority["scripts/" + name][key] for key in ("bytes", "sha256")},
+                "bootstrap capsule descriptor mismatch")
+    result = _materialize(reader, Path("/workspace"), descriptor, context["deadline"], bootstrapped=True)
+    legacy.write_bounded(sys.stdout.buffer, encoded(result), context["deadline"])
+
+
+# The envelope is host evidence. A guest can never assert daemon retirement.
+ENVELOPE_NAME = "candidate-transport-evidence.json"
+ENVELOPE_SCHEMA = "prismpm/conditional-candidate-transport-evidence/1"
+ROLE_LABEL = "org.prismpm.conditional-capture-role"
+IMAGE_LAUNCHER_SHA256 = "ac11aadd31f0a3e40df7866cc7690be8e7c8c252120146d718471358840ed6dd"
+TMPFS = {"/tmp": "rw,exec,nosuid,nodev,size=8g,mode=1777",
+         "/workspaces": "rw,noexec,nosuid,nodev,size=16m,mode=1777"}
+
+
+def remaining_seconds(deadline, reserve=0):
+    seconds = int(deadline - time.monotonic() - reserve)
+    require(seconds > 0, "candidate lifecycle deadline")
+    return min(1980, seconds)
+
+
+def protected_root(value):
+    root = legacy.alias_root(value)
+    require(root.parts[1] != "workspace", "compiled root requires protected ancestors outside writable workspace")
+    return root
+
+
+def original_descriptor(descriptor):
+    return legacy.checked_descriptor({key: descriptor[key] for key in (
+        "source_root", "source", "fixture_inputs", "executable_bytes", "executable_sha256",
+        "listing_sha256", "test_count", "sdk_image")} | {
+        "inventory_sha256": descriptor["runtime"]["inventory_sha256"],
+        "capture_seconds": descriptor["remaining_seconds"]})
+
+
+def stage_admission(descriptor):
+    return {"schema": STAGE_SCHEMA, "route": ROUTE, "descriptor_sha256": digest(descriptor),
+            **{key: descriptor[key] for key in ("source_sha256", "union_sha256", "fixture_inputs_sha256",
+                                               "authority", "executable_sha256")},
+            "transfer_manifest_sha256": digest(transfer_manifest(descriptor)), "input_eof_observed": True}
+
+
+def checked_candidate_response(value, descriptor):
+    require(type(value) is dict and set(value) == {"schema", "route", "descriptor_sha256",
+        "source_sha256", "union_sha256", "fixture_inputs_sha256", "authority", "sdk_tree",
+        "sdk_tree_sha256", "image_authority", "readonly_views", "payload"}, "closed candidate response")
+    require(value["schema"] == RESPONSE_SCHEMA and value["route"] == ROUTE
+            and value["descriptor_sha256"] == digest(descriptor), "candidate response descriptor differs")
+    for key in ("source_sha256", "union_sha256", "fixture_inputs_sha256", "authority"):
+        require(encoded(value[key]) == encoded(descriptor[key]), "candidate response binding differs: " + key)
+    validate_rows(value["sdk_tree"])
+    require(value["sdk_tree_sha256"] == digest(value["sdk_tree"])
+            and encoded(value["image_authority"]) == encoded(descriptor["runtime"]["image_authority"]),
+            "separate SDK baseline differs")
+    require(encoded(value["readonly_views"]) == encoded({"input": "/candidate-input", "compiled_root": descriptor["source_root"],
+            "subpath": "candidate-source", "same_directory": True, "readonly": True,
+            "protected_ancestors": True}), "actual readonly views required")
+    legacy.checked_response(value["payload"], original_descriptor(descriptor))
+    require(not any(r["path"] == ENVELOPE_NAME for r in value["payload"]["records"]),
+            "guest cannot publish host transport envelope")
+    require(len(encoded(value)) <= legacy.MAX_JSON, "candidate response JSON bound")
+    return value
+
+
+def retirement_control(descriptor):
+    return {"retire": True, "descriptor_sha256": digest(descriptor)}
+
+
+def receive_retirement(reader, descriptor):
+    require(encoded(reader.line()) == encoded(retirement_control(descriptor)),
+            "closed descriptor-bound candidate retirement acknowledgement required")
+    reader.exhausted()
+
+
+def response_wrapper(descriptor, baseline, views, payload):
+    return checked_candidate_response({"schema": RESPONSE_SCHEMA, "route": ROUTE,
+        "descriptor_sha256": digest(descriptor), **{k: descriptor[k] for k in (
+            "source_sha256", "union_sha256", "fixture_inputs_sha256", "authority")},
+        "sdk_tree": baseline, "sdk_tree_sha256": digest(baseline),
+        "image_authority": descriptor["runtime"]["image_authority"], "readonly_views": views,
+        "payload": payload}, descriptor)
+
+
+def mount_rows(body):
+    require(len(body) <= legacy.MIB, "mount graph bound")
+    rows = []
+    for line in body.decode("utf-8", "strict").splitlines():
+        fields = line.split()
+        require(len(fields) >= 10 and "-" in fields, "actual mountinfo grammar")
+        # All admitted paths are ASCII without mountinfo escape characters.
+        rows.append({"device": fields[2], "root": fields[3], "target": fields[4],
+                     "options": fields[5].split(",")})
+    return rows
+
+
+def verify_views(descriptor, deadline):
+    root = protected_root(descriptor["source_root"])
+    fixed = Path("/candidate-input")
+    with open("/proc/self/mountinfo", "rb") as stream:
+        mounts = mount_rows(stream.read(legacy.MIB + 1))
+    selected = []
+    for path in (fixed, root):
+        require(path.resolve() == path and stat.S_ISDIR(os.lstat(path).st_mode)
+                and os.statvfs(path).f_flag & os.ST_RDONLY, "actual readonly candidate view required")
+        rows = [r for r in mounts if r["target"] == str(path)]
+        require(len(rows) == 1 and "ro" in rows[0]["options"] and "rw" not in rows[0]["options"],
+                "exact readonly candidate mount required")
+        require(not any(r["target"].startswith(str(path) + "/") for r in mounts),
+                "nested candidate mount refused")
+        selected.append(rows[0])
+    require(selected[0]["device"] == selected[1]["device"]
+            and selected[1]["root"] == selected[0]["root"].rstrip("/") + "/candidate-source",
+            "actual candidate subpath mount relation")
+    source = fixed / "candidate-source"
+    require((os.lstat(source).st_dev, os.lstat(source).st_ino) ==
+            (os.lstat(root).st_dev, os.lstat(root).st_ino), "candidate views are not the same directory")
+    for parent in root.parents:
+        info = os.lstat(parent)
+        require(stat.S_ISDIR(info.st_mode) and info.st_uid == 0 and parent.resolve() == parent,
+                "compiled-root ancestor is not protected")
+        # Root-owned sticky top-level tmpfs protects its root-owned child.
+        sticky_anchor = str(parent) in ("/tmp", "/workspaces") and bool(info.st_mode & stat.S_ISVTX)
+        require(sticky_anchor or (not info.st_mode & 0o022 and info.st_uid != os.getuid()),
+                "writable compiled-root ancestor")
+    verify_materialized(fixed, descriptor, deadline)
+    require(complete_tree(root, deadline) == descriptor["union"], "compiled view source differs")
+    return {"input": str(fixed), "compiled_root": str(root), "subpath": "candidate-source",
+            "same_directory": True, "readonly": True, "protected_ancestors": True}
+
+
+def sdk_baseline(descriptor, deadline):
+    root = legacy.SDK_ROOT
+    require(root.resolve() == root and os.statvfs(root).f_flag & os.ST_RDONLY,
+            "immutable installed SDK root required")
+    require(legacy.INVENTORY.resolve() == legacy.INVENTORY
+            and Path("/etc/profile.d/prismpm-sdk.sh").is_file(), "fixed installed SDK marker required")
+    inventory = legacy.read_regular(legacy.INVENTORY, 8 * legacy.MIB)
+    require(sha(inventory) == descriptor["runtime"]["inventory_sha256"], "independent installed inventory differs")
+    rows = complete_tree(root, deadline)
+    observed = []
+    for record in descriptor["runtime"]["image_authority"]:
+        body = legacy.read_regular(Path(record["path"]), legacy.MAX_FILE)
+        observed.append({"path": record["path"], "bytes": len(body), "sha256": sha(body)})
+    require(encoded(observed) == encoded(descriptor["runtime"]["image_authority"]),
+            "independent image authority differs")
+    return rows
+
+
+def guest(descriptor: dict, deadline: float) -> dict:
+    with deadline_scope(deadline):
+        return _guest(descriptor, deadline)
+
+
+def _guest(descriptor, deadline):
+    validate_descriptor(descriptor)
+    require(sys.version_info[:3] == (3, 12, 3) and os.getuid() == 1000 and os.getgid() == 1000,
+            "actual pinned SDK guest required")
+    require(os.environ.get("PRISMPM_TEST_SDK_IMAGE") == SDK_IMAGE, "actual SDK guest environment")
+    views = verify_views(descriptor, deadline)
+    baseline = sdk_baseline(descriptor, deadline)
+    bindings = {"executable_sha256": descriptor["executable_sha256"],
+                "inventory_sha256": descriptor["runtime"]["inventory_sha256"],
+                "source_sha256": descriptor["source_sha256"]}
+    # Ensure a bounded diagnostic response fits before executing the test. The
+    # placeholder result only sizes framing; it is never emitted or admitted.
+    sizing = response_wrapper(descriptor, baseline, views,
+        {**bindings, "result": {}, "stdout_bytes": 0, "stderr_bytes": 0, "records": []})
+    require(len(encoded(sizing)) + 8192 <= legacy.MAX_JSON, "SDK baseline leaves no response diagnostic headroom")
+    executable = Path("/candidate-input/current-test-elf")
+    require(measured_listing(executable, deadline) == (descriptor["listing_sha256"], descriptor["test_count"]),
+            "immutable candidate listing/count differs")
+    work = Path("/workspace/conditional-capture")
+    info = os.lstat(work.parent)
+    require(work.parent.resolve() == work.parent and stat.S_ISDIR(info.st_mode) and info.st_uid == 1000
+            and info.st_mode & 0o200 and legacy.shutil.disk_usage(work.parent).free >= 10 * 1024**3,
+            "owned execution volume requires 10 GiB actual free space")
+    work.mkdir(mode=0o700)
+    output, temporary, cargo, elan = (work / name for name in ("capture", "tmp", "cargo", "elan"))
+    output.mkdir(mode=0o700)
+    temporary.mkdir(mode=0o700)
+    custody = legacy.copy_private_cargo_cache(Path("/opt/prismpm/cargo-home"), cargo)
+    custody["protoc"] = legacy.run_vendored_protoc(cargo, custody)
+    elan.mkdir(mode=0o700)
+    os.symlink("/usr/local/elan/toolchains", elan / "toolchains")
+    environment = {**os.environ, "CARGO_HOME": str(cargo), "ELAN_HOME": str(elan), "TMPDIR": str(temporary),
+                   "PRISMPM_OC10_CAPTURE_OUTPUT": str(output), "PRISMPM_OC10_SDK_CHILD": "sealed-current-test-elf"}
+    seconds = remaining_seconds(deadline, 30)
+    command = legacy.run_bounded(["/usr/local/bin/node",
+        "/candidate-input/candidate-source/scripts/conditional-capture-candidate-command.mjs",
+        str(executable), str(work), str(seconds)], cwd=descriptor["source_root"], env=environment,
+        timeout=min(seconds + 10, deadline - time.monotonic() - 5), limit=legacy.MIB)
+    require(command.returncode == 0, "candidate command supervisor failed: " + command.stderr.decode(errors="replace"))
+    result = legacy.json.loads(legacy.read_regular(work / "command-result.json", legacy.MIB))
+    stdout = legacy.read_regular(work / "stdout", 32 * legacy.MIB)
+    stderr = legacy.read_regular(work / "stderr", 32 * legacy.MIB)
+    secondary = None
+    payload = {**bindings, "result": result, "stdout_bytes": len(stdout), "stderr_bytes": len(stderr), "records": []}
+    try:
+        try:
+            legacy.checked_result(result)
+        except RuntimeError:
+            pass  # Failed commands still return their original bounded streams.
+        else:
+            legacy.verify_private_cargo_tools(cargo, custody)
+            _exclusive(output / "cargo-cache-custody.json", encoded(custody), 0o600)
+        require(verify_views(descriptor, deadline) == views and sdk_baseline(descriptor, deadline) == baseline,
+                "candidate or separate SDK baseline changed")
+        payload["records"] = legacy.capture_records(output, result)
+        response = response_wrapper(descriptor, baseline, views, payload)
+    except Exception as error:
+        # Match original transport_capture: preserve BOTH streams under their
+        # original channel names even when secondary retained evidence fails.
+        # Empty evidence plus failed guest completion can never be accepted.
+        secondary = error
+        payload["records"] = []
+        response = response_wrapper(descriptor, baseline, views, payload)
+    for body in (encoded(response), stdout, stderr):
+        legacy.write_bounded(sys.stdout.buffer, body, deadline)
+    if secondary is not None:
+        raise secondary
+    for record in payload["records"]:
+        if record["kind"] == "file":
+            body = legacy.read_regular(output / record["path"], record["bytes"])
+            require(sha(body) == record["sha256"] and len(body) == record["bytes"], "capture member changed")
+            legacy.write_bounded(sys.stdout.buffer, body, deadline)
+    reader = Reader(sys.stdin.buffer, deadline)
+    receive_retirement(reader, descriptor)
+    return response
+
+
+
+def nonblocking_forward(body, target, deadline):
+    """Never wait on an inherited sink; retention belongs to Diagnostics."""
+    if time.monotonic() >= deadline:
+        return False
+    fd = target.fileno()
+    blocked = os.get_blocking(fd)
+    try:
+        os.set_blocking(fd, False)
+        with deadline_scope(deadline):
+            offset = 0
+            while offset < len(body):
+                try:
+                    count = os.write(fd, body[offset:offset + 4096])
+                except (BlockingIOError, BrokenPipeError):
+                    return False
+                require(count > 0, "diagnostic sink write failed")
+                offset += count
+        return True
+    except (OSError, RuntimeError):
+        return False
+    finally:
+        os.set_blocking(fd, blocked)
+
+
+class Diagnostics:
+    """Private fixed-channel spool; persistent on failure or sink backpressure.
+
+    Attachment writers retain their existing RLIMIT_FSIZE=1 MiB. Parent writes
+    never enter Python's inherited buffered streams or wait for pipe capacity.
+    Files live outside the capture tree and can never be capture admission.
+    """
+    CAPS = {"owner.stderr": legacy.MIB, "exception.stdout": 32 * legacy.MIB,
+            "exception.stderr": 32 * legacy.MIB, "stage.stderr": legacy.MIB, "execute.stderr": legacy.MIB,
+            "capture.stdout": 32 * legacy.MIB, "capture.stderr": 32 * legacy.MIB}
+
+    def __init__(self, deadline, token=None):
+        self.deadline, self.directory = deadline, None
+        self.token = token or legacy.uuid.uuid4().hex
+        require(re.fullmatch(r"[0-9a-f]{32}", self.token), "diagnostic owner token")
+        self.location = Path("/tmp") / ("prismpm-candidate-diagnostics-" + self.token)
+        self.reconciled = False
+        self.retention_incomplete = False
+        self.forwarded = set()
+        self.streams, self.lengths, self.attachments = {}, {}, set()
+        self.closed_attachments = set()
+        self.closed = False
+        self.directory_fd, self.directory_identity = None, None
+        self.file_identities = {}
+
+    @staticmethod
+    def ownership(info):
+        return (info.st_dev, info.st_ino, info.st_mode, info.st_uid, info.st_gid)
+
+    def bind_output(self, output):
+        require(self.directory is None, "diagnostic location already allocated")
+        info = os.lstat(output)
+        require(output.is_absolute() and output.resolve() == output and stat.S_ISDIR(info.st_mode)
+                and info.st_uid == os.getuid() and info.st_mode & 0o077 == 0,
+                "validated capture output required for diagnostic sibling")
+        self.location = output.with_name(output.name + ".candidate-diagnostics")
+        self.ensure()  # Allocate the locator manifest before any actor work.
+
+    def check_owner(self):
+        require(self.directory.resolve() == self.directory
+                and self.ownership(os.lstat(self.directory)) == self.directory_identity
+                and self.ownership(os.fstat(self.directory_fd)) == self.directory_identity,
+                "diagnostic directory ownership changed")
+
+    def open_owned(self, name):
+        require(name in self.CAPS or name == "manifest.json", "closed diagnostic filename")
+        self.check_owner()
+        fd = os.open(name, os.O_WRONLY | os.O_CREAT | os.O_EXCL | os.O_NOFOLLOW | os.O_CLOEXEC,
+                     0o600, dir_fd=self.directory_fd)
+        self.file_identities[name] = self.ownership(os.fstat(fd))
+        return os.fdopen(fd, "wb", buffering=0)
+
+    def manifest(self):
+        return {"schema": "prismpm/conditional-candidate-diagnostics/1", "owner_token": self.token,
+                "complete_application_accepted": False,
+                "channels": [{"path": name, "maximum_bytes": self.CAPS[name]} for name in sorted(self.CAPS)],
+                "aggregate_limits": {"capture": 64 * legacy.MIB, "exception": 32 * legacy.MIB}}
+
+    def locator(self):
+        return {"schema": "prismpm/conditional-candidate-diagnostics-locator/1", "owner_token": self.token,
+                "directory": str(self.location), "manifest": "manifest.json",
+                "manifest_sha256": digest(self.manifest()), "complete_application_accepted": False}
+
+    def ensure(self):
+        with deadline_scope(self.deadline):
+            if self.directory is None:
+                require(self.location.parent.resolve() == self.location.parent, "aliased diagnostic parent")
+                parent_fd = os.open(self.location.parent, os.O_RDONLY | os.O_DIRECTORY | os.O_NOFOLLOW | os.O_CLOEXEC)
+                try:
+                    os.mkdir(self.location.name, mode=0o700, dir_fd=parent_fd)
+                    self.directory_fd = os.open(self.location.name, os.O_RDONLY | os.O_DIRECTORY | os.O_NOFOLLOW
+                                                | os.O_CLOEXEC, dir_fd=parent_fd)
+                finally:
+                    os.close(parent_fd)
+                self.directory = self.location
+                info = os.fstat(self.directory_fd)
+                require(stat.S_IMODE(info.st_mode) == 0o700 and info.st_uid == os.getuid(), "private diagnostic owner")
+                self.directory_identity = self.ownership(info)
+                with self.open_owned("manifest.json") as stream:
+                    body = encoded(self.manifest())
+                    require(len(body) <= legacy.MIB and stream.write(body) == len(body), "bounded diagnostic manifest")
+            self.check_owner()
+            return self.directory
+
+    def stream(self, channel):
+        require(channel in self.CAPS and not self.closed, "closed diagnostic channel")
+        if channel not in self.streams:
+            self.ensure()
+            self.streams[channel] = self.open_owned(channel)
+            self.lengths[channel] = 0
+        return self.streams[channel]
+
+    def attachment(self, role):
+        require(role in ("stage", "execute"), "closed attachment diagnostic role")
+        channel = role + ".stderr"
+        with deadline_scope(self.deadline):
+            require(channel not in self.streams, "duplicate attachment diagnostic stream")
+            stream = self.stream(channel)
+            self.attachments.add(channel)
+            return stream
+
+    def record(self, channel, body):
+        require(channel in self.CAPS and isinstance(body, bytes), "closed diagnostic bytes")
+        if time.monotonic() >= self.deadline:
+            return False
+        with deadline_scope(self.deadline):
+            stream = self.stream(channel)
+            self.check_owner()
+            require(self.ownership(os.fstat(stream.fileno())) == self.file_identities[channel],
+                    "diagnostic file ownership changed")
+            require(channel not in self.attachments and self.lengths[channel] + len(body) <= self.CAPS[channel],
+                    "candidate diagnostic channel bound")
+            if channel.startswith(("capture.", "exception.")):
+                prefix = channel.split(".", 1)[0] + "."
+                combined = sum(size for name, size in self.lengths.items() if name.startswith(prefix)) + len(body)
+                require(combined <= (64 if prefix == "capture." else 32) * legacy.MIB,
+                        "combined original diagnostic stream bound")
+            offset = 0
+            while offset < len(body):
+                count = stream.write(body[offset:offset + legacy.MIB])
+                require(count is not None and count > 0, "diagnostic retention write failed")
+                self.lengths[channel] += count
+                offset += count
+        return True  # Sink forwarding is deferred until actor reconciliation.
+
+    def message(self, text):
+        body = (text + "\n").encode("utf-8", "backslashreplace")
+        remaining = self.CAPS["owner.stderr"] - self.lengths.get("owner.stderr", 0)
+        if len(body) > remaining:
+            body = body[:max(0, remaining - 32)] + b"\n[diagnostic message truncated]\n"[:remaining]
+            body = body[:remaining]
+        return self.record("owner.stderr", body)
+
+    def retain_exception_streams(self, error):
+        # Retain at the observation site, before a cleanup wrapper can replace
+        # this error. Mark individual channels only after a complete write, so
+        # later parent handling neither duplicates bytes nor hides a short write.
+        retained = getattr(error, "candidate_retained_channels", {})
+        error.candidate_retained_channels = retained
+        try:
+            for name in ("stdout", "stderr"):
+                body = getattr(error, name, b"")
+                if body and retained.get(name) != self.token:
+                    require(self.record("exception." + name, body), "exception stream retention deadline")
+                    retained[name] = self.token
+        except Exception:
+            self.retention_incomplete = True
+            raise
+
+    def exception(self, error):
+        # Only retention occurs before reconciliation; inherited forwarding is
+        # still exclusively the later forward/close operation.
+        try:
+            self.retain_exception_streams(error)
+        except Exception:
+            pass  # Existing bytes remain; report incomplete retention below.
+        suffix = "; original exception stream retention incomplete (bound/deadline or I/O failure)" \
+            if self.retention_incomplete else ""
+        self.message("candidate capture failed: " + str(error) + suffix)
+
+    def forward(self, channels):
+        if not self.reconciled:
+            return
+        for channel in sorted(set(channels) - self.forwarded):
+            if time.monotonic() >= self.deadline:
+                break  # Actual bytes persist; never renew time or wait on sinks.
+            with deadline_scope(self.deadline):
+                self.check_owner()
+                require(self.ownership(os.lstat(self.directory / channel)) == self.file_identities[channel],
+                        "diagnostic file ownership changed")
+                body = legacy.read_regular(self.directory / channel, self.CAPS[channel])
+                self.check_owner()
+            target = sys.stdout.buffer if channel.endswith(".stdout") else sys.stderr.buffer
+            nonblocking_forward(body, target, self.deadline)
+            self.forwarded.add(channel)
+
+    def close_attachments(self):
+        pending = sorted(self.attachments - self.closed_attachments)
+        for channel in pending:
+            self.streams[channel].close()
+            self.closed_attachments.add(channel)
+        self.forward(pending)
+
+    def close(self):
+        if self.closed:
+            return
+        try:
+            try:
+                self.close_attachments()
+            finally:
+                for stream in self.streams.values():
+                    stream.close()
+                self.closed = True
+            self.forward(self.streams)
+        finally:
+            if self.directory_fd is not None:
+                os.close(self.directory_fd)
+                self.directory_fd = None
+
+
+
+class Lifecycle:
+    """Single-deadline actor custody; fake transcripts test policy, never Docker."""
+    def __init__(self, deadline, image, environment, token=None, diagnostics=None):
+        self.deadline = deadline
+        # Six seconds covers Task1's failure-only listing/Git reap; all other
+        # run_bounded failure reaps are charged inside their per-call cap.
+        self.work_deadline = deadline - legacy.RETIREMENT_RESERVE_SECONDS - 6
+        self.image, self.environment = image, environment
+        self.token = token or (diagnostics.token if diagnostics is not None else legacy.uuid.uuid4().hex)
+        self.diagnostics = diagnostics or Diagnostics(deadline, self.token)
+        require(self.diagnostics.token == self.token, "diagnostic/lifecycle owner token differs")
+        self.prefix = "prismpm-candidate-" + self.token
+        self.actors, self.volumes, self.attachments = {}, {}, []
+        self.cleanup_calls, self.cleanup_mode = 0, False
+        self.stage_retired = False
+        self.inspection_retired = False
+
+    def call(self, *arguments, limit=legacy.MAX_JSON):
+        if self.cleanup_mode:
+            require(self.cleanup_calls < 18, "candidate reconciliation daemon-call bound")
+            self.cleanup_calls += 1
+        deadline = self.deadline if self.cleanup_mode else self.work_deadline
+        # Immutable run_bounded may reap its failed child for five seconds.
+        # Include that inside the 15-second daemon allowance, not after it.
+        timeout = min(10, deadline - time.monotonic() - 5)
+        require(timeout > 0, "candidate daemon cleanup deadline")
+        blocked = signal.pthread_sigmask(signal.SIG_BLOCK, {signal.SIGHUP, signal.SIGINT, signal.SIGTERM})
+        try:
+            result = legacy.run_bounded(["docker", "--host", "unix:///var/run/docker.sock", *arguments],
+                timeout=timeout, limit=limit,
+                env={k: v for k, v in os.environ.items() if not k.startswith("DOCKER_")})
+        finally:
+            signal.pthread_sigmask(signal.SIG_SETMASK, blocked)
+        if result.returncode != 0:
+            error = RuntimeError("candidate Docker control failed")
+            error.stdout, error.stderr = result.stdout, result.stderr
+            try:
+                self.diagnostics.retain_exception_streams(error)
+            except Exception as retention_error:
+                # Logging failure must not replace the operation failure or
+                # prevent finish() from attempting the remaining safe calls.
+                error.args = (str(error) + "; diagnostic retention incomplete: " + str(retention_error),)
+            raise error
+        return result
+
+    def inspect(self, cid):
+        values = legacy.json.loads(self.call("container", "inspect", cid).stdout)
+        require(type(values) is list and len(values) == 1, "one actual actor inspection required")
+        return values[0]
+
+    def image_file(self, cid, path, limit):
+        # Same stopped-image tar grammar as immutable image_file; substitute
+        # only the deadline-aware daemon adapter, never an ambient helper.
+        import io
+        body = self.call("container", "cp", cid + ":" + str(path), "-", limit=limit + legacy.MIB).stdout
+        with legacy.tarfile.open(fileobj=io.BytesIO(body), mode="r:") as archive:
+            members = archive.getmembers()
+            require(len(members) == 1 and members[0].isfile() and members[0].size <= limit
+                    and members[0].name == path.name, "exact stopped-image file required")
+            return archive.extractfile(members[0]).read(limit + 1)
+
+    def volume(self, role):
+        name = self.prefix + "-" + role
+        self.volumes[role] = name  # Record pending creation before daemon call.
+        require(self.call("volume", "create", "--label", legacy.LABEL + "=" + self.token,
+            "--label", ROLE_LABEL + "=" + role, name).stdout.decode().strip() == name,
+            "fresh labelled candidate volume required")
+        return name
+
+    def spec(self, role, argv, source_root=None, socket_gid=None):
+        require(role in ("inspect", "stage", "execute"), "closed candidate actor role")
+        if role == "inspect":
+            require(argv == ["-I", "-B", "-c", "pass"], "fixed never-started inspection argv")
+            return {"role": role, "name": self.prefix + "-" + role, "argv": argv,
+                    "mounts": [], "groups": [], "tmpfs": {**TMPFS,
+                    "/workspace": "rw,noexec,nosuid,nodev,size=16m,mode=1777"}}
+        require(self.inspection_retired, "inspection absence required before stage creation")
+        if role == "execute":
+            require(self.stage_retired, "stage absence required before execution creation")
+            protected_root(source_root)
+        mounts = [{"Type": "volume", "Source": self.volumes["input"],
+                   "Target": "/workspace" if role == "stage" else "/candidate-input",
+                   "ReadOnly": role == "execute"}]
+        if role == "execute":
+            mounts.extend([{"Type": "volume", "Source": self.volumes["input"], "Target": source_root,
+                "ReadOnly": True, "VolumeOptions": {"Subpath": "candidate-source"}},
+                {"Type": "volume", "Source": self.volumes["work"], "Target": "/workspace", "ReadOnly": False},
+                {"Type": "bind", "Source": "/var/run/docker.sock", "Target": "/var/run/docker.sock", "ReadOnly": False}])
+        return {"role": role, "name": self.prefix + "-" + role, "argv": argv,
+                "mounts": mounts, "groups": [] if role == "stage" else [str(socket_gid)], "tmpfs": TMPFS}
+
+    def authenticate(self, actor, spec):
+        require(actor["Id"] and re.fullmatch(r"[0-9a-f]{64}", actor["Id"])
+            and actor["Image"] == self.image and actor["Name"] == "/" + spec["name"]
+            and actor["Config"]["Labels"].get(legacy.LABEL) == self.token
+            and actor["Config"]["Labels"].get(ROLE_LABEL) == spec["role"], "candidate actor ownership differs")
+        known = self.actors[spec["role"]].get("id")
+        require(known is None or known == actor["Id"], "candidate actor identity replaced")
+        return actor["Id"]
+
+    def validate_actor(self, actor, spec):
+        self.authenticate(actor, spec)
+        config, host = actor["Config"], actor["HostConfig"]
+        require(config["Entrypoint"] == ["/usr/bin/python3"] and config["Cmd"] == spec["argv"]
+            and config["User"] == "1000:1000" and config["WorkingDir"] == "/workspace"
+            and config["OpenStdin"] is True and config["Tty"] is False
+            and sorted(config["Env"]) == sorted(self.environment), "actual actor argv/environment differs")
+        require(host["ReadonlyRootfs"] is True and host["NetworkMode"] == "none"
+            and host["AutoRemove"] is False and host["Memory"] == 8 * 1024**3
+            and host["MemorySwap"] == 8 * 1024**3 and host["NanoCpus"] == 2 * 10**9
+            and host["PidsLimit"] == 256 and host["CapDrop"] == ["ALL"] and not host.get("CapAdd")
+            and host["SecurityOpt"] == ["no-new-privileges:true"] and host["Privileged"] is False
+            and not host.get("Devices") and not host.get("Binds") and not host.get("VolumesFrom")
+            and not host.get("PidMode") and host.get("IpcMode") in ("", "private", "none")
+            and not host.get("UsernsMode") and host["Tmpfs"] == spec["tmpfs"]
+            and (host.get("GroupAdd") or []) == spec["groups"], "actual actor resource policy differs")
+        actual_requests = []
+        for mount in host.get("Mounts") or []:
+            require(set(mount) <= {"Type", "Source", "Target", "ReadOnly", "VolumeOptions",
+                    "BindOptions", "Consistency"}, "unexpected mount option")
+            normalized = {k: mount[k] for k in ("Type", "Source", "Target")}
+            normalized["ReadOnly"] = mount.get("ReadOnly", False)
+            if "VolumeOptions" in mount:
+                options = mount["VolumeOptions"]
+                require(set(options) <= {"Subpath", "NoCopy"} and not options.get("NoCopy"), "volume initialization policy")
+                if options.get("Subpath"):
+                    normalized["VolumeOptions"] = {"Subpath": options["Subpath"]}
+            require(not mount.get("BindOptions") and not mount.get("Consistency"), "unexpected mount propagation")
+            actual_requests.append(normalized)
+        require(encoded(actual_requests) == encoded(spec["mounts"]), "exact readonly subpath mount request differs")
+        actual = []
+        for mount in actor["Mounts"]:
+            actual.append((mount["Type"], mount["Name"] if mount["Type"] == "volume" else mount["Source"],
+                           mount["Destination"], mount["RW"]))
+        expected = [(m["Type"], m["Source"], m["Target"], not m["ReadOnly"]) for m in spec["mounts"]]
+        require(sorted(actual) == sorted(expected), "actual actor mount graph differs")
+        return actor
+
+    def create(self, spec):
+        role = spec["role"]
+        require(role in ("inspect", "stage", "execute"), "closed candidate creation role")
+        require(not any(not item["retired"] for item in self.actors.values()),
+                "preceding candidate actor retirement required")
+        require(role == "inspect" or self.inspection_retired, "inspection absence required before creation")
+        require(role != "execute" or self.stage_retired, "stage absence required before execution creation")
+        require(role not in self.actors, "candidate actor recreation refused")
+        self.actors[role] = {"spec": spec, "id": None, "retired": False}
+        args = ["create", "--name", spec["name"], "--label", legacy.LABEL + "=" + self.token,
+                "--label", ROLE_LABEL + "=" + role, "--interactive", "--read-only", "--network", "none",
+                "--user", "1000:1000", "--cap-drop", "ALL", "--security-opt", "no-new-privileges:true",
+                "--memory", "8g", "--memory-swap", "8g", "--cpus", "2", "--pids-limit", "256"]
+        for group in spec["groups"]:
+            args += ["--group-add", group]
+        for path, options in spec["tmpfs"].items():
+            args += ["--tmpfs", path + ":" + options]
+        for mount in spec["mounts"]:
+            text = "type=" + mount["Type"] + ",source=" + mount["Source"] + ",target=" + mount["Target"]
+            if mount["ReadOnly"]:
+                text += ",readonly"
+            if mount.get("VolumeOptions"):
+                text += ",volume-subpath=candidate-source"
+            args += ["--mount", text]
+        args += ["--env", "PRISMPM_TEST_SDK_IMAGE=" + SDK_IMAGE, "--entrypoint", "/usr/bin/python3",
+                 self.image, *spec["argv"]]
+        cid = self.call(*args).stdout.decode().strip()
+        require(re.fullmatch(r"[0-9a-f]{64}", cid), "complete candidate actor ID required")
+        self.actors[role]["id"] = cid
+        actor = self.validate_actor(self.inspect(cid), spec)
+        require(actor["State"]["Status"] == "created" and actor["State"]["Running"] is False
+                and actor["State"]["Pid"] == 0 and actor["State"]["StartedAt"] == "0001-01-01T00:00:00Z",
+                "actor started before policy inspection")
+        return cid
+
+    def references(self, expected=None):
+        names = self.call("container", "ls", "--all", "--no-trunc", "--filter",
+                          "volume=" + self.volumes["input"], "--format", "{{.ID}}").stdout.decode().splitlines()
+        require(names == ([] if expected is None else [expected]), "additional candidate input volume reference")
+
+    def attach(self, role, diagnostics):
+        require(role in ("stage", "execute") and len(self.attachments) < 2,
+                "only two executable candidate attachments")
+        actor = self.actors[role]
+        actual = self.validate_actor(self.inspect(actor["id"]), actor["spec"])
+        require(actual["State"]["Status"] == "created" and actual["State"]["Running"] is False
+                and actual["State"]["Pid"] == 0
+                and actual["State"]["StartedAt"] == "0001-01-01T00:00:00Z", "actor started before attachment")
+        # Do not install a work alarm across Popen's ownership handoff.
+        tick(self.work_deadline)
+        blocked = signal.pthread_sigmask(signal.SIG_BLOCK, {signal.SIGHUP, signal.SIGINT, signal.SIGTERM})
+        try:
+            child = legacy.subprocess.Popen(["docker", "--host", "unix:///var/run/docker.sock", "start",
+                "--attach", "--interactive", actor["id"]], stdin=legacy.subprocess.PIPE,
+                stdout=legacy.subprocess.PIPE, stderr=diagnostics, preexec_fn=legacy.bound_diagnostic_file,
+                env={k: v for k, v in os.environ.items() if not k.startswith("DOCKER_")})
+            self.attachments.append(child)
+        finally:
+            signal.pthread_sigmask(signal.SIG_SETMASK, blocked)
+        return child
+
+    def retire_actor(self, role):
+        item = self.actors[role]
+        if item["retired"]:
+            return
+        spec = item["spec"]
+        ids = self.call("container", "ls", "--all", "--no-trunc", "--filter",
+            "name=^/" + spec["name"] + "$", "--format", "{{.ID}}").stdout.decode().splitlines()
+        require(len(ids) <= 1, "ambiguous candidate actor reconciliation")
+        if ids:
+            actor = self.inspect(ids[0])
+            item["id"] = self.authenticate(actor, spec)
+            self.call("container", "rm", "--force", item["id"])
+        else:
+            require(item["id"] is not None, "pending candidate creation is uncertain")
+        require(self.call("container", "ls", "--all", "--no-trunc", "--filter",
+            "name=^/" + spec["name"] + "$", "--format", "{{.ID}}").stdout == b"", "candidate actor name absence unproven")
+        require(self.call("container", "ls", "--all", "--no-trunc", "--filter", "id=" + item["id"],
+            "--format", "{{.ID}}").stdout == b"", "candidate actor ID absence unproven")
+        item["retired"] = True
+        if role == "stage":
+            self.stage_retired = True
+        if role == "inspect":
+            self.inspection_retired = True
+
+    def wait_attachment(self, child, successful=False):
+        limit = self.work_deadline if successful else self.deadline
+        # At most 30 normal seconds + five forced-reap seconds; both absolute.
+        left = min(30, limit - time.monotonic() - 5)
+        require(left > 0, "candidate attachment retirement deadline")
+        try:
+            status = child.wait(timeout=left)
+        except legacy.subprocess.TimeoutExpired:
+            child.kill()
+            remaining = min(5, limit - time.monotonic())
+            require(remaining > 0, "candidate attachment forced-reap deadline")
+            child.wait(timeout=remaining)
+            raise RuntimeError("candidate attachment force retirement")
+        if successful:
+            require(status == 0, "candidate attachment failed")
+        return status
+
+    def finish(self, completed):
+        self.cleanup_mode = True
+        errors = []
+        for child in self.attachments:
+            if child.stdin and not child.stdin.closed:
+                try:
+                    child.stdin.close()
+                except OSError as error:
+                    errors.append(str(error))
+        # Creation barriers mean at most ONE actor is not already retired.
+        # Worst success: actor 5 + input refs 1 + both volumes 6 = 12 calls.
+        # Early failures never create later actors; pending inspection uses 5.
+        # The hard global cap remains 18, including failed control calls.
+        for role in self.actors:
+            try:
+                self.retire_actor(role)
+            except Exception as error:
+                errors.append(role + " actor: " + str(error))
+        for child in self.attachments:
+            try:
+                if child.poll() is None:
+                    self.wait_attachment(child)
+                if child.stdout:
+                    child.stdout.close()
+            except Exception as error:
+                errors.append("attachment: " + str(error))
+        if completed and not errors and "input" in self.volumes:
+            try:
+                self.references()
+            except Exception as error:
+                errors.append("input references: " + str(error))
+        # Authenticate BOTH volumes before deleting either; ambiguity retains both.
+        owned = []
+        for role, name in self.volumes.items():
+            try:
+                rows = legacy.json.loads(self.call("volume", "inspect", name).stdout)
+                require(type(rows) is list and len(rows) == 1 and rows[0]["Name"] == name
+                        and rows[0]["Labels"].get(legacy.LABEL) == self.token
+                        and rows[0]["Labels"].get(ROLE_LABEL) == role, "candidate volume ownership differs")
+                owned.append(name)
+            except Exception as error:
+                errors.append(role + " volume: " + str(error))
+        if completed and not errors:
+            for name in owned:
+                try:
+                    self.call("volume", "rm", name)
+                    require(self.call("volume", "ls", "--filter", "name=^" + name + "$", "--format",
+                        "{{.Name}}").stdout == b"", "candidate volume absence unproven")
+                except Exception as error:
+                    errors.append("volume retirement: " + str(error))
+                    break
+        self.diagnostics.reconciled = True
+        if not completed or errors:
+            self.diagnostics.message("Candidate failure; owned volumes retained; nested-oracle retirement unqualified: "
+                                     + legacy.json.dumps(self.volumes, sort_keys=True))
+        require(not errors, "candidate reconciliation unqualified: " + "; ".join(errors))
+        return {"actors": [{"role": role, "name": item["spec"]["name"], "id": item["id"], "absent": True}
+                           for role, item in self.actors.items()],
+                "volumes": [{"role": role, "name": name, "absent": completed} for role, name in self.volumes.items()],
+                "attachment_eof_observed": completed, "cleanup_daemon_calls": self.cleanup_calls}
+
+
+def inspect_runtime(owner):
+    spec = owner.spec("inspect", ["-I", "-B", "-c", "pass"])
+    cid = owner.create(spec)
+    bodies = []
+    for path, limit in ((legacy.INVENTORY, 8 * legacy.MIB),
+                        (legacy.SDK_ROOT / "scripts" / UTILITY_NAME, MAX_MODULE),
+                        (legacy.SDK_ROOT / "scripts/conditional-capture-command.mjs", MAX_MODULE)):
+        actor = owner.validate_actor(owner.inspect(cid), spec)
+        state = actor["State"]
+        require(state["Status"] == "created" and state["Running"] is False and state["Pid"] == 0
+                and state["StartedAt"] == "0001-01-01T00:00:00Z", "image inspection actor must never start")
+        bodies.append(owner.image_file(cid, path, limit))
+    inventory = legacy.json.loads(bodies[0])
+    require(type(inventory) is dict and set(inventory) == {"schema", "commands", "artifacts"}
+            and inventory["schema"] == "prismpm/sdk-inventory/1", "fixed installed SDK inventory required")
+    # Independent reviewed image identities, NOT equality to caller bytes.
+    require(sha(bodies[1]) == UTILITY_SHA256 and sha(bodies[2]) == IMAGE_LAUNCHER_SHA256,
+            "reviewed image authority identity differs")
+    owner.retire_actor("inspect")
+    return {"inventory_sha256": sha(bodies[0]), "image_authority": [
+        {"path": str(legacy.SDK_ROOT / "scripts" / name), "bytes": len(body), "sha256": sha(body)}
+        for name, body in zip((UTILITY_NAME, "conditional-capture-command.mjs"), bodies[1:])]}
+
+
+def bootstrap_argv(source, descriptor, mode, deadline):
+    code = legacy.read_regular(source / "scripts" / BOOTSTRAP_NAME, MAX_BOOTSTRAP)
+    rows = {r["path"]: r for r in descriptor["authority"]}
+    require(sha(code) == rows["scripts/" + BOOTSTRAP_NAME]["sha256"], "bootstrap source custody changed")
+    capsules = [rows["scripts/" + name] for name in (UTILITY_NAME, ENTRY_NAME)]
+    return ["-I", "-B", "-c", code.decode("utf-8", "strict"), mode,
+            str(remaining_seconds(deadline)), digest(descriptor),
+            *[str(r[k]) for r in capsules for k in ("bytes", "sha256")]]
+
+
+def recheck_inputs(source, executable, descriptor, identities, deadline):
+    with deadline_scope(deadline):
+        require(input_identities(source, executable, descriptor, deadline) == identities
+                and ordered(legacy.source_rows(source)) == descriptor["source"]
+                and ordered(legacy.fixture_rows(source)) == descriptor["fixture_inputs"]
+                and measure_regular(executable, legacy.MAX_ELF, deadline, elf=True) == {
+                    "bytes": descriptor["executable_bytes"], "sha256": descriptor["executable_sha256"]},
+                "outer source/fixture/authority/ELF custody changed")
+
+
+def receive_log(reader, length, target, diagnostics=None, channel=None):
+    require(type(length) is int and 0 <= length <= 32 * legacy.MIB, "original response stream bound")
+    body = bytearray()
+    while len(body) < length:
+        tick(reader.deadline)
+        if not reader.buffer:
+            reader.fill()
+        count = min(length - len(body), len(reader.buffer))
+        part = bytes(reader.buffer[:count])
+        del reader.buffer[:count]
+        body.extend(part)
+        if diagnostics is not None:
+            require(diagnostics.record(channel, part), "candidate diagnostic retention deadline")
+        else:
+            # Component callers can retain into an in-memory byte sink. Actual
+            # parent calls always supply its persistent Diagnostics owner.
+            import io
+            require(isinstance(target, io.BytesIO), "diagnostic owner required for external output sink")
+            target.write(part)
+    return bytes(body)
+
+
+def receive_capture(reader, response, output, diagnostics):
+    payload = response["payload"]
+    require(payload["stdout_bytes"] + payload["stderr_bytes"] <= 64 * legacy.MIB, "combined original response log bound")
+    stdout = receive_log(reader, payload["stdout_bytes"], sys.stdout.buffer, diagnostics, "capture.stdout")
+    stderr = receive_log(reader, payload["stderr_bytes"], sys.stderr.buffer, diagnostics, "capture.stderr")
+    rows = payload["records"]
+    for record in rows:
+        target = output / record["path"]
+        if record["kind"] == "directory":
+            target.mkdir(mode=0o700)
+        elif record["kind"] == "file":
+            body = reader.exact(record["bytes"])
+            require(sha(body) == record["sha256"], "retained original capture bytes differ")
+            _exclusive(target, body, 0o700 if record["executable"] else 0o600)
+    for record in rows:
+        if record["kind"] == "link":
+            os.symlink(record["target"], output / record["path"])
+    require(legacy.tree(output) == rows, "complete original capture readback differs")
+    return stdout, stderr
+
+
+def publish_envelope(output, body, deadline):
+    """Atomic local publication after retirement; remove only our partial file."""
+    pending, final = output / ".candidate-transport-pending.json", output / ENVELOPE_NAME
+    owned = None
+    try:
+        with deadline_scope(deadline):
+            require(not os.path.lexists(final), "occupied transport envelope")
+            _exclusive(pending, body, 0o600)
+            info = os.lstat(pending)
+            owned = (info.st_dev, info.st_ino)
+            require(legacy.read_regular(pending, legacy.MAX_JSON) == body, "transport envelope readback differs")
+            tick(deadline)
+            os.rename(pending, final)
+    except BaseException:
+        for path in (pending, final):
+            if os.path.lexists(path):
+                info = os.lstat(path)
+                if owned is not None and (info.st_dev, info.st_ino) == owned:
+                    os.unlink(path)
+        raise
+
+
+def parent(source: Path, executable: Path) -> int:
+    complete_deadline = time.monotonic() + legacy.DEADLINE_SECONDS
+    require(threading.current_thread() is threading.main_thread(), "candidate parent requires main thread")
+    diagnostics = Diagnostics(complete_deadline)
+    previous = {s: signal.getsignal(s) for s in (signal.SIGHUP, signal.SIGINT, signal.SIGTERM)}
+    def interrupted(_signal, _frame):
+        raise RuntimeError("candidate capture interrupted")
+    try:
+        for signum in previous:
+            signal.signal(signum, interrupted)
+        return _parent(source, executable, complete_deadline, diagnostics)
+    except BaseException as error:
+        # _parent's finally has already reconciled actors. Logging must never
+        # precede or postpone that authentication/removal work.
+        diagnostics.reconciled = True
+        try:
+            diagnostics.exception(error)
+        except Exception:
+            pass  # Preserve original failure; prior spooled bytes remain owned.
+        error.candidate_diagnostics = diagnostics.locator()
+        error.candidate_diagnostics_reported = True
+        raise
+    finally:
+        try:
+            diagnostics.close()
+        finally:
+            for signum, handler in previous.items():
+                signal.signal(signum, handler)
+
+
+def _parent(source, executable, complete_deadline, diagnostics):
+    source = protected_root(str(source))  # This refusal precedes every Docker call.
+    require(os.environ.get("PRISMPM_TEST_SDK_IMAGE") == SDK_IMAGE, "exact pinned candidate SDK image required")
+    owner = Lifecycle(complete_deadline, None, [], diagnostics=diagnostics)
+    output = Path(os.environ["PRISMPM_OC10_CAPTURE_OUTPUT"]) if "PRISMPM_OC10_CAPTURE_OUTPUT" in os.environ \
+        else Path(legacy.tempfile.mkdtemp(prefix="prismpm-conditional-capture-"))
+    held_output = os.lstat(output)
+    require(output.is_absolute() and output.resolve() == output and stat.S_ISDIR(held_output.st_mode)
+            and held_output.st_uid == os.getuid() and held_output.st_mode & 0o077 == 0
+            and not any(output.iterdir()), "fresh unaliased capture output required")
+    diagnostics.bind_output(output)
+    with deadline_scope(owner.work_deadline):
+        plan = measure_inputs(source, executable, remaining_seconds(owner.work_deadline))
+        identities = input_identities(source, executable, plan, owner.work_deadline)
+    image_rows = legacy.json.loads(owner.call("image", "inspect", SDK_IMAGE).stdout)
+    require(type(image_rows) is list and len(image_rows) == 1, "one actual immutable SDK image required")
+    image = image_rows[0]
+    architecture = {"x86_64": "amd64", "aarch64": "arm64"}.get(os.uname().machine)
+    require(image["Os"] == "linux" and architecture is not None and image["Architecture"] == architecture
+            and re.fullmatch(r"sha256:[0-9a-f]{64}", image["Id"]) and SDK_IMAGE in image["RepoDigests"],
+            "actual local pinned SDK config/platform differs")
+    require(set(image["Config"].get("Volumes") or {}) <= {"/workspace"},
+            "unsupported image-declared anonymous volume")
+    image_environment = image["Config"]["Env"]
+    require(type(image_environment) is list and len({e.split("=", 1)[0] for e in image_environment}) == len(image_environment)
+            and "PATH=/usr/local/elan/bin:/usr/local/cargo/bin:/usr/local/bin:/usr/bin:/bin" in image_environment
+            and not any(e.startswith("PRISMPM_TEST_SDK_IMAGE=") for e in image_environment), "pinned image environment differs")
+    owner.image = image["Id"]
+    owner.environment = image_environment + ["PRISMPM_TEST_SDK_IMAGE=" + SDK_IMAGE]
+    completed, retirement, response, descriptor = False, None, None, None
+    previous_signals = {s: signal.getsignal(s) for s in (signal.SIGHUP, signal.SIGINT, signal.SIGTERM)}
+    def interrupted(_signal, _frame):
+        raise RuntimeError("candidate capture interrupted")
+    for signum in previous_signals:
+        signal.signal(signum, interrupted)
+    diagnostics.message("Candidate capture infrastructure owner " + legacy.json.dumps({"token": owner.token,
+        "prefix": owner.prefix, "config_digest": owner.image,
+        "diagnostics": str(diagnostics.ensure())}, sort_keys=True))
+    try:
+        socket = os.stat("/var/run/docker.sock")
+        require(stat.S_ISSOCK(socket.st_mode), "actual Docker transport required")
+        observations = inspect_runtime(owner)
+        plan["remaining_seconds"] = remaining_seconds(owner.work_deadline)
+        descriptor = bind_runtime(plan, {"sdk_image": SDK_IMAGE, "config_digest": owner.image,
+            "os": image["Os"], "architecture": image["Architecture"], **observations})
+        owner.volume("input")
+        stage_spec = owner.spec("stage", bootstrap_argv(source, descriptor, "stage-v1", owner.work_deadline))
+        stage_id = owner.create(stage_spec)
+        owner.references(stage_id)
+        stage_errors = diagnostics.attachment("stage")
+        attached = owner.attach("stage", stage_errors)
+        for name in (UTILITY_NAME, ENTRY_NAME):
+            body = legacy.read_regular(source / "scripts" / name, MAX_MODULE)
+            row = next(r for r in descriptor["authority"] if r["path"] == "scripts/" + name)
+            require(len(body) == row["bytes"] and sha(body) == row["sha256"], "capsule source changed")
+            legacy.write_bounded(attached.stdin, body, owner.work_deadline)
+        write_inputs(attached.stdin, source, executable, descriptor, owner.work_deadline, identities)
+        attached.stdin.close()
+        reader = Reader(attached.stdout, owner.work_deadline)
+        stage_result = reader.line()
+        require(encoded(stage_result) == encoded(stage_admission(descriptor)), "actual stage admission differs")
+        reader.exhausted()
+        owner.wait_attachment(attached, successful=True)
+        owner.retire_actor("stage")
+        owner.references()
+        recheck_inputs(source, executable, descriptor, identities, owner.work_deadline)
+        owner.volume("work")
+        execution_spec = owner.spec("execute", bootstrap_argv(source, descriptor, "execute-v1", owner.work_deadline),
+                                    str(source), socket.st_gid)
+        execution_id = owner.create(execution_spec)
+        owner.references(execution_id)
+        execution_errors = diagnostics.attachment("execute")
+        attached = owner.attach("execute", execution_errors)
+        reader = Reader(attached.stdout, owner.work_deadline)
+        response = checked_candidate_response(reader.line(), descriptor)
+        with deadline_scope(owner.work_deadline):
+            stdout, _stderr = receive_capture(reader, response, output, diagnostics)
+            legacy.checked_result(response["payload"]["result"])
+            legacy.checked_summary(stdout, descriptor["test_count"])
+            receipt = legacy.json.loads(legacy.read_regular(output / "capture-evidence.json", legacy.MAX_JSON))
+            legacy.checked_receipt(receipt, original_descriptor(descriptor), output)
+            recheck_inputs(source, executable, descriptor, identities, owner.work_deadline)
+            current = os.lstat(output)
+            require((current.st_dev, current.st_ino) == (held_output.st_dev, held_output.st_ino), "capture output owner changed")
+        owner.references(execution_id)
+        legacy.write_bounded(attached.stdin, encoded(retirement_control(descriptor)), owner.work_deadline)
+        attached.stdin.close()
+        reader.exhausted()
+        owner.wait_attachment(attached, successful=True)
+        completed = True
+    finally:
+        for signum in previous_signals:
+            signal.signal(signum, signal.SIG_IGN)
+        try:
+            retirement = owner.finish(completed)
+        finally:
+            try:
+                diagnostics.close_attachments()
+            finally:
+                for signum, handler in previous_signals.items():
+                    signal.signal(signum, handler)
+    # Read/forward every retained channel before publication. Final close only
+    # releases unbuffered handles on success; it cannot introduce a late sink
+    # wait or a late diagnostic-read deadline failure after an envelope exists.
+    diagnostics.forward(diagnostics.streams)
+    with deadline_scope(complete_deadline):
+        tick(complete_deadline)
+        # This is the only publication site, reached after all actual retirements.
+        envelope = {"schema": ENVELOPE_SCHEMA, "route": ROUTE, "complete_application_accepted": False,
+            "scope": "current exact-source conditional capture in immutable SDK; not installed-controller acceptance",
+            "descriptor": descriptor, "stage_admission": stage_result,
+            "inspection": {"role": "inspect", "never_started": True, "retired_before_stage": True,
+                           "anonymous_volumes_absent": True},
+            "stage_retired_before_execution": True, "execution_mounts": execution_spec["mounts"],
+            "readonly_views": response["readonly_views"], "sdk_tree": response["sdk_tree"],
+            "sdk_tree_sha256": response["sdk_tree_sha256"],
+            "candidate_matches_sdk_tree": encoded(descriptor["union"]) == encoded(response["sdk_tree"]),
+            "image_authority": response["image_authority"],
+            "candidate_utility_matches_image": descriptor["authority"][3]["sha256"] == observations["image_authority"][0]["sha256"],
+            "capture_receipt_sha256": sha(legacy.read_regular(output / "capture-evidence.json", legacy.MAX_JSON)),
+            "capture_records_sha256": digest(response["payload"]["records"]),
+            "result": response["payload"]["result"], "owner_token": owner.token, "retirement": retirement}
+        require(len(encoded(envelope)) <= legacy.MAX_JSON, "transport envelope JSON bound")
+        body = encoded(envelope)
+        records = response["payload"]["records"]
+        require(len(records) < 100000 and sum(r.get("bytes", 0) for r in records) + len(body) <= legacy.MAX_TREE,
+                "complete retained tree including envelope exceeds original bound")
+    publish_envelope(output, body, complete_deadline)
+
+    nonblocking_forward(("PASS complete candidate-source conditional capture and measured actor/volume retirement: "
+                         + str(output) + "\n").encode(), sys.stdout.buffer, complete_deadline)
+    return 0
+
+
+
+if __name__ == "__main__":
+    cli_deadline = time.monotonic() + legacy.DEADLINE_SECONDS
+    try:
+        if len(sys.argv) == 4 and sys.argv[1] == "parent":
+            parent(Path(sys.argv[2]), Path(sys.argv[3]))
+        else:
+            raise RuntimeError("closed candidate entry; stage/guest require authenticated bootstrap")
+    except Exception as error:
+        if not getattr(error, "candidate_diagnostics_reported", False):
+            diagnostics = Diagnostics(cli_deadline)
+            diagnostics.reconciled = True
+            try:
+                diagnostics.exception(error)
+            except Exception:
+                pass
+            finally:
+                try:
+                    diagnostics.close()
+                except Exception:
+                    pass
+        sys.exit(1)

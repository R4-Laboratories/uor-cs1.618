+    def test_real_fragmented_pipe_and_sender(self):
+        wire = self.root / "wire"
+        with wire.open("wb", buffering=0) as stream:
+            identities = candidate.input_identities(self.source, self.executable, self.descriptor, time.monotonic() + 5)
+            candidate.write_inputs(stream, self.source, self.executable, self.descriptor, time.monotonic() + 5, identities)
+        self.assertEqual(wire.read_bytes(), candidate.encoded(self.descriptor) + self.payload())
+        read_fd, write_fd = os.pipe()
+        errors = []
+        def send():
+            try:
+                with os.fdopen(write_fd, "wb", buffering=0) as stream:
+                    body = wire.read_bytes()
+                    widths = (1, 7, 31, 4093, 65536)
+                    index = step = 0
+                    while index < len(body):
+                        amount = widths[step % len(widths)]
+                        stream.write(body[index:index + amount])
+                        index += amount
+                        step += 1
+            except BaseException as error:
+                errors.append(error)
+        thread = threading.Thread(target=send)
+        thread.start()
+        with os.fdopen(read_fd, "rb", buffering=0) as stream:
+            deadline = time.monotonic() + 5
+            reader = candidate.Reader(stream, deadline)
+            descriptor = reader.line()
+            result = candidate.materialize_inputs(reader, self.destination, descriptor, deadline)
+        thread.join(timeout=5)
+        self.assertFalse(thread.is_alive())
+        self.assertEqual(errors, [])
+        self.assertTrue(result["input_eof_observed"])

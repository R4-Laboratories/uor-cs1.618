@@ -12,6 +12,8 @@
 rust_runtime_std = "4bb6ab6dc7e2fc1a587876290fac070f499170ff7609aee0fd924aa8fd7bcab7"
 semantic_ir = "15"
 semantic_snapshot = "2"
-proof_lowering = "3"
+proof_lowering = "4-constructive-nat-v1"

diff --git a/model/errors.toml b/model/errors.toml
--- a/model/errors.toml
+++ b/model/errors.toml
@@ -608,3 +608,10 @@
 exit = 1
 title = "Production artifact replay rejected"
 statement = "A production bundle does not replay: its result identity, a file digest, a binding between the result, the attestation, the preservation record, and its packages, a re-rendered package, a target descriptor, the producing compiler's semantics, or a recomputed certificate verdict disagrees with what the bundle states, or the bundle holds a file it does not state."
+
+[[error]]
+code = "LLB6008"
+class = "language"
+exit = 1
+title = "Constructive Nat diagnostic proof refused"
+statement = "A selected empty-policy language 1.2 linear_arithmetic theorem is outside the bounded additive Nat fragment, exhausts a constructive rule or resource bound, or has an invalid certificate or certificate-output binding. No alternate prover is invoked."

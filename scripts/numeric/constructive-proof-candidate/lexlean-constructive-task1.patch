diff --git a/language/constructive-nat-1.2/rules.toml b/language/constructive-nat-1.2/rules.toml
new file mode 100644
--- /dev/null
+++ b/language/constructive-nat-1.2/rules.toml
@@ -0,0 +1,31 @@
+spec = "lexlean/constructive-nat-rules/1"
+id = "constructive-nat-v1"
+diagnostic_only = true
+selection = "language 1.2, LinearArithmetic, empty declared axiom policy"
+unsupported = "LLB6008, no fallback"
+fragment = "Nat variables, canonical nonnegative literals and addition; ordered atomic <=, <, = premises; literal upper-bound or strict goal; no type parameters or definitions"
+certificate = "lexlean/constructive-nat-certificate/1"
+output = "proofs/constructive-nat.json"
+output_kind = "constructive-nat-certificate"
+framing = "original canonical JSON/1 plus LF; closed keys; Nat128 shortest unsigned decimal strings; other integers within i64"
+input_binding = "original source hash, module and theorem names, ordered typed binders, full original statement, project source and semantic IDs, actual compiler semantics/version"
+term_arena = "unique topologically ordered var/literal/add terms; explicit checked 32-entry nonnegative coefficient vector and Nat128 constant; no forward references; at most 16384 rows"
+normalization = "ascending binder-index right-associated repeated addition and one final constant including zero; explicit NormalizeEQ steps assoc, comm, zero-left, zero-right, literal-add, congr-add; ordinary Eq symmetry and transitivity"
+rules = ["Hyp", "ReflLE", "ReflEQ", "LiteralLE", "WeakenLT", "TransLE", "AddLE", "AddLTLE", "EqSymm", "EqTrans", "NormalizeEQ", "RewriteSide", "CancelLT"]
+checker = "recompute terms and every rule conclusion using strictly earlier checked premises; compare exact final original goal; never trust synthesizer conclusions or normalized vectors"
+recipe_a = "only T<=literal; bounded BFS once per variable; least terminal bound, then shortest path, then lexicographic hypothesis-index sequence; <= edges and weakened < edges; traverse original addition tree; literal reflexivity; final LiteralLE/TransLE"
+recipe_b = "strict hypotheses source order; scale 1..16 using repeated AddLTLE and weakened original; each scale direct first, then equality hypotheses source order, forward/reverse, left/right; at most one whole-side rewrite; remove maximal common coefficient vector and constant; CancelLT; first exact normalized goal match"
+emission = "only checked certificates; Init lemma applications and equality elimination; closed decidable LiteralLE via of_decide_eq_true/Eq.refl; no arbitrary theorem, Lean text, simp, omega, native_decide, classical or propext opcode"
+output_membership = "one deterministic row per selected theorem, no missing, duplicate or extra rows; independently decode/check the serialized DAG before emission and complete artifact before manifest publication"
+budget = "original project source/output limits and one cumulative <=300000ms stage deadline including checking and all selected modules/theorems; proof text, certificate serialization and complete artifact charged cumulatively"
+[limits]
+nat_parameters = 32
+atomic_hypotheses = 64
+input_term_nodes = 1024
+nat_bits = 128
+coefficient = 4096
+scale_factor = 16
+recipe_b_candidates = 8192
+certificate_nodes = 16384
+proof_text_bytes_per_theorem = 1048576
+canonical_leaves = 4096

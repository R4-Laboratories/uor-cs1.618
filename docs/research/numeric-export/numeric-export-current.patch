+    #[test]
+    fn float_model_intermediates_exceed_the_production_nat_width_ue_21() {
+        deep(|| {
+            let one64 = u128::from(1.0f64.to_bits());
+            let one32 = u128::from(1.0f32.to_bits());
+            for (format, op, args, expected, at_least) in [
+                (F64, "Mul", vec![one64, one64], one64, 105),
+                (
+                    F64,
+                    "Mul",
+                    vec![0x3fff_ffff_ffff_ffff; 2],
+                    0x400f_ffff_ffff_fffe,
+                    106,
+                ),
+                (F64, "Div", vec![one64, one64], one64, 160),
+                (F64, "Fma", vec![one64, one64, 0], one64, 105),
+                (F64, "Sqrt", vec![one64], one64, 163),
+                (F32, "Div", vec![one32, one32], one32, 73),
+                (F32, "Sqrt", vec![one32], one32, 76),

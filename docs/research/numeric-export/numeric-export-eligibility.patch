+#!/usr/bin/env bash
+# Run within the selected pinned SDK. Keeps a fresh, bounded probe for inspection.
+# This isolates floatMul's exact Nat multiplication, not the full IEEE closure.
+set -euo pipefail
+repo_dir="$(cd "$(dirname "$0")/.." && pwd)"
+fixture_dir="$repo_dir/crates/uorust/tests/fixtures/numeric-export"
+probe_dir="$(mktemp -d "${TMPDIR:-/tmp}/uorust-numeric-export.XXXXXX")"
+lexlean --version
+rustc --version
+lexlean init --name numeric-probe --module-prefix NumericProbe --language 1.2 "$probe_dir/project"
+cp "$fixture_dir/Main.lex.tex" "$probe_dir/project/src/Main.lex.tex"
+lexlean production targets --diagnostic-format json > "$probe_dir/targets.json"
+python3 - "$probe_dir" <<'PY'
+import json, pathlib, sys
+p = pathlib.Path(sys.argv[1])
+targets = json.loads((p / 'targets.json').read_text())
+digest = next(t['digest'] for t in targets['targets'] if t['id'] == 'rust-std')
+request = {'spec': 'lexlean/production-request/1', 'roots': [{
+    'package': {'name': 'numeric_significand_probe', 'version': '0.1.0'},
+    'root': 'NumericProbe.Main.significandProduct',
+    'targets': [{'digest': digest, 'id': 'rust-std'}]}]}
+(p / 'project/request.json').write_text(json.dumps(request) + '\n')
+PY
+lexlean --project "$probe_dir/project/lexlean.toml" fmt
+lexlean --project "$probe_dir/project/lexlean.toml" lock
+lexlean --project "$probe_dir/project/lexlean.toml" production build --request "$probe_dir/project/request.json"
+bundles=("$probe_dir/project/.lexlean/production/"*/result.json)
+test "${#bundles[@]}" -eq 1
+bundle_dir="$(dirname "${bundles[0]}")"
+lexlean production verify-artifact "$bundle_dir"
+generated_source="$bundle_dir/packages/rust-std/numeric_significand_probe/src/lib.rs"
+rustc --edition=2021 --crate-name numeric_significand_probe --crate-type rlib "$generated_source" -o "$probe_dir/libnumeric_significand_probe.rlib"
+rustc --edition=2021 "$fixture_dir/native.rs" --extern "numeric_significand_probe=$probe_dir/libnumeric_significand_probe.rlib" -o "$probe_dir/native"
+"$probe_dir/native"
+rustc --edition=2021 --crate-name numeric_significand_probe --crate-type rlib --target wasm32-unknown-unknown "$generated_source" -o "$probe_dir/libnumeric_significand_probe_wasm.rlib"
+rustc --edition=2021 --crate-type cdylib --target wasm32-unknown-unknown "$fixture_dir/wasm.rs" --extern "numeric_significand_probe=$probe_dir/libnumeric_significand_probe_wasm.rlib" -o "$probe_dir/probe.wasm"
+node "$fixture_dir/probe.mjs" "$probe_dir/probe.wasm"
+printf 'Retained numeric export probe: %s\n' "$probe_dir"

+def nonblocking_forward(body, target, deadline):
+    """Never wait on an inherited sink; retention belongs to Diagnostics."""
+    if time.monotonic() >= deadline:
+        return False
+    fd = target.fileno()
+    blocked = os.get_blocking(fd)
+    try:
+        os.set_blocking(fd, False)
+        with deadline_scope(deadline):
+            offset = 0
+            while offset < len(body):
+                try:
+                    count = os.write(fd, body[offset:offset + 4096])
+                except (BlockingIOError, BrokenPipeError):
+                    return False
+                require(count > 0, "diagnostic sink write failed")
+                offset += count
+        return True
+    except (OSError, RuntimeError):
+        return False
+    finally:
+        os.set_blocking(fd, blocked)
+
+
+class Diagnostics:
+    """Private fixed-channel spool; persistent on failure or sink backpressure.
+
+    Attachment writers retain their existing RLIMIT_FSIZE=1 MiB. Parent writes
+    never enter Python's inherited buffered streams or wait for pipe capacity.
+    Files live outside the capture tree and can never be capture admission.
+    """
+    CAPS = {"owner.stderr": legacy.MIB, "exception.stdout": 32 * legacy.MIB,
+            "exception.stderr": 32 * legacy.MIB, "stage.stderr": legacy.MIB, "execute.stderr": legacy.MIB,
+            "capture.stdout": 32 * legacy.MIB, "capture.stderr": 32 * legacy.MIB}
+
+    def __init__(self, deadline, token=None):
+        self.deadline, self.directory = deadline, None
+        self.token = token or legacy.uuid.uuid4().hex
+        require(re.fullmatch(r"[0-9a-f]{32}", self.token), "diagnostic owner token")
+        self.location = Path("/tmp") / ("prismpm-candidate-diagnostics-" + self.token)
+        self.reconciled = False
+        self.forwarded = set()
+        self.streams, self.lengths, self.attachments = {}, {}, set()
+        self.closed_attachments = set()
+        self.closed = False
+        self.directory_fd, self.directory_identity = None, None
+        self.file_identities = {}
+
+    @staticmethod
+    def ownership(info):
+        return (info.st_dev, info.st_ino, info.st_mode, info.st_uid, info.st_gid)
+
+    def bind_output(self, output):
+        require(self.directory is None, "diagnostic location already allocated")
+        info = os.lstat(output)
+        require(output.is_absolute() and output.resolve() == output and stat.S_ISDIR(info.st_mode)
+                and info.st_uid == os.getuid() and info.st_mode & 0o077 == 0,
+                "validated capture output required for diagnostic sibling")
+        self.location = output.with_name(output.name + ".candidate-diagnostics")
+        self.ensure()  # Allocate the locator manifest before any actor work.
+
+    def check_owner(self):
+        require(self.directory.resolve() == self.directory
+                and self.ownership(os.lstat(self.directory)) == self.directory_identity
+                and self.ownership(os.fstat(self.directory_fd)) == self.directory_identity,
+                "diagnostic directory ownership changed")
+
+    def open_owned(self, name):
+        require(name in self.CAPS or name == "manifest.json", "closed diagnostic filename")
+        self.check_owner()
+        fd = os.open(name, os.O_WRONLY | os.O_CREAT | os.O_EXCL | os.O_NOFOLLOW | os.O_CLOEXEC,
+                     0o600, dir_fd=self.directory_fd)
+        self.file_identities[name] = self.ownership(os.fstat(fd))
+        return os.fdopen(fd, "wb", buffering=0)
+
+    def manifest(self):
+        return {"schema": "prismpm/conditional-candidate-diagnostics/1", "owner_token": self.token,
+                "complete_application_accepted": False,
+                "channels": [{"path": name, "maximum_bytes": self.CAPS[name]} for name in sorted(self.CAPS)],
+                "aggregate_limits": {"capture": 64 * legacy.MIB, "exception": 32 * legacy.MIB}}
+
+    def locator(self):
+        return {"schema": "prismpm/conditional-candidate-diagnostics-locator/1", "owner_token": self.token,
+                "directory": str(self.location), "manifest": "manifest.json",
+                "manifest_sha256": digest(self.manifest()), "complete_application_accepted": False}
+
+    def ensure(self):
+        with deadline_scope(self.deadline):
+            if self.directory is None:
+                require(self.location.parent.resolve() == self.location.parent, "aliased diagnostic parent")
+                parent_fd = os.open(self.location.parent, os.O_RDONLY | os.O_DIRECTORY | os.O_NOFOLLOW | os.O_CLOEXEC)
+                try:
+                    os.mkdir(self.location.name, mode=0o700, dir_fd=parent_fd)
+                    self.directory_fd = os.open(self.location.name, os.O_RDONLY | os.O_DIRECTORY | os.O_NOFOLLOW
+                                                | os.O_CLOEXEC, dir_fd=parent_fd)
+                finally:
+                    os.close(parent_fd)
+                self.directory = self.location
+                info = os.fstat(self.directory_fd)
+                require(stat.S_IMODE(info.st_mode) == 0o700 and info.st_uid == os.getuid(), "private diagnostic owner")
+                self.directory_identity = self.ownership(info)
+                with self.open_owned("manifest.json") as stream:
+                    body = encoded(self.manifest())
+                    require(len(body) <= legacy.MIB and stream.write(body) == len(body), "bounded diagnostic manifest")
+            self.check_owner()
+            return self.directory
+
+    def stream(self, channel):
+        require(channel in self.CAPS and not self.closed, "closed diagnostic channel")
+        if channel not in self.streams:
+            self.ensure()
+            self.streams[channel] = self.open_owned(channel)
+            self.lengths[channel] = 0
+        return self.streams[channel]
+
+    def attachment(self, role):
+        require(role in ("stage", "execute"), "closed attachment diagnostic role")
+        channel = role + ".stderr"
+        with deadline_scope(self.deadline):
+            require(channel not in self.streams, "duplicate attachment diagnostic stream")
+            stream = self.stream(channel)
+            self.attachments.add(channel)
+            return stream
+
+    def record(self, channel, body):
+        require(channel in self.CAPS and isinstance(body, bytes), "closed diagnostic bytes")
+        if time.monotonic() >= self.deadline:
+            return False
+        with deadline_scope(self.deadline):
+            stream = self.stream(channel)
+            self.check_owner()
+            require(self.ownership(os.fstat(stream.fileno())) == self.file_identities[channel],
+                    "diagnostic file ownership changed")
+            require(channel not in self.attachments and self.lengths[channel] + len(body) <= self.CAPS[channel],
+                    "candidate diagnostic channel bound")
+            if channel.startswith(("capture.", "exception.")):
+                prefix = channel.split(".", 1)[0] + "."
+                combined = sum(size for name, size in self.lengths.items() if name.startswith(prefix)) + len(body)
+                require(combined <= (64 if prefix == "capture." else 32) * legacy.MIB,
+                        "combined original diagnostic stream bound")
+            offset = 0
+            while offset < len(body):
+                count = stream.write(body[offset:offset + legacy.MIB])
+                require(count is not None and count > 0, "diagnostic retention write failed")
+                self.lengths[channel] += count
+                offset += count
+        return True  # Sink forwarding is deferred until actor reconciliation.
+
+    def message(self, text):
+        body = (text + "\n").encode("utf-8", "backslashreplace")
+        remaining = self.CAPS["owner.stderr"] - self.lengths.get("owner.stderr", 0)
+        if len(body) > remaining:
+            body = body[:max(0, remaining - 32)] + b"\n[diagnostic message truncated]\n"[:remaining]
+            body = body[:remaining]
+        return self.record("owner.stderr", body)
+
+    def exception(self, error):
+        # Called only after the parent's actor reconciliation finalizer. Listing
+        # failure streams retain their original aggregate 1 MiB listing cap;
+        # bounded daemon control streams retain their original 32 MiB cap.
+        for name in ("stdout", "stderr"):
+            body = getattr(error, name, b"")
+            if body:
+                self.record("exception." + name, body)
+        self.message("candidate capture failed: " + str(error))
+
+    def forward(self, channels):
+        if not self.reconciled:
+            return
+        for channel in sorted(set(channels) - self.forwarded):
+            if time.monotonic() >= self.deadline:
+                break  # Actual bytes persist; never renew time or wait on sinks.
+            with deadline_scope(self.deadline):
+                self.check_owner()
+                require(self.ownership(os.lstat(self.directory / channel)) == self.file_identities[channel],
+                        "diagnostic file ownership changed")
+                body = legacy.read_regular(self.directory / channel, self.CAPS[channel])
+                self.check_owner()
+            target = sys.stdout.buffer if channel.endswith(".stdout") else sys.stderr.buffer
+            nonblocking_forward(body, target, self.deadline)
+            self.forwarded.add(channel)
+
+    def close_attachments(self):
+        pending = sorted(self.attachments - self.closed_attachments)
+        for channel in pending:
+            self.streams[channel].close()
+            self.closed_attachments.add(channel)
+        self.forward(pending)
+
+    def close(self):
+        if self.closed:
+            return
+        try:
+            try:
+                self.close_attachments()
+            finally:
+                for stream in self.streams.values():
+                    stream.close()
+                self.closed = True
+            self.forward(self.streams)
+        finally:
+            if self.directory_fd is not None:
+                os.close(self.directory_fd)
+                self.directory_fd = None
+

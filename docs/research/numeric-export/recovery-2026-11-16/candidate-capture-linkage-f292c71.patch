+
+// A separate fixed grammar/registry keeps historical capture records unchanged.
+// These records discover diagnostic work only; they never admit execution or success.
+const LINKAGE_WORK = /^prismpm-publication-linkage-[A-Za-z0-9_-]{6,64}$/;
+function linkageLocation(sourceRoot, work, create) {
+  directory(sourceRoot); directory(work, 0o700);
+  const name = basename(work); assert.match(name, LINKAGE_WORK); assert.equal(work, '/tmp/' + name);
+  const target = join(sourceRoot, 'target');
+  if (create && !lstatSync(target, {throwIfNoEntry:false})) mkdirSync(target, {mode:0o700});
+  directory(target);
+  const registry = join(target, 'conditional-publication-linkage-locators');
+  if (create && !lstatSync(registry, {throwIfNoEntry:false})) mkdirSync(registry, {mode:0o700});
+  directory(registry, 0o700);
+  const owner = regular(fileURLToPath(new URL('./compile.mjs', import.meta.url)), 1048576);
+  return {name, registry, path:join(registry, name + '.json'), ownerSha256:sha(owner.bytes)};
+}
+function validateLinkageLocator(value, sourceRoot, filename, ownerSha256) {
+  closed(value, 'schema complete accepted work_basename work_path source_root owner_module_sha256', 'private linkage locator');
+  assert.equal(value.schema, 'prismpm/private-publication-linkage-locator/1');
+  assert.equal(value.complete, false); assert.equal(value.accepted, false);
+  assert.match(value.work_basename, LINKAGE_WORK); assert.equal(filename, value.work_basename + '.json');
+  assert.equal(value.work_path, '/tmp/' + value.work_basename); assert.equal(value.source_root, sourceRoot);
+  assert.equal(value.owner_module_sha256, ownerSha256, 'actual linkage owner module');
+  directory(value.work_path, 0o700);
+}
+function linkageRegistry(location, sourceRoot, addedBytes = 0) {
+  let count = addedBytes ? 1 : 0, total = addedBytes; const entries = opendirSync(location.registry);
+  try {
+    for (let entry; (entry = entries.readSync()) !== null;) {
+      assert.ok(++count <= 256, 'linkage locator registry count bound');
+      assert.ok(entry.isFile() && entry.name.endsWith('.json') && LINKAGE_WORK.test(entry.name.slice(0, -5)), 'closed linkage locator registry member');
+      const held = regular(join(location.registry, entry.name), 4096);
+      assert.ok([0o400, 0o444].includes(held.stat.mode & 0o7777), 'immutable linkage locator record mode');
+      total += held.bytes.length; assert.ok(total <= 1048576, 'linkage locator registry byte bound');
+      validateLinkageLocator(JSON.parse(held.bytes), sourceRoot, entry.name, location.ownerSha256);
+    }
+  } finally {entries.closeSync();}
+  directory(location.registry, 0o700);
+}
+export function createLinkageLocator({sourceRoot, work}) {
+  const location = linkageLocation(sourceRoot, work, true), {name, path, ownerSha256} = location;
+  assert.equal(lstatSync(path, {throwIfNoEntry:false}), undefined, 'unoccupied per-work linkage locator required');
+  const value = {schema:'prismpm/private-publication-linkage-locator/1', complete:false, accepted:false,
+    work_basename:name, work_path:work, source_root:sourceRoot, owner_module_sha256:ownerSha256};
+  validateLinkageLocator(value, sourceRoot, name + '.json', ownerSha256);
+  const bytes = canonicalTransport(value); assert.ok(bytes.length <= 4096, 'bounded linkage locator');
+  linkageRegistry(location, sourceRoot, bytes.length); exclusive(path, bytes, 0o400);
+  const held = regular(path, 4096); assert.deepEqual(held.bytes, bytes);
+  validateLinkageLocator(JSON.parse(held.bytes), sourceRoot, name + '.json', ownerSha256); return path;
+}
+export function validateLinkageLocation({sourceRoot, work}) {
+  const location = linkageLocation(sourceRoot, work, false);
+  linkageRegistry(location, sourceRoot);
+  const held = regular(location.path, 4096);
+  assert.ok([0o400, 0o444].includes(held.stat.mode & 0o7777), 'immutable linkage locator record mode');
+  validateLinkageLocator(JSON.parse(held.bytes), sourceRoot, location.name + '.json', location.ownerSha256);
+}

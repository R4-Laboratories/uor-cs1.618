+use std::io::Write;
 use std::path::Path;
 
+// Reuse the unchanged bounded original-file guard in this conformance-only
+// capture. No production API or generated-library identity is changed.
+#[path = "../../../prismpm/src/sdk/executable_file.rs"]
+mod reader_input;
+
+struct HeldReaderInput {
+    selected: std::path::PathBuf,
+    file: reader_input::ExecutableFile,
+}
+impl HeldReaderInput {
+    fn capture(selected: std::path::PathBuf, limit: u64) -> (Self, Vec<u8>, String) {
+        let canonical = selected.canonicalize().expect("original reader input");
+        let mut file = reader_input::ExecutableFile::open(&canonical).unwrap();
+        assert!(
+            file.len() > 0 && file.len() <= limit,
+            "bounded original reader input"
+        );
+        let digest = file.sha256().unwrap();
+        let mut readback = reader_input::ExecutableFile::open(&canonical).unwrap();
+        let bytes = readback.read_exact_bytes(file.len() as usize).unwrap();
+        assert_eq!(content_id(&bytes), digest);
+        readback.verify_reference(&selected).unwrap();
+        file.verify_reference(&selected).unwrap();
+        (Self { selected, file }, bytes, digest)
+    }
+    fn verify(&self) {
+        self.file
+            .verify_reference(&self.selected)
+            .expect("original reader input custody");
+    }
+}
+
+struct ReaderAuthority {
+    held: Vec<HeldReaderInput>,
+    document: Value,
+}
+impl ReaderAuthority {
+    fn capture() -> Self {
+        if let Some(verified) = prismpm::sdk::verify_environment().unwrap() {
+            let fixed = Path::new("/opt/prismpm/share/inventory.json");
+            let path = if fixed.exists() || Path::new("/etc/profile.d/prismpm-sdk.sh").exists() {
+                fixed.to_owned()
+            } else {
+                std::env::var_os("PRISMPM_SDK_INVENTORY")
+                    .expect("verified SDK inventory path")
+                    .into()
+            };
+            let (held, bytes, digest) = HeldReaderInput::capture(path, 8 * 1024 * 1024);
+            assert_eq!(verified["inventory_sha256"], digest);
+            Self {
+                held: vec![held],
+                document: json!({"scope":"installed-sdk",
+                "binding":{"inventory_sha256":digest},"native_inventory":String::from_utf8(bytes).unwrap()}),
+            }
+        } else {
+            let launcher = prismpm::sdk::executable("lean").unwrap();
+            let actual = std::path::PathBuf::from(
+                std::env::var_os("ELAN_HOME").expect("explicit pinned ELAN_HOME"),
+            )
+            .join("toolchains/leanprover--lean4---v4.32.1/bin/lean");
+            let (launcher, _, launcher_sha256) =
+                HeldReaderInput::capture(launcher, 256 * 1024 * 1024);
+            // The same existing source-bootstrap elan pin as native preflight.
+            assert_eq!(
+                launcher_sha256,
+                "840179e70803ef373c2ec53342d6a45ea7d022533e4145489fc1278b4f716385"
+            );
+            let (actual, _, lean_sha256) = HeldReaderInput::capture(actual, 256 * 1024 * 1024);
+            assert_ne!(launcher_sha256, lean_sha256);
+            Self {
+                held: vec![launcher, actual],
+                document: json!({"scope":"source-bootstrap-only",
+                "toolchain":"leanprover/lean4:v4.32.1","launcher_sha256":launcher_sha256,"lean_sha256":lean_sha256}),
+            }
+        }
+    }
+    fn verify(&self) {
+        match prismpm::sdk::verify_environment().unwrap() {
+            Some(verified) => {
+                assert_eq!(self.document["scope"], "installed-sdk");
+                assert_eq!(
+                    verified["inventory_sha256"],
+                    self.document["binding"]["inventory_sha256"]
+                );
+            }
+            None => {
+                assert_eq!(self.document["scope"], "source-bootstrap-only");
+                assert_eq!(
+                    prismpm::sdk::executable("lean").unwrap(),
+                    self.held[0].selected
+                );
+                assert_eq!(
+                    std::path::PathBuf::from(
+                        std::env::var_os("ELAN_HOME").expect("original ELAN_HOME")
+                    )
+                    .join("toolchains/leanprover--lean4---v4.32.1/bin/lean"),
+                    self.held[1].selected
+                );
+            }
+        }
+        for held in &self.held {
+            held.verify();
+        }
+    }
+}

+    def retain_exception_streams(self, error):
+        # Retain at the observation site, before a cleanup wrapper can replace
+        # this error. Mark individual channels only after a complete write, so
+        # later parent handling neither duplicates bytes nor hides a short write.
+        retained = getattr(error, "candidate_retained_channels", {})
+        error.candidate_retained_channels = retained
+        try:
+            for name in ("stdout", "stderr"):

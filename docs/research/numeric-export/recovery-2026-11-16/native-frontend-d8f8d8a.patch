index 0000000000000000000000000000000000000000..d5421e7ce3e97885beda73b43b8d55999e75ee84
--- /dev/null
+++ b/scripts/library-frontend-reader.mjs
@@ -0,0 +1,65 @@
+// Native-library frontend profile reader. Runtime rows are regenerated from
+// LexLean's authoritative embedded runtime API and checked by the Rust gate.
+import assert from 'node:assert/strict';
+import {createHash} from 'node:crypto';
+import {readFileSync} from 'node:fs';
+const sha=bytes=>createHash('sha256').update(bytes).digest('hex');
+const same=(a,b)=>assert.deepEqual(a,b);
+const keys=(v,n)=>same(Object.keys(v).sort(),n.sort());
+const hex=s=>assert(typeof s==='string'&&/^[a-f0-9]{64}$/.test(s));
+const name=s=>typeof s==='string'&&/^[A-Za-z_][A-Za-z0-9_]*(?:\.[A-Za-z_][A-Za-z0-9_]*)*$/.test(s);
+const reserved=s=>['Init','Lean','Std','Lake','LexLeanRuntime'].some(p=>s===p||s.startsWith(p+'.'));
+const output='.lake/build/lib/lean';
+const builtins=['Init','Lean','Lean.Meta.Constructions.SparseCasesOn'];
+export const frontendArguments=module=>['-j2','-R','.','-o',`${output}/${module.replaceAll('.','/')}.olean`,'-i',`${output}/${module.replaceAll('.','/')}.ilean`,module.replaceAll('.','/')+'.lean'];
+const artifactPaths=module=>['olean','olean.private','olean.server','ilean','ir'].map(s=>`${output}/${module.replaceAll('.','/')}.${s}`);
+function imports(bytes){
+ const text=new TextDecoder('utf-8',{fatal:true}).decode(bytes),seen=new Set();let body=false;
+ for(let line of text.split('\n')){line=line.trim();if(!line||line==='module'||line.startsWith('--'))continue;
+  const match=line.match(/^(?:public )?import (?:all )?(.+)$/);
+  if(match){assert(!body&&name(match[1])&&!seen.has(match[1]),'closed generated import header');seen.add(match[1]);}else body=true;
+ }
+ assert(seen.has('Init'));return [...seen].sort();
+}
+export function validateFrontend(frontend,processes){
+ keys(frontend,['schema','profile','working_directory','launcher_sha256','lean_sha256','environment','modules']);
+ assert.equal(frontend.schema,'prismpm/library-frontend/1');assert.equal(frontend.profile,'lean-frontend-lcnf/1');assert.equal(frontend.working_directory,'$LIBRARY_WORK');
+ hex(frontend.launcher_sha256);hex(frontend.lean_sha256);same(frontend.environment,{LC_ALL:'C',LANG:'C',LEAN_PATH:output,LEAN_NUM_THREADS:'2'});
+ assert(Array.isArray(frontend.modules)&&frontend.modules.length>0);assert(processes.length>=frontend.modules.length+1);
+ assert.equal(processes[0].tool,'library-lean-version');same(processes[0].argv,['--version']);
+ assert.match(processes[0].stdout,/^Lean \(version 4\.32\.1, (?:x86_64|aarch64)-unknown-linux-gnu, commit f054605aea4b840552cca2e725580bffd1e1b704, Release\)\n$/);
+ assert.equal(processes[0].stderr,'');
+ const done=new Set(builtins),all=new Set();
+ for(const [index,module] of frontend.modules.entries()){
+  keys(module,['name','source','imports','runtime','artifacts']);assert(name(module.name));assert(!all.has(module.name));all.add(module.name);
+  assert.equal(module.runtime,module.name.startsWith('LexLeanRuntime.'));assert(module.runtime||!reserved(module.name));
+  const check=b=>{keys(b,['path','byte_length','sha256']);hex(b.sha256);assert(Number.isSafeInteger(b.byte_length)&&b.byte_length>0);};
+  check(module.source);assert.equal(module.source.path,module.name.replaceAll('.','/')+'.lean');
+  assert(Array.isArray(module.imports)&&module.imports.includes('Init'));same(module.imports,[...new Set(module.imports)].sort());
+  assert(module.imports.every(n=>done.has(n)));done.add(module.name);
+  same(module.artifacts.map(a=>a.path),artifactPaths(module.name));module.artifacts.forEach(check);
+  assert.equal(processes[index+1].tool,'library-lean-frontend');same(processes[index+1].argv,frontendArguments(module.name));
+ }
+ let pending=[...frontend.modules],seen=new Set(builtins);
+ for(const module of frontend.modules){const next=pending.filter(m=>m.imports.every(i=>seen.has(i))).sort((a,b)=>a.name<b.name?-1:1)[0];assert(next);assert.equal(next.name,module.name);seen.add(module.name);pending=pending.filter(m=>m.name!==module.name);}
+ const runtime=JSON.parse(readFileSync(new URL('../model/library-frontend-runtime.json',import.meta.url)));
+ const wanted=new Set(frontend.modules.filter(m=>!m.runtime).flatMap(m=>m.imports).filter(i=>i.startsWith('LexLeanRuntime.')));
+ for(let changed=true;changed;){changed=false;for(const n of [...wanted]){const m=runtime.find(r=>r.name===n);assert(m,'known pinned runtime');for(const dep of m.imports.filter(i=>!builtins.includes(i)))if(!wanted.has(dep)){wanted.add(dep);changed=true;}}}
+ same(frontend.modules.filter(m=>m.runtime).map(m=>m.name).sort(),[...wanted].sort());
+ for(const module of frontend.modules.filter(m=>m.runtime)){const expected=runtime.find(r=>r.name===module.name);same(module.source,expected.source);same(module.imports,expected.imports);}
+ for(const row of processes.slice(0,frontend.modules.length+1)){
+  keys(row,['tool','argv','executable_sha256','exit_code','stdout','stderr']);assert.equal(row.exit_code,0);assert.equal(row.executable_sha256,frontend.lean_sha256);
+ }
+ return frontend.modules.length+1;
+}
+export function bindFrontendSources(frontend,manifest,read){
+ const modules=frontend.modules.filter(m=>!m.runtime),rows=manifest.outputs.filter(r=>r.kind==='lean');
+ assert.equal(rows.length,modules.length);const seen=new Set();
+ for(const row of rows){assert.match(row.path,/^modules\/(?:[A-Za-z_][A-Za-z0-9_]*\/)*[A-Za-z_][A-Za-z0-9_]*\.lean$/);assert(!seen.has(row.path));seen.add(row.path);
+  const local=row.path.slice(8),module=modules.find(m=>m.source.path===local);assert(module,'complete manifest module closure');
+  const bytes=read(row.path);assert.equal(bytes.length,row.byte_length);assert.equal(sha(bytes),row.sha256);
+  same(module.source,{path:local,byte_length:bytes.length,sha256:sha(bytes)});same(module.imports,imports(bytes));
+ }
+}
+
+export function frontendSourcePlan(frontend){return {schema:'prismpm/library-frontend-plan/1',profile:frontend.profile,working_directory:frontend.working_directory,environment:frontend.environment,modules:frontend.modules.map(({name,source,imports,runtime})=>({name,source,imports,runtime}))};}

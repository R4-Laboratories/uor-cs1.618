@@ -0,0 +1,1001 @@
+//! Native-library-only normal Lean frontend/LCNF profile. No C backend is requested.
+use crate::library_build::{regular_bytes, sha256, write};
+use crate::verification::{executable, run_process_closed_limited, ProcessRecord};
+use crate::PrismError;
+use serde::{Deserialize, Serialize};
+use serde_json::{json, Value};
+use std::collections::{BTreeMap, BTreeSet};
+use std::path::{Path, PathBuf};
+use std::time::{Duration, Instant};
+
+pub(crate) const PROFILE: &str = "lean-frontend-lcnf/1";
+const BUILTINS: [&str; 3] = ["Init", "Lean", "Lean.Meta.Constructions.SparseCasesOn"];
+const OUTPUT: &str = ".lake/build/lib/lean";
+const SUFFIXES: [&str; 5] = ["olean", "olean.private", "olean.server", "ilean", "ir"];
+fn fail(message: impl Into<String>) -> PrismError {
+    PrismError::new("PP5008", message)
+}
+fn name_valid(name: &str) -> bool {
+    !name.is_empty()
+        && name.split('.').all(|part| {
+            !part.is_empty()
+                && (part.as_bytes()[0].is_ascii_alphabetic() || part.starts_with('_'))
+                && part.bytes().all(|b| b.is_ascii_alphanumeric() || b == b'_')
+        })
+}
+fn reserved(name: &str) -> bool {
+    ["Init", "Lean", "Std", "Lake", "LexLeanRuntime"]
+        .iter()
+        .any(|prefix| name == *prefix || name.starts_with(&format!("{prefix}.")))
+}
+/// This parses only LexLean's generated, one-import-per-line header, never
+/// arbitrary Lean syntax. Reject unsupported headers rather than guessing.
+fn imports(bytes: &[u8]) -> Result<Vec<String>, PrismError> {
+    let text = std::str::from_utf8(bytes).map_err(|_| fail("generated Lean is not UTF-8"))?;
+    let mut result = BTreeSet::new();
+    let mut body = false;
+    for line in text.lines() {
+        let line = line.trim();
+        if line.is_empty() || line == "module" || line.starts_with("--") {
+            continue;
+        }
+        if let Some(name) = line
+            .strip_prefix("public import ")
+            .or_else(|| line.strip_prefix("import "))
+        {
+            let name = name.strip_prefix("all ").unwrap_or(name);
+            if body || !name_valid(name) || !result.insert(name.to_owned()) {
+                return Err(fail(
+                    "generated Lean import header is malformed or duplicated",
+                ));
+            }
+        } else {
+            body = true;
+        }
+    }
+    if !result.contains("Init") {
+        return Err(fail("generated Lean must explicitly import Init"));
+    }
+    Ok(result.into_iter().collect())
+}
+#[derive(Clone, Debug, PartialEq, Eq, Serialize, Deserialize)]
+#[serde(deny_unknown_fields)]
+pub(crate) struct Binding {
+    pub path: String,
+    pub byte_length: u64,
+    pub sha256: String,
+}
+fn binding(root: &Path, path: &str) -> Result<Binding, PrismError> {
+    let bytes = regular_bytes(root, path)?;
+    Ok(Binding {
+        path: path.to_owned(),
+        byte_length: bytes.len() as u64,
+        sha256: sha256(&bytes),
+    })
+}
+#[derive(Clone, Debug, PartialEq, Eq, Serialize, Deserialize)]
+#[serde(deny_unknown_fields)]
+pub(crate) struct Module {
+    pub name: String,
+    pub source: Binding,
+    pub imports: Vec<String>,
+    pub runtime: bool,
+    pub artifacts: Vec<Binding>,
+}
+#[derive(Clone, Debug, PartialEq, Eq, Serialize, Deserialize)]
+#[serde(deny_unknown_fields)]
+pub(crate) struct Receipt {
+    pub schema: String,
+    pub profile: String,
+    pub working_directory: String,
+    pub launcher_sha256: String,
+    pub lean_sha256: String,
+    pub environment: BTreeMap<String, String>,
+    pub modules: Vec<Module>,
+}
+impl Receipt {
+    /// Platform-independent source plan; execution identities and compiled
+    /// artifact hashes belong only to the two verification owner phases.
+    pub(crate) fn source_plan(&self) -> Value {
+        json!({"schema":"prismpm/library-frontend-plan/1", "profile":self.profile,
+            "working_directory":self.working_directory,"environment":self.environment,
+            "modules":self.modules.iter().map(|m|json!({"name":m.name,"source":m.source,
+                "imports":m.imports,"runtime":m.runtime})).collect::<Vec<_>>()})
+    }
+}
+fn environment() -> BTreeMap<String, String> {
+    BTreeMap::from([
+        ("LC_ALL".into(), "C".into()),
+        ("LANG".into(), "C".into()),
+        ("LEAN_PATH".into(), OUTPUT.into()),
+        ("LEAN_NUM_THREADS".into(), "2".into()),
+    ])
+}
+pub(crate) fn arguments(module: &str) -> Vec<String> {
+    let path = module.replace('.', "/");
+    [
+        "-j2".into(),
+        "-R".into(),
+        ".".into(),
+        "-o".into(),
+        format!("{OUTPUT}/{path}.olean"),
+        "-i".into(),
+        format!("{OUTPUT}/{path}.ilean"),
+        format!("{path}.lean"),
+    ]
+    .into()
+}
+fn artifact_paths(name: &str) -> Vec<String> {
+    SUFFIXES
+        .iter()
+        .map(|suffix| format!("{OUTPUT}/{}.{suffix}", name.replace('.', "/")))
+        .collect()
+}
+/// Reconstruct the complete source closure from original manifest bytes and
+/// independently read generated sources. Runtime bytes come from LexLean itself.
+pub(crate) fn plan(
+    manifest: &[u8],
+    mut read: impl FnMut(&str) -> Result<Vec<u8>, PrismError>,
+) -> Result<Vec<(Module, Vec<u8>)>, PrismError> {
+    let manifest: Value = serde_json::from_slice(manifest).map_err(|e| fail(e.to_string()))?;
+    let outputs = manifest["outputs"]
+        .as_array()
+        .ok_or_else(|| fail("generated output manifest absent"))?;
+    let mut all = BTreeMap::new();
+    for output in outputs.iter().filter(|row| row["kind"] == "lean") {
+        let original = output["path"]
+            .as_str()
+            .ok_or_else(|| fail("generated path absent"))?;
+        let local = original
+            .strip_prefix("modules/")
+            .and_then(|p| p.strip_suffix(".lean"))
+            .ok_or_else(|| fail("generated module path differs"))?;
+        let name = local.replace('/', ".");
+        if !name_valid(&name) || local != name.replace('.', "/") || reserved(&name) {
+            return Err(fail("generated module path or reserved name differs"));
+        }
+        let bytes = read(original)?;
+        if output["sha256"] != sha256(&bytes) || output["byte_length"] != bytes.len() as u64 {
+            return Err(fail("generated source differs from manifest"));
+        }
+        let module = Module {
+            name: name.clone(),
+            source: Binding {
+                path: format!("{local}.lean"),
+                byte_length: bytes.len() as u64,
+                sha256: sha256(&bytes),
+            },
+            imports: imports(&bytes)?,
+            runtime: false,
+            artifacts: vec![],
+        };
+        if all.insert(name, (module, bytes)).is_some() {
+            return Err(fail("duplicate generated module"));
+        }
+    }
+    if all.is_empty() {
+        return Err(fail("empty generated source closure"));
+    }
+    let runtime = lexlean::backend::runtime::imported_by(
+        all.values()
+            .map(|(_, bytes)| std::str::from_utf8(bytes).expect("validated UTF-8")),
+    )
+    .map_err(|e| fail(e.message))?;
+    for runtime in runtime {
+        let bytes = runtime.text.as_bytes().to_vec();
+        let parsed = imports(&bytes)?;
+        let expected: BTreeSet<_> = runtime
+            .imports
+            .iter()
+            .cloned()
+            .chain(["Init".into()])
+            .collect();
+        if parsed
+            .iter()
+            .filter(|n| !BUILTINS.contains(&n.as_str()) || *n == "Init")
+            .cloned()
+            .collect::<BTreeSet<_>>()
+            != expected
+        {
+            return Err(fail("runtime import metadata differs"));
+        }
+        all.insert(
+            runtime.name.clone(),
+            (
+                Module {
+                    name: runtime.name.clone(),
+                    source: Binding {
+                        path: format!("{}.lean", runtime.name.replace('.', "/")),
+                        byte_length: bytes.len() as u64,
+                        sha256: sha256(&bytes),
+                    },
+                    imports: parsed,
+                    runtime: true,
+                    artifacts: vec![],
+                },
+                bytes,
+            ),
+        );
+    }
+    for (module, _) in all.values() {
+        if module
+            .imports
+            .iter()
+            .any(|name| !BUILTINS.contains(&name.as_str()) && !all.contains_key(name))
+        {
+            return Err(fail(
+                "generated import is outside the complete source closure",
+            ));
+        }
+    }
+    let mut ordered = Vec::new();
+    let mut done = BTreeSet::from(BUILTINS.map(str::to_owned));
+    while !all.is_empty() {
+        let next = all
+            .iter()
+            .find(|(_, (m, _))| m.imports.iter().all(|name| done.contains(name)))
+            .map(|(name, _)| name.clone())
+            .ok_or_else(|| fail("generated import cycle"))?;
+        done.insert(next.clone());
+        ordered.push(all.remove(&next).expect("selected member"));
+    }
+    Ok(ordered)
+}
+
+pub(crate) struct Frontend {
+    workspace: PathBuf,
+    lean: PathBuf,
+    receipt: Receipt,
+    next: usize,
+    deadline: Instant,
+    remaining_output: (usize, usize),
+}
+impl Frontend {
+    pub(crate) fn new(workspace: &Path, manifest: &[u8]) -> Result<Self, PrismError> {
+        if workspace.canonicalize().ok().as_deref() != Some(workspace) || [".lake", "export", "package"].iter().any(|p| !matches!(std::fs::symlink_metadata(workspace.join(p)), Err(e) if e.kind()==std::io::ErrorKind::NotFound)) {
+            return Err(fail("fresh independent frontend workspace required"));
+        }
+        let sources = plan(manifest, |path| {
+            regular_bytes(
+                workspace,
+                path.strip_prefix("modules/").expect("validated prefix"),
+            )
+        })?;
+        for (module, bytes) in &sources {
+            if module.runtime {
+                if workspace.join(&module.source.path).exists() {
+                    return Err(fail("runtime source shadowed"));
+                }
+                write(&workspace.join(&module.source.path), bytes)?;
+            }
+        }
+        let launcher = executable("lean")?;
+        let launcher_sha256 = sha256(&std::fs::read(&launcher).map_err(|e| fail(e.to_string()))?);
+        // Source bootstrap uses the already pinned elan proxy. Select only its
+        // fixed released toolchain; never the ambient default or a local override.
+        let lean = if crate::sdk::inventory_path().is_none() {
+            PathBuf::from(
+                std::env::var_os("ELAN_HOME")
+                    .ok_or_else(|| fail("explicit pinned ELAN_HOME required"))?,
+            )
+            .join("toolchains/leanprover--lean4---v4.32.1/bin/lean")
+        } else {
+            launcher
+        };
+        let lean = lean.canonicalize().map_err(|e| fail(e.to_string()))?;
+        let lean_sha256 = sha256(&std::fs::read(&lean).map_err(|e| fail(e.to_string()))?);
+        Ok(Self {
+            workspace: workspace.into(),
+            lean,
+            receipt: Receipt {
+                schema: "prismpm/library-frontend/1".into(),
+                profile: PROFILE.into(),
+                working_directory: "$LIBRARY_WORK".into(),
+                launcher_sha256,
+                lean_sha256,
+                environment: environment(),
+                modules: sources.into_iter().map(|(m, _)| m).collect(),
+            },
+            next: 0,
+            // The replaced modeled-library run_process had one 300 s budget.
+            deadline: Instant::now() + Duration::from_secs(300),
+            remaining_output: (16_777_216, 16_777_216),
+        })
+    }
+    pub(crate) fn count(&self) -> usize {
+        self.receipt.modules.len() + 1
+    }
+    pub(crate) fn complete(&self) -> Result<Receipt, PrismError> {
+        if self.next != self.count() {
+            return Err(fail("incomplete native frontend sequence"));
+        }
+        self.check_sources_and_outputs()?;
+        Ok(self.receipt.clone())
+    }
+    fn check_sources_and_outputs(&self) -> Result<(), PrismError> {
+        for module in &self.receipt.modules {
+            if binding(&self.workspace, &module.source.path)? != module.source {
+                return Err(fail("frontend source changed"));
+            }
+            for artifact in &module.artifacts {
+                if binding(&self.workspace, &artifact.path)? != *artifact {
+                    return Err(fail("frontend artifact changed"));
+                }
+            }
+        }
+        if sha256(&std::fs::read(&self.lean).map_err(|e| fail(e.to_string()))?)
+            != self.receipt.lean_sha256
+        {
+            return Err(fail("actual Lean binary changed"));
+        }
+        Ok(())
+    }
+    pub(crate) fn run(
+        &mut self,
+        replacements: &[(&Path, &str)],
+    ) -> Result<ProcessRecord, PrismError> {
+        if self.next >= self.count() {
+            return Err(fail("frontend sequence reused"));
+        }
+        self.check_sources_and_outputs()?;
+        let (tool, args) = if self.next == 0 {
+            ("library-lean-version", vec!["--version".into()])
+        } else {
+            let module = &self.receipt.modules[self.next - 1];
+            for path in artifact_paths(&module.name) {
+                if !matches!(std::fs::symlink_metadata(self.workspace.join(&path)), Err(e) if e.kind()==std::io::ErrorKind::NotFound)
+                {
+                    return Err(fail("stale frontend output"));
+                }
+            }
+            let output = self
+                .workspace
+                .join(format!("{OUTPUT}/{}", module.name.replace('.', "/")));
+            std::fs::create_dir_all(output.parent().expect("module parent"))
+                .map_err(|e| fail(e.to_string()))?;
+            ("library-lean-frontend", arguments(&module.name))
+        };
+        let remaining = self
+            .deadline
+            .checked_duration_since(Instant::now())
+            .filter(|d| d.as_micros() > 0)
+            .ok_or_else(|| PrismError::new("PP5007", "native frontend total deadline exhausted"))?;
+        let result = run_process_closed_limited(
+            tool,
+            &self.lean,
+            &args,
+            &self.workspace,
+            &self.receipt.environment,
+            replacements,
+            "PP5004",
+            &format!(
+                "{}.{:06}",
+                remaining.as_micros() / 1_000_000,
+                remaining.as_micros() % 1_000_000
+            ),
+            self.remaining_output.0.max(self.remaining_output.1),
+        );
+        // A failed child is not an exemption from original tool/source custody.
+        let checked = self.check_sources_and_outputs();
+        let record = match (result, checked) {
+            (Err(mut original), Err(custody)) => {
+                original.message.push_str(&format!(
+                    "; frontend custody also failed: {}",
+                    custody.message
+                ));
+                return Err(original);
+            }
+            (Err(original), _) => return Err(original),
+            (Ok(_), Err(custody)) => return Err(custody),
+            (Ok(record), Ok(())) => record,
+        };
+        self.remaining_output = (
+            self.remaining_output
+                .0
+                .checked_sub(record.stdout.len())
+                .ok_or_else(|| {
+                    PrismError::new("PP5007", "native frontend total stdout limit exceeded")
+                })?,
+            self.remaining_output
+                .1
+                .checked_sub(record.stderr.len())
+                .ok_or_else(|| {
+                    PrismError::new("PP5007", "native frontend total stderr limit exceeded")
+                })?,
+        );
+        if self.next == 0 {
+            let host = match std::env::consts::ARCH {
+                "x86_64" => "x86_64",
+                "aarch64" => "aarch64",
+                _ => return Err(fail("unsupported Lean host")),
+            };
+            if record.stdout != format!("Lean (version 4.32.1, {host}-unknown-linux-gnu, commit f054605aea4b840552cca2e725580bffd1e1b704, Release)\n") || !record.stderr.is_empty() { return Err(fail("actual Lean version differs")); }
+        } else {
+            let module = &mut self.receipt.modules[self.next - 1];
+            module.artifacts = artifact_paths(&module.name)
+                .iter()
+                .map(|p| binding(&self.workspace, p))
+                .collect::<Result<_, _>>()?;
+            if module.artifacts.iter().any(|a| a.byte_length == 0) {
+                return Err(fail("empty frontend artifact"));
+            }
+        }
+        self.next += 1;
+        self.check_sources_and_outputs()?;
+        if Instant::now() >= self.deadline {
+            return Err(PrismError::new(
+                "PP5007",
+                "native frontend total deadline exhausted",
+            ));
+        }
+        Ok(record)
+    }
+}

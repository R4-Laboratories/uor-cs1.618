--- /dev/null
+++ b/scripts/library-frontend-component-replay.mjs
@@ -0,0 +1,38 @@
+// Read-only replay of actual component captures. This is not SDK acceptance.
+import assert from 'node:assert/strict';
+import {createHash} from 'node:crypto';
+import {readFileSync,readdirSync} from 'node:fs';
+import {join,relative} from 'node:path';
+import {validateFrontend,bindFrontendSources} from './library-frontend-reader.mjs';
+const [evidence,source]=process.argv.slice(2);assert(evidence&&source);
+const hash=b=>createHash('sha256').update(b).digest('hex');
+const frontend=JSON.parse(readFileSync(join(evidence,'frontend.json')));
+const processes=JSON.parse(readFileSync(join(evidence,'processes.json')));
+const independent=JSON.parse(readFileSync(join(evidence,'independent-frontend-processes.json')));
+const files=[];
+function walk(root){for(const e of readdirSync(root,{withFileTypes:true})){const path=join(root,e.name);if(e.isDirectory())walk(path);else if(e.isFile()&&e.name.endsWith('.lean'))files.push(path);else assert(false,'regular generated source closure');}}
+walk(join(source,'BoundedNumeric'));files.sort();assert.equal(files.length,5);
+const manifest={outputs:files.map(path=>{const b=readFileSync(path);return {kind:'lean',path:'modules/'+relative(source,path),byte_length:b.length,sha256:hash(b)};})};
+const read=path=>readFileSync(join(source,path.slice(8)));
+function check(receipt,rows){const n=validateFrontend(receipt,rows);bindFrontendSources(receipt,manifest,read);return n;}
+const n=check(frontend,processes);assert.equal(n,9);check(frontend,independent);
+assert.equal(processes.filter(p=>p.tool==='component-leanchecker'&&p.exit_code===0).length,8);
+for(const name of ['Bounds','Float','Foundation.Library.V1.Model','NumericPackage','Wide'])assert(frontend.modules.some(m=>m.name==='BoundedNumeric.'+name));
+for(const name of ['kernel.ir','coverage.json','roots.json'])assert(readFileSync(join(evidence,'export',name)).equals(readFileSync(join(evidence,'export-replay',name))));
+const mutations=[
+ (f,p)=>{f.profile='lake/legacy';},(f,p)=>{f.schema='prismpm/library-frontend/0';},
+ (f,p)=>{f.environment.LEAN_PATH='/tmp/cache';},(f,p)=>{f.environment.HOME='/tmp/ambient';},
+ (f,p)=>{f.working_directory='/tmp/reuse';},(f,p)=>{f.lean_sha256='f'.repeat(64);},
+ (f,p)=>{p[1].executable_sha256='f'.repeat(64);},(f,p)=>{p[1].argv.push('-c','forbidden.c');},
+ (f,p)=>{p[1].argv.push('-Dcompiler.postponeCompile=true');},(f,p)=>{p[1].exit_code=1;},
+ (f,p)=>{f.modules[0].artifacts.pop();},(f,p)=>{f.modules[0].artifacts[0].path='../stale.olean';},
+ (f,p)=>{f.modules[0].source.sha256='f'.repeat(64);},
+ (f,p)=>{f.modules.find(m=>m.name==='BoundedNumeric.Bounds').source.sha256='f'.repeat(64);},
+ (f,p)=>{const i=f.modules.findIndex(m=>m.name==='BoundedNumeric.Bounds');f.modules.splice(i,1);p.splice(i+1,1);},
+ (f,p)=>{const i=f.modules.findIndex(m=>m.name==='LexLeanRuntime.Laws');f.modules.splice(i,1);p.splice(i+1,1);},
+ (f,p)=>{[f.modules[0],f.modules[1]]=[f.modules[1],f.modules[0]];[p[1],p[2]]=[p[2],p[1]];},
+ (f,p)=>{f.modules.push(structuredClone(f.modules[0]));p.splice(n,0,structuredClone(p[1]));},
+];
+for(const mutate of mutations){const f=structuredClone(frontend),p=structuredClone(processes);mutate(f,p);assert.throws(()=>check(f,p));}
+check(frontend,processes);check(frontend,independent);
+console.log(JSON.stringify({scope:'actual-component-reader-only',profile:frontend.profile,modules:8,kernel_checks:8,independent_exports:'byte-identical',mutations_rejected:mutations.length,sdk_qualification:'pending'}));

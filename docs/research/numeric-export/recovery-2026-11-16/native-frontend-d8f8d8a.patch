+/// Closed reader contract. Binding to original project and runtime bytes is a
+/// separate mandatory step in validate_source_binding, never inferred from exits.
+pub(crate) fn validate_receipt(value: &Value, processes: &[Value]) -> Result<Receipt, PrismError> {
+    let receipt: Receipt =
+        serde_json::from_value(value.clone()).map_err(|e| fail(e.to_string()))?;
+    let hash = |s: &str| {
+        s.len() == 64
+            && s.bytes()
+                .all(|b| b.is_ascii_digit() || (b'a'..=b'f').contains(&b))
+    };
+    if receipt.schema != "prismpm/library-frontend/1"
+        || receipt.profile != PROFILE
+        || receipt.working_directory != "$LIBRARY_WORK"
+        || receipt.environment != environment()
+        || receipt.modules.is_empty()
+        || !hash(&receipt.lean_sha256)
+        || !hash(&receipt.launcher_sha256)
+        || processes.len() < receipt.modules.len() + 1
+    {
+        return Err(fail("frontend profile or closure differs"));
+    }
+    if processes[0]["tool"] != "library-lean-version"
+        || processes[0]["argv"] != json!(["--version"])
+    {
+        return Err(fail("actual Lean identity command absent"));
+    }
+    let versions = ["x86_64", "aarch64"].map(|host|format!("Lean (version 4.32.1, {host}-unknown-linux-gnu, commit f054605aea4b840552cca2e725580bffd1e1b704, Release)\n"));
+    if !versions.iter().any(|v| processes[0]["stdout"] == *v) || processes[0]["stderr"] != "" {
+        return Err(fail("actual Lean version differs"));
+    }
+    let mut done = BTreeSet::from(BUILTINS.map(str::to_owned));
+    for (index, module) in receipt.modules.iter().enumerate() {
+        if !name_valid(&module.name)
+            || module.runtime != module.name.starts_with("LexLeanRuntime.")
+            || (!module.runtime && reserved(&module.name))
+            || module.source.path != format!("{}.lean", module.name.replace('.', "/"))
+            || !hash(&module.source.sha256)
+            || module.source.byte_length == 0
+            || !module.imports.contains(&"Init".into())
+            || module.imports.windows(2).any(|w| w[0] >= w[1])
+            || module.imports.iter().any(|name| !done.contains(name))
+            || !done.insert(module.name.clone())
+        {
+            return Err(fail("frontend source or import order differs"));
+        }
+        if module
+            .artifacts
+            .iter()
+            .map(|b| b.path.clone())
+            .collect::<Vec<_>>()
+            != artifact_paths(&module.name)
+            || module
+                .artifacts
+                .iter()
+                .any(|b| b.byte_length == 0 || !hash(&b.sha256))
+        {
+            return Err(fail("complete frontend companion artifacts required"));
+        }
+        let row = &processes[index + 1];
+        if row["tool"] != "library-lean-frontend" || row["argv"] != json!(arguments(&module.name)) {
+            return Err(fail("frontend command order or arguments differ"));
+        }
+    }
+    // Runtime metadata and bytes are owned by the pinned LexLean package, not
+    // by a receipt's successful exits or a caller-supplied runtime module list.
+    let headers = receipt
+        .modules
+        .iter()
+        .filter(|m| !m.runtime)
+        .map(|m| {
+            m.imports
+                .iter()
+                .map(|i| format!("public import {i}\n"))
+                .collect::<String>()
+        })
+        .collect::<Vec<_>>();
+    let runtime = lexlean::backend::runtime::imported_by(headers.iter().map(String::as_str))
+        .map_err(|e| fail(e.message))?;
+    let actual_runtime = receipt
+        .modules
+        .iter()
+        .filter(|m| m.runtime)
+        .collect::<Vec<_>>();
+    if actual_runtime.len() != runtime.len()
+        || runtime.iter().any(|expected| {
+            actual_runtime
+                .iter()
+                .find(|m| m.name == expected.name)
+                .is_none_or(|actual| {
+                    actual.source.sha256 != sha256(expected.text.as_bytes())
+                        || actual.source.byte_length != expected.text.len() as u64
+                        || imports(expected.text.as_bytes()).ok().as_ref() != Some(&actual.imports)
+                })
+        })
+    {
+        return Err(fail("complete pinned runtime closure differs"));
+    }
+    let mut pending = receipt.modules.iter().collect::<Vec<_>>();
+    let mut seen = BTreeSet::from(BUILTINS.map(str::to_owned));
+    for actual in &receipt.modules {
+        let selected = pending
+            .iter()
+            .filter(|m| m.imports.iter().all(|i| seen.contains(i)))
+            .min_by_key(|m| &m.name)
+            .ok_or_else(|| fail("frontend import cycle"))?;
+        if selected.name != actual.name {
+            return Err(fail("frontend dependency order is not canonical"));
+        }
+        seen.insert(actual.name.clone());
+        pending.retain(|m| m.name != actual.name);
+    }
+    for row in &processes[..receipt.modules.len() + 1] {
+        if row["executable_sha256"] != receipt.lean_sha256 || row["exit_code"] != 0 {
+            return Err(fail("actual Lean identity or exit differs"));
+        }
+    }
+    Ok(receipt)
+}
+pub(crate) fn validate_source_binding(
+    receipt: &Receipt,
+    manifest: &[u8],
+    read: impl FnMut(&str) -> Result<Vec<u8>, PrismError>,
+) -> Result<(), PrismError> {
+    let expected = plan(manifest, read)?;
+    let actual = receipt
+        .modules
+        .iter()
+        .cloned()
+        .map(|mut m| {
+            m.artifacts.clear();
+            m
+        })
+        .collect::<Vec<_>>();
+    if actual != expected.into_iter().map(|(m, _)| m).collect::<Vec<_>>() {
+        return Err(fail(
+            "frontend differs from complete original source/import closure",
+        ));
+    }
+    Ok(())
+}

+                    &[module.name.clone()],
+                    work.path(),
+                    &checker_env,
+                    &[],
+                    "PP5003",
+                    "300",
+                    16_777_216,
+                )
+                .unwrap(),
+            );
+        }
+        let exporter =
+            PathBuf::from(std::env::var_os("NEXP012_EXPORTER").expect("pinned exporter"));
+        let mut args = Vec::new();
+        for (name, _) in &sources {
+            args.extend(["--module".into(), name.clone()]);
+        }
+        for root in [
+            "BoundedNumeric.Float.mul32",
+            "BoundedNumeric.NumericPackage.acceptance",
+        ] {
+            args.extend(["--root".into(), root.into()]);
+        }
+        args.extend([
+            "--ir-module".into(),
+            "cs_numeric_mul32".into(),
+            "--out".into(),
+            output.join("export").to_string_lossy().into_owned(),
+        ]);
+        let exporter_lib = exporter
+            .parent()
+            .unwrap()
+            .parent()
+            .unwrap()
+            .join("lib/lean");
+        let mut env = checker_env;
+        env.insert(
+            "LEAN_PATH".into(),
+            format!(
+                "{}:{}",
+                work.path().join(OUTPUT).display(),
+                exporter_lib.display()
+            ),
+        );
+        processes.push(
+            run_process_limited(
+                "component-full-module-export",
+                &exporter,
+                &args,
+                work.path(),
+                &env,
+                &[],
+                "PP5004",
+                "300",
+                16_777_216,
+            )
+            .unwrap(),
+        );
+        let mut replay_args = args.clone();
+        *replay_args.last_mut().unwrap() =
+            output.join("export-replay").to_string_lossy().into_owned();
+        let mut replay_env = env.clone();
+        replay_env.insert(
+            "LEAN_PATH".into(),
+            format!(
+                "{}:{}",
+                second.path().join(OUTPUT).display(),
+                exporter_lib.display()
+            ),
+        );
+        independent_processes.push(
+            run_process_limited(
+                "component-full-module-export",
+                &exporter,
+                &replay_args,
+                second.path(),
+                &replay_env,
+                &[],
+                "PP5004",
+                "300",
+                16_777_216,
+            )
+            .unwrap(),
+        );
+        for file in ["kernel.ir", "roots.json", "coverage.json"] {
+            assert_eq!(
+                std::fs::read(output.join("export").join(file)).unwrap(),
+                std::fs::read(output.join("export-replay").join(file)).unwrap()
+            );
+        }
+        std::fs::write(
+            output.join("independent-frontend-processes.json"),
+            serde_json::to_vec_pretty(&independent_processes).unwrap(),
+        )
+        .unwrap();
+        for (file, expected) in [
+            (
+                "kernel.ir",
+                "b3c000034887e67cde0d1434e77b49d7046775f6dbc11c5c3ef794e65fbf09bf",
+            ),
+            (
+                "roots.json",
+                "8890d3e7ba84df05d3714aaad1ee0c2dc60926e66ad32380cd5b9c6fa188298b",
+            ),
+            (
+                "coverage.json",
+                "f6a2a9524943ce4761340ac355fecbd77f06404cdbc1b165c3d291d4ab9bf530",
+            ),
+        ] {
+            assert_eq!(
+                sha256(&std::fs::read(output.join("export").join(file)).unwrap()),
+                expected
+            );
+        }
+        let runtime = runtime_reader_registry();
+        std::fs::write(
+            output.join("runtime-registry.json"),
+            serde_json::to_vec_pretty(&runtime).unwrap(),
+        )
+        .unwrap();
+        std::fs::write(
+            output.join("frontend.json"),
+            serde_json::to_vec_pretty(&receipt).unwrap(),
+        )
+        .unwrap();
+        std::fs::write(
+            output.join("processes.json"),
+            serde_json::to_vec_pretty(&processes).unwrap(),
+        )
+        .unwrap();
+        assert!(!walkdir::WalkDir::new(work.path()).into_iter().any(|e| e
+            .unwrap()
+            .path()
+            .extension()
+            .is_some_and(|x| x == "c")));
+    }
+}

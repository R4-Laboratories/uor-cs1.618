+    fn closed_output(script: &str, limits: (usize, usize)) -> Result<MeasuredProcess, PrismError> {
+        run_process_closed_limited(
+            "test-child",
+            &executable("python3").unwrap(),
+            &["-c".into(), script.into()],
+            &std::env::current_dir().unwrap(),

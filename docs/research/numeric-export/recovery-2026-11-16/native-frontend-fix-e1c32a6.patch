+    #[test]
+    fn closed_children_charge_cumulative_original_bytes_before_normalization() {
+        // Each finite child is individually below 16 MiB. Normalization shrinks
+        // 10.8 MB to 1.6 MB, but two children must exceed the original allowance.
+        for stream in ["stdout", "stderr"] {
+            let script =
+                format!("import sys; sys.{stream}.write(('x in '+ '0'*100 + '1s\\n')*100000)");
+            let mut remaining = (16_777_216, 16_777_216);
+            let first = closed_output(&script, remaining).unwrap();
+            let raw = if stream == "stdout" {
+                first.raw_stdout_bytes
+            } else {
+                first.raw_stderr_bytes
+            };
+            assert_eq!(raw, 10_800_000);
+            let record = first.charge(&mut remaining).unwrap();
+            let normalized = if stream == "stdout" {
+                record.stdout.len()
+            } else {
+                record.stderr.len()
+            };
+            assert!(normalized < raw / 2);
+            assert_eq!(
+                remaining,
+                if stream == "stdout" {
+                    (5_977_216, 16_777_216)
+                } else {
+                    (16_777_216, 5_977_216)
+                }
+            );
+            assert_eq!(
+                closed_output(&script, remaining).unwrap_err().code,
+                "PP5007"
+            );
+        }
+    }
+
+    #[test]
+    fn closed_children_enforce_independent_stdout_stderr_limits() {
+        for (stream, limits) in [("stdout", (8, 64)), ("stderr", (64, 8))] {
+            let script = format!("import sys; sys.{stream}.write('x'*9)");
+            assert_eq!(closed_output(&script, limits).unwrap_err().code, "PP5007");
+        }
+        let mut remaining = (8, 64);
+        let record = closed_output(
+            "import sys; sys.stdout.write('x'*8); sys.stderr.write('y'*64)",
+            remaining,
+        )
+        .unwrap()
+        .charge(&mut remaining)
+        .unwrap();
+        assert_eq!(remaining, (0, 0));
+        assert_eq!((record.stdout.len(), record.stderr.len()), (8, 64));
+        closed_output("pass", remaining)
+            .unwrap()
+            .charge(&mut remaining)
+            .unwrap();
+        assert_eq!(
+            closed_output("print('x')", remaining).unwrap_err().code,
+            "PP5007"
+        );
+    }

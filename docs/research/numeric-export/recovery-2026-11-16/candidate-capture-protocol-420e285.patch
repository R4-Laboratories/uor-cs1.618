+    def test_eof_negative_never_admits_stage(self):
+        read_fd, write_fd = os.pipe()
+        ready = threading.Event()
+        def send():
+            with os.fdopen(write_fd, "wb", buffering=0) as stream:
+                stream.write(self.payload())
+                ready.wait(2)  # Deliberately keep actual writer alive after marker.
+        thread = threading.Thread(target=send)
+        thread.start()
+        try:
+            with os.fdopen(read_fd, "rb", buffering=0) as stream:
+                deadline = time.monotonic() + 0.2
+                with self.assertRaisesRegex(RuntimeError, "retirement deadline"):
+                    candidate.materialize_inputs(candidate.Reader(stream, deadline), self.destination, self.descriptor, deadline)
+            self.assertFalse((self.destination / candidate.DESCRIPTOR_NAME).exists())
+            self.assertEqual(stat.S_IMODE((self.destination / "current-test-elf").stat().st_mode), 0o400)
+            self.assertEqual(stat.S_IMODE((self.destination / "candidate-source/tool").stat().st_mode), 0o400)
+        finally:
+            ready.set()
+            thread.join(timeout=3)

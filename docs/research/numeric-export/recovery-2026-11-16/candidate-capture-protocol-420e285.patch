+    def test_actual_child_capsule_digest_length_closure_limits(self):
+        records = self.capsule_records()
+        utility = (HERE / candidate.UTILITY_NAME).read_bytes()
+        entry = (HERE / candidate.ENTRY_NAME).read_bytes()
+        # Executes the component helper in real children, not bootstrap main;
+        # this deliberately does not bypass or claim its SDK runtime pin.
+        command = ('import importlib.util,json,sys,time; from pathlib import Path; '
+                   's=importlib.util.spec_from_file_location("b",sys.argv[1]); '
+                   'b=importlib.util.module_from_spec(s);s.loader.exec_module(b); '
+                   'b.admit_capsules(b.CapsuleReader(sys.stdin.buffer,time.monotonic()+2),'
+                   'Path(sys.argv[2]),json.loads(sys.argv[3])); print("CAPSULE_COMPONENT_ONLY")')
+        cases = [("valid", records, utility + entry, None),
+                 ("utility", records, b"x" + utility[1:] + entry, b"capsule digest mismatch"),
+                 ("entry", records, utility + b"x" + entry[1:], b"capsule digest mismatch"),
+                 ("short", records, utility + entry[:-1], b"closed early"),
+                 ("length", [records[0], {**records[1], "bytes": records[1]["bytes"] + 1}], utility + entry + b"x", b"digest mismatch"),
+                 ("digest", [records[0], {**records[1], "sha256": "0" * 64}], utility + entry, b"digest mismatch"),
+                 ("bound", [records[0], {**records[1], "bytes": 1048577}], utility, b"closed capsule measurement")]
+        for name, rows, body, message in cases:
+            result = subprocess.run(["/usr/bin/python3", "-I", "-B", "-c", command,
+                                     str(HERE / candidate.BOOTSTRAP_NAME), str(self.root / ("capsule-" + name)),
+                                     json.dumps(rows)], input=body, capture_output=True, timeout=5)
+            with self.subTest(name=name):
+                if message is None:
+                    self.assertEqual(result.returncode, 0, result.stderr)
+                    self.assertEqual(result.stdout, b"CAPSULE_COMPONENT_ONLY\n")
+                else:
+                    self.assertNotEqual(result.returncode, 0)
+                    self.assertIn(message, result.stderr)
+                    self.assertEqual(result.stdout, b"")

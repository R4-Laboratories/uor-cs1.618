+    def test_byte_count_and_json_boundaries(self):
+        row = {"path": "a", "kind": "file", "bytes": legacy.MAX_FILE, "sha256": "0" * 64, "executable": False}
+        self.assertEqual(candidate.validate_rows([row]), [row])
+        candidate.validate_rows([row, {**row, "path": "b"}])  # Exact 512 MiB union.
+        for rows in ([{**row, "bytes": legacy.MAX_FILE + 1}], [row, {**row, "path": "b"}, {**row, "path": "c", "bytes": 1}],
+                     [{**row, "bytes": True}]):

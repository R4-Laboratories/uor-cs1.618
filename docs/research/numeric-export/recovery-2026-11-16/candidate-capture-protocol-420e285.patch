index 0000000000000000000000000000000000000000..69c5643fee217b2bcb33526a29f3adfdbc874aa4
--- /dev/null
+++ b/scripts/conditional-capture-candidate.py
@@ -0,0 +1,505 @@
+"""Closed candidate-source-v1 transport components; never SDK acceptance.
+
+Parent orchestration and guest execution are deliberately unavailable until the
+separate actor-lifecycle implementation is reviewed. Stage admission describes
+only complete measured input bytes and EOF, never application acceptance.
+"""
+import hashlib
+import importlib.util
+import os
+from pathlib import Path, PurePosixPath
+import re
+import stat
+import sys
+import time
+
+UTILITY_NAME = "conditional-capture-sdk.py"
+UTILITY_SHA256 = "ca09b9de3bf57c3e2dc16e11d4d1a527b9b2f1f271566bb7a87846d0a24f8e9a"
+ENTRY_NAME = "conditional-capture-candidate.py"
+BOOTSTRAP_NAME = "conditional-capture-bootstrap.py"
+MAX_MODULE = 1024 * 1024
+MAX_BOOTSTRAP = 32 * 1024
+
+
+def _identity(info):
+    return (info.st_dev, info.st_ino, info.st_mode, info.st_nlink, info.st_size, info.st_mtime_ns, info.st_ctime_ns)
+
+
+def _utility():
+    # No ambient source search, pyc execution or unauthenticated loader reread.
+    path = Path(__file__).absolute().with_name(UTILITY_NAME)
+    if path.resolve() != path:
+        raise RuntimeError("utility path must be exact and unaliased")
+    before = os.lstat(path)
+    if not stat.S_ISREG(before.st_mode) or before.st_nlink != 1 or before.st_size > MAX_MODULE:
+        raise RuntimeError("bounded singly linked utility required")
+    fd = os.open(path, os.O_RDONLY | os.O_NOFOLLOW | os.O_CLOEXEC)
+    with os.fdopen(fd, "rb") as stream:
+        if _identity(os.fstat(stream.fileno())) != _identity(before):
+            raise RuntimeError("utility changed before admission")
+        body = stream.read(MAX_MODULE + 1)
+        if _identity(os.fstat(stream.fileno())) != _identity(before) or _identity(os.lstat(path)) != _identity(before):
+            raise RuntimeError("utility changed during admission")
+    if hashlib.sha256(body).hexdigest() != UTILITY_SHA256:
+        raise RuntimeError("utility digest mismatch")
+    spec = importlib.util.spec_from_file_location("candidate_capture_utility", path)
+    module = importlib.util.module_from_spec(spec)
+    exec(compile(body, str(path), "exec"), module.__dict__)
+    return module
+
+
+legacy = _utility()
+require, encoded, sha, Reader = legacy.require, legacy.encoded, legacy.sha, legacy.Reader
+SOURCE_PLAN_SCHEMA = "prismpm/conditional-candidate-source-plan/1"
+INPUT_SCHEMA = "prismpm/conditional-candidate-capture-input/1"
+RESPONSE_SCHEMA = "prismpm/conditional-candidate-capture-response/1"
+STAGE_SCHEMA = "prismpm/conditional-candidate-stage-admission/1"
+ROUTE = "candidate-source-v1"
+SDK_IMAGE = "ghcr.io/uor-foundation/prismpm-sdk@sha256:d6c263a733a6bc36e0458c3f5b9a1f5ea9c14dfbe8c257d3f650a960b5fe633c"
+AUTHORITY = tuple("scripts/" + name for name in (
+    BOOTSTRAP_NAME, "conditional-capture-candidate-command.mjs", ENTRY_NAME,
+    UTILITY_NAME, "sdk-command-owner.mjs", "sdk-command-owner.py"))
+FIXTURES = ("examples/Calculator/src", "stdlib/src/Foundation", "stdlib/src/Production")
+DESCRIPTOR_NAME = "candidate-input.json"
+MANIFEST_NAME = "candidate-transfer-manifest.json"
+
+
+def tick(deadline):
+    require(time.monotonic() < deadline, "candidate input deadline")
+
+
+def scalar(value):
+    require(isinstance(value, str) and not any(0xD800 <= ord(c) <= 0xDFFF for c in value),
+            "Unicode scalar path required")
+    return value
+
+
+def ordered(rows):
+    return sorted(rows, key=lambda record: scalar(record["path"]).encode("utf-8"))
+
+
+def validate_rows(rows, *, ancestors=True):
+    legacy.validate_rows(rows)
+    for record in rows:
+        scalar(record["path"])
+        if record["kind"] == "link":
+            scalar(record["target"])
+    require(rows == ordered(rows), "UTF-8 ordered inventory required")
+    kinds = {record["path"]: record["kind"] for record in rows}
+    for record in rows:
+        paths = [record["path"]]
+        if record["kind"] == "link":
+            target = os.path.normpath(str(PurePosixPath(record["path"]).parent / record["target"]))
+            paths.append(target)
+        for path in paths:
+            for parent in PurePosixPath(path).parents:
+                if str(parent) != ".":
+                    require(kinds.get(str(parent)) == "directory" or
+                            (not ancestors and str(parent) not in kinds),
+                            "undeclared or alias inventory parent")
+    return rows
+
+
+def union_rows(source, fixtures):
+    validate_rows(source)
+    validate_rows(fixtures, ancestors=False)
+    merged = {record["path"]: record for record in source}
+    for record in fixtures:
+        require(record["path"] not in merged or merged[record["path"]] == record,
+                "source/fixture conflict")
+        merged[record["path"]] = record
+    union = validate_rows(ordered(list(merged.values())))
+    selected = [record for record in union if any(record["path"] == root or
+                record["path"].startswith(root + "/") for root in FIXTURES)]
+    require(selected == fixtures and all(any(record == {"path": root, "kind": "directory"}
+                for record in fixtures) for root in FIXTURES), "complete fixture closure required")
+    require(all(record["kind"] != "link" for record in fixtures), "fixture aliases forbidden")
+    return union
+
+
+def digest(value):
+    return sha(encoded(value))
+
+
+def valid_digest(value):
+    return isinstance(value, str) and re.fullmatch(r"[0-9a-f]{64}", value) is not None
+
+
+def validate_source_plan(value):
+    keys = {"schema", "route", "source_root", "source_selection", "source", "fixture_inputs",
+            "source_sha256", "fixture_inputs_sha256", "union", "union_sha256", "authority",
+            "executable_bytes", "executable_sha256", "listing_sha256", "test_count",
+            "remaining_seconds", "sdk_image"}
+    require(type(value) is dict and set(value) == keys, "closed candidate input descriptor")
+    require(value["schema"] == SOURCE_PLAN_SCHEMA and value["route"] == ROUTE, "candidate input version")
+    require(value["source_selection"] in ("tracked", "private"), "closed source selection")
+    scalar(value["source_root"])
+    legacy.alias_root(value["source_root"])
+    if value["source_selection"] == "private":
+        require(re.fullmatch(r"/tmp/prismpm-publication-capture-[A-Za-z0-9_-]{6,64}/source",
+                             value["source_root"]), "closed private source owner")
+    require(value["source_root"] != "/workspace/conditional-capture", "compiled root overlaps work")
+    union = union_rows(value["source"], value["fixture_inputs"])
+    require(value["union"] == union and value["source_sha256"] == digest(value["source"])
+            and value["fixture_inputs_sha256"] == digest(value["fixture_inputs"])
+            and value["union_sha256"] == digest(union), "candidate inventory digest/union mismatch")
+    source = {r["path"]: r for r in value["source"]}
+    require(all(name in source and source[name]["kind"] == "file" for name in AUTHORITY),
+            "complete source authority required")
+    require(value["authority"] == [source[name] for name in AUTHORITY], "closed source authority")
+    require(source["scripts/" + UTILITY_NAME]["sha256"] == UTILITY_SHA256,
+            "original utility digest required")
+    for name, maximum in ((BOOTSTRAP_NAME, MAX_BOOTSTRAP), (ENTRY_NAME, MAX_MODULE),
+                          (UTILITY_NAME, MAX_MODULE)):
+        require(0 < source["scripts/" + name]["bytes"] <= maximum, "bootstrap capsule byte bound")
+    require(type(value["executable_bytes"]) is int and 4 <= value["executable_bytes"] <= legacy.MAX_ELF
+            and valid_digest(value["executable_sha256"]) and valid_digest(value["listing_sha256"]),
+            "closed exact ELF measurement")
+    require(type(value["test_count"]) is int and 1 <= value["test_count"] <= 100000,
+            "closed actual test count")
+    require(type(value["remaining_seconds"]) is int and 0 < value["remaining_seconds"] <=
+            legacy.DEADLINE_SECONDS - legacy.RETIREMENT_RESERVE_SECONDS, "bounded remaining seconds")
+    require(value["sdk_image"] == SDK_IMAGE, "unchanged SDK distribution required")
+    require(len(encoded(value)) <= legacy.MAX_JSON, "candidate descriptor byte bound")
+    return value
+
+
+def measure_inputs(source: Path, executable: Path, remaining_seconds: int) -> dict:
+    require(type(remaining_seconds) is int and 0 < remaining_seconds <= 1980, "bounded measurement seconds")
+    deadline = time.monotonic() + remaining_seconds
+    executable_before = legacy.identity(os.lstat(executable))
+    source = Path(source)
+    require(source.is_absolute() and source.resolve(strict=True) == source, "unaliased source root required")
+    legacy.alias_root(str(source))
+    rows = validate_rows(ordered(legacy.source_rows(source)))
+    fixtures = validate_rows(ordered(legacy.fixture_rows(source)), ancestors=False)
+    union = union_rows(rows, fixtures)
+    tick(deadline)
+    body = measure_regular(executable, legacy.MAX_ELF, deadline, elf=True)
+    authority = {r["path"]: r for r in rows}
+    require(all(name in authority for name in AUTHORITY), "complete source authority required")
+    for name in (ENTRY_NAME, BOOTSTRAP_NAME):
+        actual = legacy.read_regular(Path(__file__).with_name(name), MAX_MODULE)
+        require(authority["scripts/" + name]["sha256"] == sha(actual), "current source authority mismatch")
+    value = {"schema": SOURCE_PLAN_SCHEMA, "route": ROUTE, "source_root": str(source),
+             "source_selection": "tracked" if os.path.lexists(source / ".git") else "private",
+             "source": rows, "fixture_inputs": fixtures, "source_sha256": digest(rows),
+             "fixture_inputs_sha256": digest(fixtures), "union": union, "union_sha256": digest(union),
+             "authority": [authority[name] for name in AUTHORITY],
+             "executable_bytes": body["bytes"], "executable_sha256": body["sha256"],
+             "listing_sha256": legacy.listing(executable), "test_count": legacy.test_count(executable),
+             "remaining_seconds": remaining_seconds, "sdk_image": SDK_IMAGE}
+    require(legacy.identity(os.lstat(executable)) == executable_before, "ELF changed during measurement")
+    tick(deadline)
+    return validate_source_plan(value)
+
+
+def validate_runtime(value):
+    require(type(value) is dict and set(value) == {"sdk_image", "config_digest", "os", "architecture",
+            "inventory_sha256", "image_authority"}, "closed observed SDK runtime")
+    require(value["sdk_image"] == SDK_IMAGE and value["os"] == "linux"
+            and value["architecture"] in ("amd64", "arm64")
+            and isinstance(value["config_digest"], str)
+            and re.fullmatch(r"sha256:[0-9a-f]{64}", value["config_digest"])
+            and valid_digest(value["inventory_sha256"]), "actual SDK identity shape")
+    records = value["image_authority"]
+    require(type(records) is list and len(records) == 2, "closed image authority")
+    for record, name in zip(records, (UTILITY_NAME, "conditional-capture-command.mjs")):
+        require(type(record) is dict and set(record) == {"path", "bytes", "sha256"}
+                and record["path"] == str(legacy.SDK_ROOT / "scripts" / name)
+                and type(record["bytes"]) is int and 0 < record["bytes"] <= legacy.MAX_FILE
+                and valid_digest(record["sha256"]), "measured image authority shape")
+    return value
+
+
+def bind_runtime(source_plan, runtime_observation):
+    validate_source_plan(source_plan)
+    validate_runtime(runtime_observation)
+    # Canonical roundtrip takes an independent immutable-by-custody snapshot.
+    value = legacy.json.loads(encoded(source_plan))
+    value["schema"] = INPUT_SCHEMA
+    value["runtime"] = legacy.json.loads(encoded(runtime_observation))
+    return validate_descriptor(value)
+
+
+def validate_descriptor(value):
+    require(type(value) is dict and value.get("schema") == INPUT_SCHEMA and "runtime" in value,
+            "runtime-bound candidate descriptor required")
+    plan = {key: item for key, item in value.items() if key != "runtime"}
+    plan["schema"] = SOURCE_PLAN_SCHEMA
+    validate_source_plan(plan)
+    validate_runtime(value["runtime"])
+    require(len(encoded(value)) <= legacy.MAX_JSON, "candidate descriptor byte bound")
+    return value
+
+
+def transfer_manifest(descriptor):
+    return [{"path": "candidate-source/" + r["path"], "bytes": r["bytes"], "sha256": r["sha256"]}
+            for r in descriptor["union"] if r["kind"] == "file"] + [
+            {"path": "current-test-elf", "bytes": descriptor["executable_bytes"],
+             "sha256": descriptor["executable_sha256"]}]
+
+
+def completion_marker(descriptor):
+    return {"kind": "inputs-complete", "descriptor_sha256": digest(descriptor),
+            "transfer_manifest_sha256": digest(transfer_manifest(descriptor))}
+
+
+def measure_regular(path, limit, deadline, *, elf=False):
+    """Streaming bounded readback; compare original no-follow metadata identity."""
+    tick(deadline)
+    before = os.lstat(path)
+    require(stat.S_ISREG(before.st_mode) and before.st_nlink == 1 and 0 <= before.st_size <= limit,
+            "bounded singly linked readback file")
+    fd = os.open(path, os.O_RDONLY | os.O_NOFOLLOW | os.O_NONBLOCK | os.O_CLOEXEC)
+    actual = hashlib.sha256()
+    with os.fdopen(fd, "rb") as stream:
+        require(legacy.identity(os.fstat(stream.fileno())) == legacy.identity(before), "readback file replaced")
+        remaining, first = before.st_size, True
+        while remaining:
+            tick(deadline)
+            part = stream.read(min(remaining, legacy.MIB))
+            require(part, "short readback file")
+            if first and elf:
+                require(part.startswith(b"\x7fELF"), "exact readback ELF required")
+            first = False
+            actual.update(part)
+            remaining -= len(part)
+        require(not elf or not first, "nonempty readback ELF required")
+        require(stream.read(1) == b"" and legacy.identity(os.fstat(stream.fileno())) == legacy.identity(before)
+                and legacy.identity(os.lstat(path)) == legacy.identity(before), "readback file changed")
+    return {"bytes": before.st_size, "sha256": actual.hexdigest()}
+
+
+def complete_tree(root, deadline):
+    """Complete readback: no legacy source/cache exclusions, no symlink descent."""
+    rows, total = [], 0
+    def visit(name):
+        nonlocal total
+        tick(deadline)
+        require(len(rows) < 100000, "candidate readback count bound")
+        info = os.lstat(root / name)
+        if stat.S_ISREG(info.st_mode):
+            total += info.st_size
+            require(total <= legacy.MAX_TREE, "candidate readback byte bound")
+        record = ({"path": name, "kind": "file", "executable": bool(info.st_mode & 0o100),
+                   **measure_regular(root / name, legacy.MAX_FILE, deadline)}
+                  if stat.S_ISREG(info.st_mode) else legacy.row(root, name))
+        rows.append(record)
+        if record["kind"] == "directory":
+            for child in sorted(os.listdir(root / name), key=lambda text: scalar(text).encode("utf-8")):
+                visit(name + "/" + child)
+    for name in sorted(os.listdir(root), key=lambda text: scalar(text).encode("utf-8")):
+        visit(name)
+    return validate_rows(ordered(rows))
+
+
+def _exclusive(path, body, mode=0o400):
+    fd = os.open(path, os.O_WRONLY | os.O_CREAT | os.O_EXCL | os.O_NOFOLLOW | os.O_CLOEXEC, 0o600)
+    with os.fdopen(fd, "wb") as output:
+        output.write(body)
+        output.flush()
+        os.fchmod(output.fileno(), mode)
+
+
+def _receive(reader, path, length, expected, mode, deadline, *, elf=False):
+    fd = os.open(path, os.O_WRONLY | os.O_CREAT | os.O_EXCL | os.O_NOFOLLOW | os.O_CLOEXEC, 0o600)
+    actual = hashlib.sha256()
+    first = True
+    with os.fdopen(fd, "wb") as output:
+        remaining = length
+        while remaining:
+            tick(deadline)
+            part = reader.exact(min(legacy.MIB, remaining))
+            if first and elf:
+                require(part.startswith(b"\x7fELF"), "received exact ELF required")
+            first = False
+            output.write(part)
+            actual.update(part)
+            remaining -= len(part)
+        require(actual.hexdigest() == expected, "received body digest mismatch")
+        output.flush()
+        require(os.fstat(output.fileno()).st_nlink == 1, "received hardlink refused")
+        os.fchmod(output.fileno(), mode)
+
+
+def _capsules(destination, descriptor):
+    authority = {r["path"]: r for r in descriptor["authority"]}
+    root = destination / "authority"
+    require(root.resolve() == root and stat.S_ISDIR(os.lstat(root).st_mode), "exact authority directory")
+    require(set(os.listdir(root)) == {UTILITY_NAME, ENTRY_NAME}, "closed authority capsule files")
+    for name in (UTILITY_NAME, ENTRY_NAME):
+        body = legacy.read_regular(root / name, MAX_MODULE)
+        record = authority["scripts/" + name]
+        require(len(body) == record["bytes"] and sha(body) == record["sha256"], "authority capsule mismatch")
+
+
+def verify_materialized(destination, descriptor, deadline):
+    validate_descriptor(descriptor)
+    tick(deadline)
+    require(destination.resolve() == destination and stat.S_ISDIR(os.lstat(destination).st_mode),
+            "exact materialized root")
+    require(stat.S_IMODE(os.lstat(destination).st_mode) == 0o500, "normalized input directory")
+    require(set(os.listdir(destination)) == {"authority", "candidate-source", "current-test-elf",
+            DESCRIPTOR_NAME, MANIFEST_NAME}, "closed materialized root")
+    root = destination / "candidate-source"
+    require(stat.S_ISDIR(os.lstat(root).st_mode) and root.resolve() == root, "exact candidate source root")
+    require(complete_tree(root, deadline) == descriptor["union"], "complete source readback mismatch")
+    require(ordered(legacy.fixture_rows(root)) == descriptor["fixture_inputs"], "fixture readback mismatch")
+    for record in [{"path": "", "kind": "directory"}] + descriptor["union"]:
+        if record["kind"] != "link":
+            mode = 0o500 if record["kind"] == "directory" or record.get("executable") else 0o400
+            require(stat.S_IMODE(os.lstat(root / record["path"]).st_mode) == mode, "normalized source mode")
+    _capsules(destination, descriptor)
+    for name in (UTILITY_NAME, ENTRY_NAME):
+        require(stat.S_IMODE(os.lstat(destination / "authority" / name).st_mode) == 0o400,
+                "normalized authority mode")
+    require(stat.S_IMODE(os.lstat(destination / "authority").st_mode) == 0o500,
+            "normalized authority directory")
+    body = measure_regular(destination / "current-test-elf", legacy.MAX_ELF, deadline, elf=True)
+    require(body == {"bytes": descriptor["executable_bytes"], "sha256": descriptor["executable_sha256"]}
+            and stat.S_IMODE(os.lstat(destination / "current-test-elf").st_mode)
+            == 0o500, "exact ELF readback mismatch")
+    for name, value in ((DESCRIPTOR_NAME, descriptor), (MANIFEST_NAME, transfer_manifest(descriptor))):
+        require(legacy.read_regular(destination / name, legacy.MAX_JSON) == encoded(value)
+                and stat.S_IMODE(os.lstat(destination / name).st_mode) == 0o400, "canonical input metadata")
+    tick(deadline)
+    return {"schema": STAGE_SCHEMA, "route": ROUTE, "descriptor_sha256": digest(descriptor),
+            "source_sha256": descriptor["source_sha256"], "union_sha256": descriptor["union_sha256"],
+            "fixture_inputs_sha256": descriptor["fixture_inputs_sha256"],
+            "transfer_manifest_sha256": digest(transfer_manifest(descriptor)),
+            "authority": descriptor["authority"], "executable_sha256": descriptor["executable_sha256"]}
+
+
+def _materialize(reader, destination, descriptor, deadline, *, bootstrapped=False):
+    validate_descriptor(descriptor)
+    tick(deadline)
+    reader.deadline = min(reader.deadline, deadline)
+    require(destination.is_absolute() and destination.parent.resolve() == destination.parent,
+            "unaliased destination parent required")
+    if bootstrapped:
+        require(destination == Path("/workspace") and set(os.listdir(destination)) == {"authority"},
+                "occupied stage destination")
+        _capsules(destination, descriptor)
+    else:
+        require(not os.path.lexists(destination), "occupied destination")
+        destination.mkdir(mode=0o700)
+    root = destination / "candidate-source"
+    root.mkdir(mode=0o700)
+    for record in descriptor["union"]:
+        tick(deadline)
+        path = root / record["path"]
+        if record["kind"] == "directory":
+            path.mkdir(mode=0o700)
+        elif record["kind"] == "file":
+            _receive(reader, path, record["bytes"], record["sha256"],
+                     0o400, deadline)
+    for record in descriptor["union"]:
+        if record["kind"] == "link":
+            os.symlink(record["target"], root / record["path"])
+    _receive(reader, destination / "current-test-elf", descriptor["executable_bytes"],
+             descriptor["executable_sha256"], 0o400, deadline, elf=True)
+    require(reader.line() == completion_marker(descriptor), "descriptor-bound completion marker required")
+    reader.exhausted()  # No admission until actual EOF; deadline still shared.
+    if not bootstrapped:
+        (destination / "authority").mkdir(mode=0o700)
+        for name in (UTILITY_NAME, ENTRY_NAME):
+            _exclusive(destination / "authority" / name, legacy.read_regular(root / "scripts" / name, MAX_MODULE))
+    for name, value in ((DESCRIPTOR_NAME, descriptor), (MANIFEST_NAME, transfer_manifest(descriptor))):
+        _exclusive(destination / name, encoded(value))
+    for record in reversed(descriptor["union"]):
+        if record["kind"] == "file":
+            (root / record["path"]).chmod(0o500 if record["executable"] else 0o400)
+        elif record["kind"] == "directory":
+            (root / record["path"]).chmod(0o500)
+    root.chmod(0o500)
+    (destination / "current-test-elf").chmod(0o500)
+    (destination / "authority").chmod(0o500)
+    destination.chmod(0o500)
+    result = verify_materialized(destination, descriptor, deadline)
+    result["input_eof_observed"] = True
+    return result
+
+
+def materialize_inputs(reader, destination: Path, descriptor: dict, deadline: float) -> dict:
+    """Receive bodies after the descriptor line into a new destination."""
+    return _materialize(reader, destination, descriptor, deadline)
+
+
+def input_identities(source, executable, descriptor):
+    """Outer owner holds this snapshot across every subsequent send/recheck."""
+    return {"source_root": legacy.identity(os.lstat(source)),
+            "source": {r["path"]: legacy.identity(os.lstat(source / r["path"])) for r in descriptor["union"]},
+            "executable": legacy.identity(os.lstat(executable))}
+
+
+def write_inputs(stream, source, executable, descriptor, deadline, identities):
+    """Bounded sender; immutable identity snapshot belongs to the outer owner."""
+    validate_descriptor(descriptor)
+    require(str(source) == descriptor["source_root"] and source.resolve() == source, "exact sender source root")
+    require(input_identities(source, executable, descriptor) == identities, "input metadata changed before transfer")
+    require(ordered(legacy.source_rows(source)) == descriptor["source"]
+            and ordered(legacy.fixture_rows(source)) == descriptor["fixture_inputs"], "source changed before transfer")
+    legacy.write_bounded(stream, encoded(descriptor), deadline)
+    for record in transfer_manifest(descriptor):
+        path = source / record["path"][len("candidate-source/"):] if record["path"].startswith("candidate-source/") else executable
+        before = os.lstat(path)
+        require(stat.S_ISREG(before.st_mode) and before.st_nlink == 1 and before.st_size == record["bytes"],
+                "bounded singly linked sender input")
+        fd = os.open(path, os.O_RDONLY | os.O_NOFOLLOW | os.O_CLOEXEC)
+        actual = hashlib.sha256()
+        with os.fdopen(fd, "rb") as body:
+            require(legacy.identity(os.fstat(body.fileno())) == legacy.identity(before), "sender input replaced")
+            remaining = record["bytes"]
+            while remaining:
+                tick(deadline)
+                part = body.read(min(legacy.MIB, remaining))
+                require(part, "sender input shortened")
+                actual.update(part)
+                legacy.write_bounded(stream, part, deadline)
+                remaining -= len(part)
+            require(body.read(1) == b"" and actual.hexdigest() == record["sha256"]
+                    and legacy.identity(os.fstat(body.fileno())) == legacy.identity(before)
+                    and legacy.identity(os.lstat(path)) == legacy.identity(before), "sender input changed")
+    require(input_identities(source, executable, descriptor) == identities
+            and ordered(legacy.source_rows(source)) == descriptor["source"]
+            and ordered(legacy.fixture_rows(source)) == descriptor["fixture_inputs"], "input changed during transfer")
+    legacy.write_bounded(stream, encoded(completion_marker(descriptor)), deadline)
+    # The caller closes the stream. It must not interpret a written marker as EOF.
+
+
+def stage(context):
+    require(set(context) == {"mode", "deadline", "descriptor_sha256", "bootstrap", "capsules"}
+            and context["mode"] == "stage-v1", "closed bootstrap stage entry")
+    reader = Reader(sys.stdin.buffer, context["deadline"])
+    descriptor = validate_descriptor(reader.line())
+    context["deadline"] = min(context["deadline"], time.monotonic() + descriptor["remaining_seconds"])
+    require(digest(descriptor) == context["descriptor_sha256"], "bootstrap descriptor mismatch")
+    authority = {r["path"]: r for r in descriptor["authority"]}
+    require(authority["scripts/" + BOOTSTRAP_NAME]["sha256"] == sha(context["bootstrap"])
+            and authority["scripts/" + BOOTSTRAP_NAME]["bytes"] == len(context["bootstrap"]),
+            "actual bootstrap bytes mismatch")
+    for record, name in zip(context["capsules"], (UTILITY_NAME, ENTRY_NAME)):
+        require(record == {key: authority["scripts/" + name][key] for key in ("bytes", "sha256")},
+                "bootstrap capsule descriptor mismatch")
+    result = _materialize(reader, Path("/workspace"), descriptor, context["deadline"], bootstrapped=True)
+    legacy.write_bounded(sys.stdout.buffer, encoded(result), context["deadline"])
+
+
+def guest(context):
+    raise RuntimeError("candidate guest lifecycle is not implemented; no SDK execution admitted")
+
+
+def parent(source, executable):
+    raise RuntimeError("candidate parent lifecycle is not implemented; no Docker operation admitted")
+
+
+if __name__ == "__main__":
+    try:
+        if len(sys.argv) == 4 and sys.argv[1] == "parent":
+            parent(Path(sys.argv[2]), Path(sys.argv[3]))
+        else:
+            raise RuntimeError("closed candidate entry; stage/guest require authenticated bootstrap")
+    except Exception as error:
+        print("candidate capture failed: " + str(error), file=sys.stderr)
+        sys.exit(1)

+    def test_actual_bootstrap_child_argument_and_pin_guards(self):
+        arguments = self.bootstrap_arguments()
+        cases = [(arguments, b"requires Python 3.12.3"), (arguments[:-1], b"orig_argv"),
+                 ([*arguments[:5], "arbitrary", *arguments[6:]], b"closed bootstrap mode"),
+                 ([*arguments[:6], "1981", *arguments[7:]], b"bounded bootstrap seconds"),
+                 ([*arguments[:8], "1048577", *arguments[9:]], b"bounded bootstrap capsule"),
+                 ([*arguments[:9], "0" * 64, *arguments[10:]], b"fixed bootstrap utility digest")]
+        for argv, message in cases:

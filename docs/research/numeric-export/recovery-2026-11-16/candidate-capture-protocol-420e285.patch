index 0000000000000000000000000000000000000000..f81aed06e3c6cf6df58c58a78f811ff4d843ce8f
--- /dev/null
+++ b/scripts/conditional-capture-bootstrap.py
@@ -0,0 +1,158 @@
+"""Fixed same-PID candidate bootstrap, supplied only as inspected python -c bytes.
+
+No arbitrary path/module/command interface. Actual admission requires the pinned
+SDK interpreter and UID/GID. Component helpers can be tested without claiming
+that their host execution qualifies this bootstrap in the SDK.
+"""
+import hashlib
+import json
+import os
+from pathlib import Path
+import re
+import select
+import shutil
+import stat
+import sys
+import time
+
+MAX_BOOTSTRAP = 32768
+MAX_MODULE = 1048576
+MAX_JSON = 33554432
+UTILITY = "conditional-capture-sdk.py"
+ENTRY = "conditional-capture-candidate.py"
+UTILITY_SHA256 = "ca09b9de3bf57c3e2dc16e11d4d1a527b9b2f1f271566bb7a87846d0a24f8e9a"
+
+
+def require(ok, message):
+    if not ok:
+        raise RuntimeError(message)
+
+
+def parse_invocation(original, current):
+    require(type(original) is list and len(original) == 12 and original[:4] ==
+            ["/usr/bin/python3", "-I", "-B", "-c"], "exact Python orig_argv required")
+    require(current == ["-c"] + original[5:], "exact Python argv required")
+    code = original[4].encode("utf-8", "strict")
+    require(0 < len(code) <= MAX_BOOTSTRAP, "bootstrap byte bound")
+    mode, seconds, descriptor, utility_size, utility_hash, entry_size, entry_hash = original[5:]
+    require(mode in ("stage-v1", "execute-v1"), "closed bootstrap mode")
+    require(re.fullmatch(r"[1-9][0-9]{0,3}", seconds) and int(seconds) <= 1980,
+            "bounded bootstrap seconds")
+    require(re.fullmatch(r"[0-9a-f]{64}", descriptor), "bootstrap descriptor digest")
+    capsules = []
+    for size, value in ((utility_size, utility_hash), (entry_size, entry_hash)):
+        require(re.fullmatch(r"[1-9][0-9]{0,6}", size) and int(size) <= MAX_MODULE
+                and re.fullmatch(r"[0-9a-f]{64}", value), "bounded bootstrap capsule")
+        capsules.append({"bytes": int(size), "sha256": value})
+    require(utility_hash == UTILITY_SHA256, "fixed bootstrap utility digest")
+    return {"mode": mode, "seconds": int(seconds), "descriptor_sha256": descriptor,
+            "bootstrap": code, "capsules": capsules}
+
+
+class CapsuleReader:
+    def __init__(self, stream, deadline):
+        self.fd, self.deadline = stream.fileno(), deadline
+
+    def exact(self, length):
+        require(type(length) is int and 0 < length <= MAX_MODULE, "capsule byte bound")
+        result = bytearray()
+        while len(result) < length:
+            left = self.deadline - time.monotonic()
+            require(left > 0 and select.select([self.fd], [], [], left)[0], "bootstrap channel deadline")
+            part = os.read(self.fd, min(65536, length - len(result)))
+            require(part, "bootstrap channel closed early")
+            result.extend(part)
+        return bytes(result)
+
+
+def identity(info):
+    return (info.st_dev, info.st_ino, info.st_mode, info.st_nlink, info.st_size, info.st_mtime_ns, info.st_ctime_ns)
+
+
+def checked_file(path, record):
+    before = os.lstat(path)
+    require(stat.S_ISREG(before.st_mode) and before.st_nlink == 1 and before.st_size == record["bytes"]
+            and 0 < before.st_size <= MAX_MODULE, "closed capsule file")
+    fd = os.open(path, os.O_RDONLY | os.O_NOFOLLOW | os.O_CLOEXEC)
+    with os.fdopen(fd, "rb") as stream:
+        require(identity(os.fstat(stream.fileno())) == identity(before), "capsule changed before admission")
+        body = stream.read(MAX_MODULE + 1)
+        require(identity(os.fstat(stream.fileno())) == identity(before) and identity(os.lstat(path)) == identity(before),
+                "capsule changed during admission")
+    require(len(body) == record["bytes"] and hashlib.sha256(body).hexdigest() == record["sha256"],
+            "capsule digest mismatch")
+    return body
+
+
+def admit_capsules(reader, destination, capsules):
+    """Component primitive; main supplies only fixed /workspace/authority."""
+    require(len(capsules) == 2 and capsules[0]["sha256"] == UTILITY_SHA256, "fixed capsule order")
+    require(destination.is_absolute() and destination.parent.resolve() == destination.parent,
+            "unaliased capsule destination")
+    require(not os.path.lexists(destination), "occupied capsule destination")
+    destination.mkdir(mode=0o700)
+    bodies = []
+    for name, record in zip((UTILITY, ENTRY), capsules):
+        require(set(record) == {"bytes", "sha256"} and type(record["bytes"]) is int
+                and 0 < record["bytes"] <= MAX_MODULE and isinstance(record["sha256"], str)
+                and re.fullmatch(r"[0-9a-f]{64}", record["sha256"]), "closed capsule measurement")
+        body = reader.exact(record["bytes"])
+        require(hashlib.sha256(body).hexdigest() == record["sha256"], "capsule digest mismatch")
+        fd = os.open(destination / name, os.O_WRONLY | os.O_CREAT | os.O_EXCL | os.O_NOFOLLOW, 0o600)
+        with os.fdopen(fd, "wb") as output:
+            output.write(body)
+            output.flush()
+            os.fchmod(output.fileno(), 0o400)
+        require(checked_file(destination / name, record) == body, "capsule readback mismatch")
+        bodies.append(body)
+    return bodies
+
+
+def main():
+    started = time.monotonic()
+    context = parse_invocation(sys.orig_argv, sys.argv)
+    context["deadline"] = started + context.pop("seconds")
+    require(sys.version_info[:3] == (3, 12, 3), "bootstrap requires Python 3.12.3")
+    require(os.getuid() == 1000 and os.getgid() == 1000, "bootstrap requires UID/GID1000")
+    if context["mode"] == "stage-v1":
+        root = Path("/workspace")
+        require(root.resolve() == root and stat.S_ISDIR(os.lstat(root).st_mode)
+                and os.lstat(root).st_uid == 1000 and not os.listdir(root), "fresh owned stage volume")
+        require(shutil.disk_usage(root).free >= 10 * 1024**3, "stage requires 10 GiB actual free space")
+        bodies = admit_capsules(CapsuleReader(sys.stdin.buffer, context["deadline"]),
+                                root / "authority", context["capsules"])
+    else:
+        root = Path("/candidate-input")
+        require(root.resolve() == root and stat.S_ISDIR(os.lstat(root).st_mode)
+                and os.statvfs(root).f_flag & os.ST_RDONLY, "read-only candidate input required")
+        authority = root / "authority"
+        require(authority.resolve() == authority and stat.S_ISDIR(os.lstat(authority).st_mode)
+                and set(os.listdir(authority)) == {UTILITY, ENTRY}, "closed mounted authority")
+        bodies = [checked_file(authority / name, record)
+                  for name, record in zip((UTILITY, ENTRY), context["capsules"])]
+    # The wire cannot select a namespace, filename, entry point or expression.
+    namespace = {"__name__": "candidate_capture_authenticated", "__file__": str(root / "authority" / ENTRY)}
+    exec(compile(bodies[1], namespace["__file__"], "exec"), namespace)
+    if context["mode"] == "stage-v1":
+        namespace["stage"](context)
+    else:
+        body = namespace["legacy"].read_regular(root / namespace["DESCRIPTOR_NAME"], MAX_JSON)
+        descriptor = namespace["validate_descriptor"](json.loads(body))
+        require(namespace["encoded"](descriptor) == body and hashlib.sha256(body).hexdigest() ==
+                context["descriptor_sha256"], "mounted descriptor mismatch")
+        authority = {r["path"]: r for r in descriptor["authority"]}
+        require(authority["scripts/conditional-capture-bootstrap.py"]["sha256"] ==
+                hashlib.sha256(context["bootstrap"]).hexdigest(), "actual bootstrap bytes mismatch")
+        for record, name in zip(context["capsules"], (UTILITY, ENTRY)):
+            require(record == {key: authority["scripts/" + name][key] for key in ("bytes", "sha256")},
+                    "mounted capsule descriptor mismatch")
+        namespace["verify_materialized"](root, descriptor, context["deadline"])
+        namespace["guest"](context)
+
+
+if __name__ == "__main__":
+    try:
+        main()
+    except Exception as error:
+        print("candidate bootstrap failed: " + str(error), file=sys.stderr)
+        sys.exit(1)

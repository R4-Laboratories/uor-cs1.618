+    def test_child_interruption_no_stage_success(self):
+        descriptor = self.root / "descriptor.json"
+        descriptor.write_bytes(candidate.encoded(self.descriptor))
+        child = subprocess.Popen(["/usr/bin/python3", "-I", "-B", str(Path(__file__).resolve()),
+                                  "--materialize-child", str(descriptor), str(self.destination)],
+                                 stdin=subprocess.PIPE, stdout=subprocess.PIPE, stderr=subprocess.PIPE)
+        try:
+            child.stdin.write(b"partial")
+            child.stdin.flush()
+            # Wait for an actual materializer-created root, bounded independently.
+            deadline = time.monotonic() + 3
+            while not self.destination.exists() and time.monotonic() < deadline:
+                time.sleep(0.005)
+            self.assertTrue(self.destination.exists())
+            child.send_signal(signal.SIGTERM)
+            stdout, stderr = child.communicate(timeout=3)
+            self.assertEqual(child.returncode, -signal.SIGTERM)
+            self.assertNotIn(b"input_eof_observed", stdout)
+            self.assertFalse((self.destination / candidate.DESCRIPTOR_NAME).exists())
+        finally:
+            if child.poll() is None:
+                child.kill()
+                child.communicate()

+    def test_readback_extra_fixture_mode_and_authority_mutation(self):
+        for mutation in ("fixture", "extra", "mode", "authority", "elf", "alias"):
+            destination = self.root / mutation
+            self.materialize(destination=destination)
+            path = destination / "candidate-source/data"
+            if mutation == "fixture":

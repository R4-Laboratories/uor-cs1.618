+                self.assertEqual(result.stdout, b"")
+        parsed = bootstrap.parse_invocation(arguments, ["-c"] + arguments[5:])
+        self.assertEqual(parsed["bootstrap"], (HERE / candidate.BOOTSTRAP_NAME).read_bytes())
+        for args in (["python3"] + arguments[1:], [arguments[0], "-B", "-I"] + arguments[3:]):
+            with self.assertRaises(RuntimeError):
+                bootstrap.parse_invocation(args, ["-c"] + args[5:])
+        with self.assertRaises(RuntimeError):

+                parent.chmod(0o700)
+                (parent / "extra").write_bytes(b"unmeasured")
+            elif mutation == "extra":
+                destination.chmod(0o700)
+                (destination / "extra").write_bytes(b"extra")
+            elif mutation == "mode":
+                path.chmod(0o500)
+            elif mutation == "authority":
+                path = destination / "authority" / candidate.ENTRY_NAME
+                path.chmod(0o600)
+                path.write_bytes(b"substituted")
+            elif mutation == "elf":

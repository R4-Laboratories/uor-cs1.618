+// Diagnostics are a separate owned sibling. This indexes available bytes only;
+// absent channels and an exit code cannot establish completeness or success.
+export function verifyCandidateDiagnostics(captureRoot) {
+  const directory = captureRoot + '.candidate-diagnostics';
+  const stat = lstatSync(directory, {throwIfNoEntry:false}); if (!stat) return null;
+  assert.equal(realpathSync(directory), directory);
+  assert.ok(stat.isDirectory() && stat.uid === process.getuid() && (stat.mode & 0o777) === 0o700);
+  const manifest = regular(join(directory, 'manifest.json'), MIB, true), value = JSON.parse(manifest.body);
+  assert.deepEqual(manifest.body, canonicalTransport(value));
+  assert.match(value.owner_token, /^[0-9a-f]{32}$/);
+  const caps = {'capture.stderr':32*MIB, 'capture.stdout':32*MIB, 'exception.stderr':32*MIB,
+    'exception.stdout':32*MIB, 'execute.stderr':MIB, 'owner.stderr':MIB, 'stage.stderr':MIB};
+  assert.deepEqual(value, {schema:'prismpm/conditional-candidate-diagnostics/1', owner_token:value.owner_token,
+    complete_application_accepted:false, channels:Object.keys(caps).sort().map(path => ({path, maximum_bytes:caps[path]})),
+    aggregate_limits:{capture:64*MIB, exception:32*MIB}});
+  const files = []; let capture = 0, exception = 0;
+  for (const path of readdirSync(directory).sort()) {
+    assert.ok(path === 'manifest.json' || Object.hasOwn(caps, path), 'closed diagnostic channel');
+    const row = regular(join(directory, path), path === 'manifest.json' ? MIB : caps[path]);
+    if (path.startsWith('capture.')) capture += row.bytes;
+    if (path.startsWith('exception.')) exception += row.bytes;
+    files.push({path, bytes:row.bytes, sha256:row.sha256});
+  }
+  assert.ok(capture <= 64*MIB && exception <= 32*MIB);
+  const after = lstatSync(directory); assert.equal(after.ino, stat.ino); assert.equal(after.dev, stat.dev);
+  return {schema:'prismpm/private-candidate-diagnostics-index/1', directory, owner_token:value.owner_token,
+    complete_application_accepted:false, completeness:'not asserted', files};
+}

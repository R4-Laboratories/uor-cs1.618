+  assert.equal(envelope.schema, 'prismpm/conditional-candidate-transport-evidence/1');
+  assert.equal(envelope.route, ROUTE); assert.equal(envelope.complete_application_accepted, false);
+  assert.equal(envelope.scope, 'current exact-source conditional capture in immutable SDK; not installed-controller acceptance');
+  const d = envelope.descriptor;
+  closed(d, 'schema route source_root source_selection source fixture_inputs source_sha256 fixture_inputs_sha256 union union_sha256 authority executable_bytes executable_sha256 listing_sha256 test_count remaining_seconds sdk_image runtime', 'input descriptor');
+  assert.equal(d.schema, 'prismpm/conditional-candidate-capture-input/1'); assert.equal(d.route, ROUTE);
+  assert.equal(d.source_root, sourceRoot);
+  assert.ok(/^\/workspaces\/(?!\.{1,2}$)[A-Za-z0-9_.-]+$/.test(sourceRoot)
+    || /^\/tmp\/prismpm-publication-capture-[A-Za-z0-9_-]{6,64}\/source$/.test(sourceRoot), 'protected runtime source root');
+  assert.equal(d.source_selection, lstatSync(join(sourceRoot, '.git'), {throwIfNoEntry:false}) ? 'tracked' : 'private');
+  if (d.source_selection === 'private') assert.match(sourceRoot, /^\/tmp\/prismpm-publication-capture-[A-Za-z0-9_-]{6,64}\/source$/);

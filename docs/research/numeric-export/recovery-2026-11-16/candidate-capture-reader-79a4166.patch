+const MIB = 1048576, MAX_TREE = 512 * MIB, MAX_FILE = 256 * MIB;
+const SDK = 'ghcr.io/uor-foundation/prismpm-sdk@sha256:d6c263a733a6bc36e0458c3f5b9a1f5ea9c14dfbe8c257d3f650a960b5fe633c';
+const ROUTE = 'candidate-source-v1', ENVELOPE = 'candidate-transport-evidence.json';
+const UTILITY = 'ca09b9de3bf57c3e2dc16e11d4d1a527b9b2f1f271566bb7a87846d0a24f8e9a';
+const LAUNCHER = 'ac11aadd31f0a3e40df7866cc7690be8e7c8c252120146d718471358840ed6dd';
+const AUTHORITY = ['conditional-capture-bootstrap.py', 'conditional-capture-candidate-command.mjs',
+  'conditional-capture-candidate.py', 'conditional-capture-sdk.py', 'sdk-command-owner.mjs', 'sdk-command-owner.py']
+  .map(name => 'scripts/' + name);
+const FIXTURES = ['examples/Calculator/src', 'stdlib/src/Foundation', 'stdlib/src/Production'];
+const TEST = 'oci::publication_context::capture_tests::actual_source_free_capture_constructs_complete_conditional_context';
+const sha = bytes => createHash('sha256').update(bytes).digest('hex');
+const order = (a, b) => Buffer.compare(Buffer.from(a), Buffer.from(b));
+function scalar(value) {
+  assert.equal(typeof value, 'string');
+  for (const character of value) assert.ok(!/[\ud800-\udfff]/u.test(character), 'Unicode scalar strings only');
+  return value;
+}
+// Python ensure_ascii=True, sort_keys=True, separators=(',', ':'), plus one LF.
+// Sorting keys by Unicode scalar order agrees with UTF-8 order, unlike JS UTF-16.
+export function canonicalTransport(value) {
+  function encode(value, depth = 0) {
+    assert.ok(depth <= 64, 'bounded transport JSON depth');
+    if (typeof value === 'string') return JSON.stringify(scalar(value))
+      .replace(/[\u007f-\uffff]/g, char => '\\u' + char.charCodeAt(0).toString(16).padStart(4, '0'));
+    if (value === null || typeof value === 'boolean') return JSON.stringify(value);
+    if (typeof value === 'number') {assert.ok(Number.isSafeInteger(value) && !Object.is(value, -0)); return String(value);}
+    if (Array.isArray(value)) return '[' + value.map(child => encode(child, depth + 1)).join(',') + ']';
+    assert.ok(value && Object.getPrototypeOf(value) === Object.prototype, 'plain closed transport object');
+    return '{' + Object.keys(value).sort(order).map(key => encode(key, depth + 1) + ':' + encode(value[key], depth + 1)).join(',') + '}';
+  }
+  const bytes = Buffer.from(encode(value) + '\n'); assert.ok(bytes.length <= 32 * MIB, 'transport JSON bound'); return bytes;
+}
+const digest = value => sha(canonicalTransport(value));
+function closed(value, keys, label) {
+  assert.ok(value && !Array.isArray(value) && typeof value === 'object', label);
+  assert.deepEqual(Object.keys(value).sort(), keys.split(' ').sort(), 'closed ' + label);
+}
+function integer(value, low, high) {assert.ok(Number.isSafeInteger(value) && value >= low && value <= high, 'bounded exact integer');}
+function hash(value) {assert.equal(typeof value, 'string'); assert.match(value, /^[0-9a-f]{64}$/);}
+function pathName(value, capture = false) {
+  scalar(value); assert.ok(value && !/[\\\x00-\x1f\x7f]/.test(value)
+    && value.split('/').every(part => part && part !== '.' && part !== '..' && (capture || part !== '.git')),
+  'canonical confined transport path'); return value;
+}
+function rows(value, {ancestors = true, capture = false} = {}) {
+  assert.ok(Array.isArray(value) && value.length > 0 && value.length <= 100000, 'bounded nonempty rows');
+  const kinds = new Map(); let total = 0, previous;
+  for (const row of value) {
+    pathName(row.path, capture);
+    if (previous !== undefined) assert.ok(order(previous, row.path) < 0, 'strict UTF-8 row order');
+    previous = row.path; kinds.set(row.path, row.kind);
+    if (row.kind === 'file') {
+      closed(row, 'path kind bytes sha256 executable', 'file row'); integer(row.bytes, 0, MAX_FILE); hash(row.sha256);
+      assert.equal(typeof row.executable, 'boolean'); total += row.bytes;
+    } else if (row.kind === 'directory') closed(row, 'path kind', 'directory row');
+    else {
+      assert.equal(row.kind, 'link'); closed(row, 'path kind target', 'alias row'); scalar(row.target);
+      assert.ok(row.target && !row.target.startsWith('/') && !/[\\\x00-\x1f\x7f]/.test(row.target), 'relative alias');
+    }
+  }
+  assert.ok(total <= MAX_TREE, 'complete tree byte bound');
+  for (const row of value) {
+    const paths = [row.path];
+    if (row.kind === 'link') {
+      const target = pathName(posix.normalize(posix.join(posix.dirname(row.path), row.target)), capture);
+      assert.notEqual(target, row.path); assert.ok(['file', 'directory'].includes(kinds.get(target)), 'direct measured alias'); paths.push(target);
+    }
+    for (const path of paths) for (let parent = posix.dirname(path); parent !== '.'; parent = posix.dirname(parent))
+      assert.ok(kinds.get(parent) === 'directory' || (!ancestors && !kinds.has(parent)), 'measured real directory ancestor');
+  }
+  return value;
+}
+function stable(before, after) {
+  for (const key of ['dev', 'ino', 'mode', 'nlink', 'uid', 'gid', 'size', 'mtimeNs', 'ctimeNs'])
+    assert.equal(after[key], before[key], 'stable independently measured member ' + key);
+}
+function regular(path, maximum = MAX_FILE, retain = false) {
+  assert.equal(realpathSync(path), path, 'unaliased measured regular member');
+  const fd = openSync(path, constants.O_RDONLY | constants.O_NOFOLLOW | constants.O_NONBLOCK);
+  try {
+    const stat = fstatSync(fd, {bigint:true});
+    assert.ok(stat.isFile() && stat.nlink === 1n && stat.size <= BigInt(maximum), 'bounded singly linked member');
+    const size = Number(stat.size), buffer = Buffer.alloc(Math.min(65536, Math.max(1, size))), parts = [], h = createHash('sha256');
+    for (let offset = 0; offset < size;) {
+      const count = readSync(fd, buffer, 0, Math.min(buffer.length, size - offset), null); assert.ok(count > 0);
+      h.update(buffer.subarray(0, count)); if (retain) parts.push(Buffer.from(buffer.subarray(0, count))); offset += count;
+    }
+    assert.equal(readSync(fd, buffer, 0, 1, null), 0);
+    stable(stat, fstatSync(fd, {bigint:true})); stable(stat, lstatSync(path, {bigint:true}));
+    return {bytes:size, sha256:h.digest('hex'), executable:!!(stat.mode & 0o100n), body:retain ? Buffer.concat(parts) : undefined};
+  } finally {closeSync(fd);}
+}
+function measuredTree(root, {source = false, omitEnvelope = false} = {}) {
+  assert.equal(realpathSync(root), root); assert.ok(lstatSync(root).isDirectory());
+  const result = []; let bytes = 0;
+  function visit(path) {
+    pathName(path, !source); assert.ok(result.length < 100000);
+    const absolute = join(root, path), stat = lstatSync(absolute, {bigint:true});
+    if (stat.isSymbolicLink()) {
+      const target = readlinkSync(absolute), resolved = resolve(dirname(absolute), target);
+      assert.ok(!target.startsWith('/') && resolved.startsWith(root + '/'));
+      assert.equal(realpathSync(absolute), resolved, 'unchained measured alias'); result.push({path, kind:'link', target});
+    } else if (stat.isDirectory()) {
+      result.push({path, kind:'directory'});
+      if (source || path !== 'producer-source/target') for (const name of readdirSync(absolute).sort(order)) visit(path + '/' + name);
+    } else {
+      const record = regular(absolute); bytes += record.bytes; assert.ok(bytes <= MAX_TREE);
+      result.push({path, kind:'file', bytes:record.bytes, sha256:record.sha256, executable:record.executable});
+    }
+    stable(stat, lstatSync(absolute, {bigint:true}));
+  }
+  for (const name of readdirSync(root).sort(order)) {
+    if (source && ['.git', 'target', '.lexlean', '.prism'].includes(name)) continue;
+    if (omitEnvelope && name === ENVELOPE) continue;
+    visit(name);
+  }
+  rows([...result].sort((a, b) => order(a.path, b.path)), {capture:!source});
+  return source ? result.sort((a, b) => order(a.path, b.path)) : result;
+}
+function normalizedOwned(records) {
+  assert.ok(records instanceof Map, 'independently owned source Map required');
+  return rows([...records].map(([path, record]) => {
+    if (record.kind === 'link') {
+      closed(record, 'kind target resolved', 'owned alias');
+      assert.equal(record.resolved, posix.normalize(posix.join(posix.dirname(path), record.target)), 'owned alias resolution');
+      return {path, kind:'link', target:record.target};
+    }
+    return {path, ...record};
+  }).sort((a, b) => order(a.path, b.path)));
+}
+function successfulResult(result) {
+  const retirement = {scope:'private-linux-subreaper-exhaustion', leader_exit_observed:true, close_observed:true,
+    descendants_absent:true, uncertainty:null, supervisor_status:0, supervisor_signal:null, owner_error:null,
+    protocol_failure:null, python_version:'3.12.3'};
+  assert.deepEqual(result, {status:0, signal:null, timedOut:false, overflow:false, aborted:false,
+    orphaned:false, close_observed:true, retirement}, 'original complete process exhaustion');
+}
+
+export function verifyCandidateTransport({envelopeBytes, sourceRoot, sourceRecords, executable, captureRoot, sdkLock, inventoryBytes}) {
+  assert.ok(Buffer.isBuffer(envelopeBytes) && envelopeBytes.length <= 32 * MIB);

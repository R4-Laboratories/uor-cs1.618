+// cfg(test)-only dispatch. The SDK child always executes the original body.
+fn capture_helper(
+    route: Option<&std::ffi::OsStr>,
+    sdk_child: bool,
+    installed: bool,
+) -> Result<Option<&'static str>, &'static str> {
+    let helper = match route {
+        None => "scripts/conditional-capture-sdk.py",
+        Some(value) if value == "image-owned-v1" => "scripts/conditional-capture-sdk.py",
+        Some(value) if value == "candidate-source-v1" => "scripts/conditional-capture-candidate.py",
+        Some(_) => return Err("unknown PRISMPM_OC10_CAPTURE_ROUTE"),
+    };
+    if sdk_child && !installed {
+        return Err("SDK child lost its installed inventory");
+    }
+    if sdk_child || (installed && helper == "scripts/conditional-capture-sdk.py") {
+        Ok(None)
+    } else {
+        Ok(Some(helper))
+    }
+}

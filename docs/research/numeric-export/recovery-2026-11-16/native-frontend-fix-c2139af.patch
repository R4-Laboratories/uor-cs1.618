+const SDK_LEAN: &str = "/usr/local/elan/toolchains/leanprover--lean4---v4.32.1/bin/lean";
+
+/// Artifact authority is distinct from PATH command authority: SDK Lean and
+/// Lake commands may both be elan, while this artifact is the actual Lean ELF.
+pub(crate) fn lean_artifact_digest(inventory: &Value) -> Result<String, PrismError> {
+    let rows = inventory["artifacts"]
+        .as_array()
+        .ok_or_else(|| fail("SDK artifacts absent"))?;
+    let rows = rows
+        .iter()
+        .filter(|row| row["id"] == "lean")
+        .collect::<Vec<_>>();
+    if rows.len() != 1
+        || rows[0]["kind"] != "binary"
+        || rows[0]["version"] != "4.32.1"
+        || rows[0].as_object().is_none_or(|row| {
+            row.keys()
+                .map(String::as_str)
+                .ne(["digest", "id", "kind", "version"])
+        })
+    {
+        return Err(fail("exact pinned SDK Lean binary artifact required"));
+    }
+    let hash = rows[0]["digest"]
+        .as_str()
+        .and_then(|s| s.strip_prefix("sha256:"))
+        .filter(|s| {
+            s.len() == 64
+                && s.bytes()
+                    .all(|b| b.is_ascii_digit() || (b'a'..=b'f').contains(&b))
+        })
+        .ok_or_else(|| fail("SDK Lean artifact digest malformed"))?;
+    Ok(hash.into())
+}
+
+pub(crate) struct SdkLeanAuthority {
+    path: PathBuf,
+    file: crate::sdk::ExecutableFile,
+    pub(crate) lean_sha256: String,
+}
+impl SdkLeanAuthority {
+    pub(crate) fn verify(&self) -> Result<(), PrismError> {
+        if crate::sdk::inventory_path().as_ref() != Some(&self.path) {
+            return Err(fail("original SDK inventory selection changed"));
+        }
+        self.file
+            .verify_reference(&self.path)
+            .map_err(|e| fail(e.to_string()))
+    }
+}
+
+/// Fresh independent inventory verification, followed by a bounded read bound
+/// to that exact verification digest. The opened metadata stays in custody.
+pub(crate) fn sdk_lean_authority() -> Result<Option<SdkLeanAuthority>, PrismError> {
+    let Some(path) = crate::sdk::inventory_path() else {
+        return Ok(None);
+    };
+    let verified =
+        crate::sdk::verify_environment()?.ok_or_else(|| fail("SDK inventory disappeared"))?;
+    let mut file = crate::sdk::ExecutableFile::open(&path).map_err(|e| fail(e.to_string()))?;
+    if file.len() > 8 * 1024 * 1024 {
+        return Err(fail("SDK inventory exceeds original metadata bound"));
+    }
+    let bytes = file
+        .read_exact_bytes(file.len() as usize)
+        .map_err(|e| fail(e.to_string()))?;
+    if verified["inventory_sha256"] != sha256(&bytes) {
+        return Err(fail("SDK inventory changed after independent verification"));
+    }
+    let inventory: Value = serde_json::from_slice(&bytes).map_err(|e| fail(e.to_string()))?;
+    let authority = SdkLeanAuthority {
+        path,
+        file,
+        lean_sha256: lean_artifact_digest(&inventory)?,
+    };
+    authority.verify()?;
+    Ok(Some(authority))
+}
+
+struct LeanTools {
+    launcher: PathBuf,
+    selected_lean: PathBuf,
+    lean: PathBuf,
+    launcher_file: crate::sdk::ExecutableFile,
+    lean_file: crate::sdk::ExecutableFile,
+    launcher_sha256: String,
+    lean_sha256: String,
+}
+impl LeanTools {
+    fn open(
+        launcher: PathBuf,
+        selected_lean: PathBuf,
+        expected: Option<&str>,
+    ) -> Result<Self, PrismError> {
+        let canonical = |p: &Path| p.canonicalize().map_err(|e| fail(e.to_string()));
+        let lean = canonical(&selected_lean)?;
+        let mut launcher_file = crate::sdk::ExecutableFile::open(&canonical(&launcher)?)
+            .map_err(|e| fail(e.to_string()))?;
+        let mut lean_file =
+            crate::sdk::ExecutableFile::open(&lean).map_err(|e| fail(e.to_string()))?;
+        let launcher_sha256 = launcher_file.sha256().map_err(|e| fail(e.to_string()))?;
+        let lean_sha256 = lean_file.sha256().map_err(|e| fail(e.to_string()))?;
+        if launcher_sha256 == lean_sha256 || expected.is_some_and(|hash| hash != lean_sha256) {
+            return Err(fail(
+                "actual Lean differs from independent binary authority or is the launcher",
+            ));
+        }
+        let tools = Self {
+            launcher,
+            selected_lean,
+            lean,
+            launcher_file,
+            lean_file,
+            launcher_sha256,
+            lean_sha256,
+        };
+        tools.verify()?;
+        Ok(tools)
+    }
+    fn verify(&self) -> Result<(), PrismError> {
+        self.launcher_file
+            .verify_reference(&self.launcher)
+            .map_err(|e| fail(e.to_string()))?;
+        self.lean_file
+            .verify_reference(&self.selected_lean)
+            .map_err(|e| fail(e.to_string()))?;
+        self.lean_file
+            .verify_reference(&self.lean)
+            .map_err(|e| fail(e.to_string()))
+    }
+}

+            require(argv == ["-I", "-B", "-c", "pass"], "fixed never-started inspection argv")
+            return {"role": role, "name": self.prefix + "-" + role, "argv": argv,
+                    "mounts": [], "groups": [], "tmpfs": {**TMPFS,
+                    "/workspace": "rw,noexec,nosuid,nodev,size=16m,mode=1777"}}
+        require(self.inspection_retired, "inspection absence required before stage creation")
+        if role == "execute":
+            require(self.stage_retired, "stage absence required before execution creation")
+            protected_root(source_root)
+        mounts = [{"Type": "volume", "Source": self.volumes["input"],
+                   "Target": "/workspace" if role == "stage" else "/candidate-input",
+                   "ReadOnly": role == "execute"}]
+        if role == "execute":
+            mounts.extend([{"Type": "volume", "Source": self.volumes["input"], "Target": source_root,
+                "ReadOnly": True, "VolumeOptions": {"Subpath": "candidate-source"}},
+                {"Type": "volume", "Source": self.volumes["work"], "Target": "/workspace", "ReadOnly": False},
+                {"Type": "bind", "Source": "/var/run/docker.sock", "Target": "/var/run/docker.sock", "ReadOnly": False}])
+        return {"role": role, "name": self.prefix + "-" + role, "argv": argv,
+                "mounts": mounts, "groups": [] if role == "stage" else [str(socket_gid)], "tmpfs": TMPFS}
+
+    def authenticate(self, actor, spec):
+        require(actor["Id"] and re.fullmatch(r"[0-9a-f]{64}", actor["Id"])
+            and actor["Image"] == self.image and actor["Name"] == "/" + spec["name"]
+            and actor["Config"]["Labels"].get(legacy.LABEL) == self.token
+            and actor["Config"]["Labels"].get(ROLE_LABEL) == spec["role"], "candidate actor ownership differs")
+        known = self.actors[spec["role"]].get("id")
+        require(known is None or known == actor["Id"], "candidate actor identity replaced")
+        return actor["Id"]
+
+    def validate_actor(self, actor, spec):
+        self.authenticate(actor, spec)
+        config, host = actor["Config"], actor["HostConfig"]
+        require(config["Entrypoint"] == ["/usr/bin/python3"] and config["Cmd"] == spec["argv"]
+            and config["User"] == "1000:1000" and config["WorkingDir"] == "/workspace"
+            and config["OpenStdin"] is True and config["Tty"] is False
+            and sorted(config["Env"]) == sorted(self.environment), "actual actor argv/environment differs")
+        require(host["ReadonlyRootfs"] is True and host["NetworkMode"] == "none"
+            and host["AutoRemove"] is False and host["Memory"] == 8 * 1024**3
+            and host["MemorySwap"] == 8 * 1024**3 and host["NanoCpus"] == 2 * 10**9
+            and host["PidsLimit"] == 256 and host["CapDrop"] == ["ALL"] and not host.get("CapAdd")
+            and host["SecurityOpt"] == ["no-new-privileges:true"] and host["Privileged"] is False
+            and not host.get("Devices") and not host.get("Binds") and not host.get("VolumesFrom")
+            and not host.get("PidMode") and host.get("IpcMode") in ("", "private", "none")
+            and not host.get("UsernsMode") and host["Tmpfs"] == spec["tmpfs"]
+            and (host.get("GroupAdd") or []) == spec["groups"], "actual actor resource policy differs")
+        actual_requests = []
+        for mount in host.get("Mounts") or []:
+            require(set(mount) <= {"Type", "Source", "Target", "ReadOnly", "VolumeOptions",
+                    "BindOptions", "Consistency"}, "unexpected mount option")
+            normalized = {k: mount[k] for k in ("Type", "Source", "Target")}
+            normalized["ReadOnly"] = mount.get("ReadOnly", False)
+            if "VolumeOptions" in mount:
+                options = mount["VolumeOptions"]
+                require(set(options) <= {"Subpath", "NoCopy"} and not options.get("NoCopy"), "volume initialization policy")
+                if options.get("Subpath"):
+                    normalized["VolumeOptions"] = {"Subpath": options["Subpath"]}
+            require(not mount.get("BindOptions") and not mount.get("Consistency"), "unexpected mount propagation")
+            actual_requests.append(normalized)
+        require(encoded(actual_requests) == encoded(spec["mounts"]), "exact readonly subpath mount request differs")
+        actual = []
+        for mount in actor["Mounts"]:
+            actual.append((mount["Type"], mount["Name"] if mount["Type"] == "volume" else mount["Source"],
+                           mount["Destination"], mount["RW"]))
+        expected = [(m["Type"], m["Source"], m["Target"], not m["ReadOnly"]) for m in spec["mounts"]]
+        require(sorted(actual) == sorted(expected), "actual actor mount graph differs")
+        return actor
+
+    def create(self, spec):
+        role = spec["role"]
+        require(role in ("inspect", "stage", "execute"), "closed candidate creation role")
+        require(not any(not item["retired"] for item in self.actors.values()),
+                "preceding candidate actor retirement required")
+        require(role == "inspect" or self.inspection_retired, "inspection absence required before creation")
+        require(role != "execute" or self.stage_retired, "stage absence required before execution creation")
+        require(role not in self.actors, "candidate actor recreation refused")
+        self.actors[role] = {"spec": spec, "id": None, "retired": False}
+        args = ["create", "--name", spec["name"], "--label", legacy.LABEL + "=" + self.token,
+                "--label", ROLE_LABEL + "=" + role, "--interactive", "--read-only", "--network", "none",
+                "--user", "1000:1000", "--cap-drop", "ALL", "--security-opt", "no-new-privileges:true",
+                "--memory", "8g", "--memory-swap", "8g", "--cpus", "2", "--pids-limit", "256"]
+        for group in spec["groups"]:
+            args += ["--group-add", group]
+        for path, options in spec["tmpfs"].items():
+            args += ["--tmpfs", path + ":" + options]
+        for mount in spec["mounts"]:
+            text = "type=" + mount["Type"] + ",source=" + mount["Source"] + ",target=" + mount["Target"]
+            if mount["ReadOnly"]:
+                text += ",readonly"
+            if mount.get("VolumeOptions"):
+                text += ",volume-subpath=candidate-source"
+            args += ["--mount", text]
+        args += ["--env", "PRISMPM_TEST_SDK_IMAGE=" + SDK_IMAGE, "--entrypoint", "/usr/bin/python3",
+                 self.image, *spec["argv"]]
+        cid = self.call(*args).stdout.decode().strip()
+        require(re.fullmatch(r"[0-9a-f]{64}", cid), "complete candidate actor ID required")
+        self.actors[role]["id"] = cid
+        actor = self.validate_actor(self.inspect(cid), spec)
+        require(actor["State"]["Status"] == "created" and actor["State"]["Running"] is False
+                and actor["State"]["Pid"] == 0 and actor["State"]["StartedAt"] == "0001-01-01T00:00:00Z",
+                "actor started before policy inspection")
+        return cid
+
+    def references(self, expected=None):
+        names = self.call("container", "ls", "--all", "--no-trunc", "--filter",
+                          "volume=" + self.volumes["input"], "--format", "{{.ID}}").stdout.decode().splitlines()
+        require(names == ([] if expected is None else [expected]), "additional candidate input volume reference")
+
+    def attach(self, role, diagnostics):
+        require(role in ("stage", "execute") and len(self.attachments) < 2,
+                "only two executable candidate attachments")
+        actor = self.actors[role]
+        actual = self.validate_actor(self.inspect(actor["id"]), actor["spec"])
+        require(actual["State"]["Status"] == "created" and actual["State"]["Running"] is False
+                and actual["State"]["Pid"] == 0
+                and actual["State"]["StartedAt"] == "0001-01-01T00:00:00Z", "actor started before attachment")
+        # Do not install a work alarm across Popen's ownership handoff.
+        tick(self.work_deadline)
+        blocked = signal.pthread_sigmask(signal.SIG_BLOCK, {signal.SIGHUP, signal.SIGINT, signal.SIGTERM})
+        try:
+            child = legacy.subprocess.Popen(["docker", "--host", "unix:///var/run/docker.sock", "start",
+                "--attach", "--interactive", actor["id"]], stdin=legacy.subprocess.PIPE,
+                stdout=legacy.subprocess.PIPE, stderr=diagnostics, preexec_fn=legacy.bound_diagnostic_file,
+                env={k: v for k, v in os.environ.items() if not k.startswith("DOCKER_")})
+            self.attachments.append(child)
+        finally:
+            signal.pthread_sigmask(signal.SIG_SETMASK, blocked)
+        return child
+
+    def retire_actor(self, role):
+        item = self.actors[role]
+        if item["retired"]:
+            return
+        spec = item["spec"]
+        ids = self.call("container", "ls", "--all", "--no-trunc", "--filter",
+            "name=^/" + spec["name"] + "$", "--format", "{{.ID}}").stdout.decode().splitlines()
+        require(len(ids) <= 1, "ambiguous candidate actor reconciliation")
+        if ids:
+            actor = self.inspect(ids[0])
+            item["id"] = self.authenticate(actor, spec)
+            self.call("container", "rm", "--force", item["id"])
+        else:
+            require(item["id"] is not None, "pending candidate creation is uncertain")
+        require(self.call("container", "ls", "--all", "--no-trunc", "--filter",
+            "name=^/" + spec["name"] + "$", "--format", "{{.ID}}").stdout == b"", "candidate actor name absence unproven")
+        require(self.call("container", "ls", "--all", "--no-trunc", "--filter", "id=" + item["id"],
+            "--format", "{{.ID}}").stdout == b"", "candidate actor ID absence unproven")
+        item["retired"] = True
+        if role == "stage":
+            self.stage_retired = True
+        if role == "inspect":
+            self.inspection_retired = True
+
+    def wait_attachment(self, child, successful=False):
+        limit = self.work_deadline if successful else self.deadline
+        # At most 30 normal seconds + five forced-reap seconds; both absolute.
+        left = min(30, limit - time.monotonic() - 5)
+        require(left > 0, "candidate attachment retirement deadline")
+        try:
+            status = child.wait(timeout=left)
+        except legacy.subprocess.TimeoutExpired:
+            child.kill()
+            remaining = min(5, limit - time.monotonic())
+            require(remaining > 0, "candidate attachment forced-reap deadline")
+            child.wait(timeout=remaining)
+            raise RuntimeError("candidate attachment force retirement")
+        if successful:
+            require(status == 0, "candidate attachment failed")
+        return status
+
+    def finish(self, completed):
+        self.cleanup_mode = True
+        errors = []
+        for child in self.attachments:
+            if child.stdin and not child.stdin.closed:
+                try:
+                    child.stdin.close()
+                except OSError as error:
+                    errors.append(str(error))
+        # Creation barriers mean at most ONE actor is not already retired.
+        # Worst success: actor 5 + input refs 1 + both volumes 6 = 12 calls.
+        # Early failures never create later actors; pending inspection uses 5.
+        # The hard global cap remains 18, including failed control calls.
+        for role in self.actors:
+            try:
+                self.retire_actor(role)
+            except Exception as error:
+                errors.append(role + " actor: " + str(error))
+        for child in self.attachments:
+            try:
+                if child.poll() is None:
+                    self.wait_attachment(child)
+                if child.stdout:
+                    child.stdout.close()
+            except Exception as error:
+                errors.append("attachment: " + str(error))
+        if completed and not errors and "input" in self.volumes:
+            try:
+                self.references()
+            except Exception as error:
+                errors.append("input references: " + str(error))
+        # Authenticate BOTH volumes before deleting either; ambiguity retains both.
+        owned = []
+        for role, name in self.volumes.items():
+            try:
+                rows = legacy.json.loads(self.call("volume", "inspect", name).stdout)
+                require(type(rows) is list and len(rows) == 1 and rows[0]["Name"] == name
+                        and rows[0]["Labels"].get(legacy.LABEL) == self.token
+                        and rows[0]["Labels"].get(ROLE_LABEL) == role, "candidate volume ownership differs")
+                owned.append(name)
+            except Exception as error:
+                errors.append(role + " volume: " + str(error))
+        if completed and not errors:
+            for name in owned:
+                try:
+                    self.call("volume", "rm", name)
+                    require(self.call("volume", "ls", "--filter", "name=^" + name + "$", "--format",
+                        "{{.Name}}").stdout == b"", "candidate volume absence unproven")
+                except Exception as error:
+                    errors.append("volume retirement: " + str(error))
+                    break
+        else:
+            print("Candidate failure; owned volumes retained; nested-oracle retirement unqualified: "
+                  + legacy.json.dumps(self.volumes, sort_keys=True), file=sys.stderr)
+        require(not errors, "candidate reconciliation unqualified: " + "; ".join(errors))
+        return {"actors": [{"role": role, "name": item["spec"]["name"], "id": item["id"], "absent": True}
+                           for role, item in self.actors.items()],
+                "volumes": [{"role": role, "name": name, "absent": completed} for role, name in self.volumes.items()],
+                "attachment_eof_observed": completed, "cleanup_daemon_calls": self.cleanup_calls}
+
+
+def inspect_runtime(owner):
+    spec = owner.spec("inspect", ["-I", "-B", "-c", "pass"])
+    cid = owner.create(spec)
+    bodies = []
+    for path, limit in ((legacy.INVENTORY, 8 * legacy.MIB),
+                        (legacy.SDK_ROOT / "scripts" / UTILITY_NAME, MAX_MODULE),
+                        (legacy.SDK_ROOT / "scripts/conditional-capture-command.mjs", MAX_MODULE)):
+        actor = owner.validate_actor(owner.inspect(cid), spec)
+        state = actor["State"]
+        require(state["Status"] == "created" and state["Running"] is False and state["Pid"] == 0
+                and state["StartedAt"] == "0001-01-01T00:00:00Z", "image inspection actor must never start")
+        bodies.append(owner.image_file(cid, path, limit))
+    inventory = legacy.json.loads(bodies[0])
+    require(type(inventory) is dict and set(inventory) == {"schema", "commands", "artifacts"}
+            and inventory["schema"] == "prismpm/sdk-inventory/1", "fixed installed SDK inventory required")
+    # Independent reviewed image identities, NOT equality to caller bytes.
+    require(sha(bodies[1]) == UTILITY_SHA256 and sha(bodies[2]) == IMAGE_LAUNCHER_SHA256,
+            "reviewed image authority identity differs")
+    owner.retire_actor("inspect")
+    return {"inventory_sha256": sha(bodies[0]), "image_authority": [
+        {"path": str(legacy.SDK_ROOT / "scripts" / name), "bytes": len(body), "sha256": sha(body)}
+        for name, body in zip((UTILITY_NAME, "conditional-capture-command.mjs"), bodies[1:])]}
+
+
+def bootstrap_argv(source, descriptor, mode, deadline):
+    code = legacy.read_regular(source / "scripts" / BOOTSTRAP_NAME, MAX_BOOTSTRAP)
+    rows = {r["path"]: r for r in descriptor["authority"]}
+    require(sha(code) == rows["scripts/" + BOOTSTRAP_NAME]["sha256"], "bootstrap source custody changed")
+    capsules = [rows["scripts/" + name] for name in (UTILITY_NAME, ENTRY_NAME)]
+    return ["-I", "-B", "-c", code.decode("utf-8", "strict"), mode,
+            str(remaining_seconds(deadline)), digest(descriptor),
+            *[str(r[k]) for r in capsules for k in ("bytes", "sha256")]]
+
+
+def recheck_inputs(source, executable, descriptor, identities, deadline):
+    with deadline_scope(deadline):
+        require(input_identities(source, executable, descriptor, deadline) == identities
+                and ordered(legacy.source_rows(source)) == descriptor["source"]
+                and ordered(legacy.fixture_rows(source)) == descriptor["fixture_inputs"]
+                and measure_regular(executable, legacy.MAX_ELF, deadline, elf=True) == {
+                    "bytes": descriptor["executable_bytes"], "sha256": descriptor["executable_sha256"]},
+                "outer source/fixture/authority/ELF custody changed")
+
+
+def receive_log(reader, length, target):
+    require(type(length) is int and 0 <= length <= 32 * legacy.MIB, "original response stream bound")
+    body = bytearray()
+    while len(body) < length:
+        tick(reader.deadline)
+        if not reader.buffer:
+            reader.fill()
+        count = min(length - len(body), len(reader.buffer))
+        part = bytes(reader.buffer[:count])
+        del reader.buffer[:count]
+        body.extend(part)
+        target.write(part)
+        target.flush()
+    return bytes(body)
+
+
+def receive_capture(reader, response, output):
+    payload = response["payload"]
+    require(payload["stdout_bytes"] + payload["stderr_bytes"] <= 64 * legacy.MIB, "combined original response log bound")
+    stdout = receive_log(reader, payload["stdout_bytes"], sys.stdout.buffer)
+    stderr = receive_log(reader, payload["stderr_bytes"], sys.stderr.buffer)
+    rows = payload["records"]
+    for record in rows:
+        target = output / record["path"]
+        if record["kind"] == "directory":
+            target.mkdir(mode=0o700)
+        elif record["kind"] == "file":
+            body = reader.exact(record["bytes"])
+            require(sha(body) == record["sha256"], "retained original capture bytes differ")
+            _exclusive(target, body, 0o700 if record["executable"] else 0o600)
+    for record in rows:
+        if record["kind"] == "link":
+            os.symlink(record["target"], output / record["path"])
+    require(legacy.tree(output) == rows, "complete original capture readback differs")
+    return stdout, stderr
+
+
+def publish_envelope(output, body, deadline):
+    """Atomic local publication after retirement; remove only our partial file."""
+    pending, final = output / ".candidate-transport-pending.json", output / ENVELOPE_NAME
+    owned = None
+    try:
+        with deadline_scope(deadline):
+            require(not os.path.lexists(final), "occupied transport envelope")
+            _exclusive(pending, body, 0o600)
+            info = os.lstat(pending)
+            owned = (info.st_dev, info.st_ino)
+            require(legacy.read_regular(pending, legacy.MAX_JSON) == body, "transport envelope readback differs")
+            tick(deadline)
+            os.rename(pending, final)
+    except BaseException:
+        for path in (pending, final):
+            if os.path.lexists(path):
+                info = os.lstat(path)
+                if owned is not None and (info.st_dev, info.st_ino) == owned:
+                    os.unlink(path)
+        raise
+
+
+def parent(source: Path, executable: Path) -> int:
+    complete_deadline = time.monotonic() + legacy.DEADLINE_SECONDS
+    require(threading.current_thread() is threading.main_thread(), "candidate parent requires main thread")
+    previous = {s: signal.getsignal(s) for s in (signal.SIGHUP, signal.SIGINT, signal.SIGTERM)}
+    def interrupted(_signal, _frame):
+        raise RuntimeError("candidate capture interrupted")
+    try:
+        for signum in previous:
+            signal.signal(signum, interrupted)
+        return _parent(source, executable, complete_deadline)
+    finally:
+        for signum, handler in previous.items():
+            signal.signal(signum, handler)
+
+
+def _parent(source, executable, complete_deadline):
+    source = protected_root(str(source))  # This refusal precedes every Docker call.
+    require(os.environ.get("PRISMPM_TEST_SDK_IMAGE") == SDK_IMAGE, "exact pinned candidate SDK image required")
+    owner = Lifecycle(complete_deadline, None, [])
+    with deadline_scope(owner.work_deadline):
+        plan = measure_inputs(source, executable, remaining_seconds(owner.work_deadline))
+        identities = input_identities(source, executable, plan, owner.work_deadline)
+    output = Path(os.environ["PRISMPM_OC10_CAPTURE_OUTPUT"]) if "PRISMPM_OC10_CAPTURE_OUTPUT" in os.environ \
+        else Path(legacy.tempfile.mkdtemp(prefix="prismpm-conditional-capture-"))
+    held_output = os.lstat(output)
+    require(output.is_absolute() and output.resolve() == output and stat.S_ISDIR(held_output.st_mode)
+            and held_output.st_uid == os.getuid() and held_output.st_mode & 0o077 == 0
+            and not any(output.iterdir()), "fresh unaliased capture output required")
+    image_rows = legacy.json.loads(owner.call("image", "inspect", SDK_IMAGE).stdout)
+    require(type(image_rows) is list and len(image_rows) == 1, "one actual immutable SDK image required")
+    image = image_rows[0]
+    architecture = {"x86_64": "amd64", "aarch64": "arm64"}.get(os.uname().machine)
+    require(image["Os"] == "linux" and architecture is not None and image["Architecture"] == architecture
+            and re.fullmatch(r"sha256:[0-9a-f]{64}", image["Id"]) and SDK_IMAGE in image["RepoDigests"],
+            "actual local pinned SDK config/platform differs")
+    require(set(image["Config"].get("Volumes") or {}) <= {"/workspace"},
+            "unsupported image-declared anonymous volume")
+    image_environment = image["Config"]["Env"]
+    require(type(image_environment) is list and len({e.split("=", 1)[0] for e in image_environment}) == len(image_environment)
+            and "PATH=/usr/local/elan/bin:/usr/local/cargo/bin:/usr/local/bin:/usr/bin:/bin" in image_environment
+            and not any(e.startswith("PRISMPM_TEST_SDK_IMAGE=") for e in image_environment), "pinned image environment differs")
+    owner.image = image["Id"]
+    owner.environment = image_environment + ["PRISMPM_TEST_SDK_IMAGE=" + SDK_IMAGE]
+    completed, retirement, response, descriptor = False, None, None, None
+    diagnostics = legacy.ExitStack()
+    previous_signals = {s: signal.getsignal(s) for s in (signal.SIGHUP, signal.SIGINT, signal.SIGTERM)}
+    def interrupted(_signal, _frame):
+        raise RuntimeError("candidate capture interrupted")
+    for signum in previous_signals:
+        signal.signal(signum, interrupted)
+    print("Candidate capture infrastructure owner " + legacy.json.dumps({"token": owner.token,
+          "prefix": owner.prefix, "config_digest": owner.image}, sort_keys=True), file=sys.stderr, flush=True)
+    try:
+        socket = os.stat("/var/run/docker.sock")
+        require(stat.S_ISSOCK(socket.st_mode), "actual Docker transport required")
+        observations = inspect_runtime(owner)
+        plan["remaining_seconds"] = remaining_seconds(owner.work_deadline)
+        descriptor = bind_runtime(plan, {"sdk_image": SDK_IMAGE, "config_digest": owner.image,
+            "os": image["Os"], "architecture": image["Architecture"], **observations})
+        owner.volume("input")
+        stage_spec = owner.spec("stage", bootstrap_argv(source, descriptor, "stage-v1", owner.work_deadline))
+        stage_id = owner.create(stage_spec)
+        owner.references(stage_id)
+        stage_errors = diagnostics.enter_context(legacy.infrastructure_diagnostics())
+        attached = owner.attach("stage", stage_errors)
+        for name in (UTILITY_NAME, ENTRY_NAME):
+            body = legacy.read_regular(source / "scripts" / name, MAX_MODULE)
+            row = next(r for r in descriptor["authority"] if r["path"] == "scripts/" + name)
+            require(len(body) == row["bytes"] and sha(body) == row["sha256"], "capsule source changed")
+            legacy.write_bounded(attached.stdin, body, owner.work_deadline)
+        write_inputs(attached.stdin, source, executable, descriptor, owner.work_deadline, identities)
+        attached.stdin.close()
+        reader = Reader(attached.stdout, owner.work_deadline)
+        stage_result = reader.line()
+        require(encoded(stage_result) == encoded(stage_admission(descriptor)), "actual stage admission differs")
+        reader.exhausted()
+        owner.wait_attachment(attached, successful=True)
+        owner.retire_actor("stage")
+        owner.references()
+        recheck_inputs(source, executable, descriptor, identities, owner.work_deadline)
+        owner.volume("work")
+        execution_spec = owner.spec("execute", bootstrap_argv(source, descriptor, "execute-v1", owner.work_deadline),
+                                    str(source), socket.st_gid)
+        execution_id = owner.create(execution_spec)
+        owner.references(execution_id)
+        execution_errors = diagnostics.enter_context(legacy.infrastructure_diagnostics())
+        attached = owner.attach("execute", execution_errors)
+        reader = Reader(attached.stdout, owner.work_deadline)
+        response = checked_candidate_response(reader.line(), descriptor)
+        with deadline_scope(owner.work_deadline):
+            stdout, _stderr = receive_capture(reader, response, output)
+            legacy.checked_result(response["payload"]["result"])
+            legacy.checked_summary(stdout, descriptor["test_count"])
+            receipt = legacy.json.loads(legacy.read_regular(output / "capture-evidence.json", legacy.MAX_JSON))
+            legacy.checked_receipt(receipt, original_descriptor(descriptor), output)
+            recheck_inputs(source, executable, descriptor, identities, owner.work_deadline)
+            current = os.lstat(output)
+            require((current.st_dev, current.st_ino) == (held_output.st_dev, held_output.st_ino), "capture output owner changed")
+        owner.references(execution_id)
+        legacy.write_bounded(attached.stdin, encoded({"retire": True}), owner.work_deadline)
+        attached.stdin.close()
+        reader.exhausted()
+        owner.wait_attachment(attached, successful=True)
+        completed = True
+    except BaseException as error:
+        for name in ("stdout", "stderr"):
+            body = getattr(error, name, b"")

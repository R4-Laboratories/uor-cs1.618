--- /dev/null
+++ b/scripts/conditional-capture-candidate-command.test.mjs
@@ -0,0 +1,87 @@
+// Local launcher logic/process controls; not actual SDK supervisor qualification.
+import assert from 'node:assert/strict';
+import {readFileSync} from 'node:fs';
+import {spawnSync} from 'node:child_process';
+import {fileURLToPath} from 'node:url';
+import test from 'node:test';
+
+const path = fileURLToPath(new URL('./conditional-capture-candidate-command.mjs', import.meta.url));
+const source = readFileSync(path, 'utf8');
+const exactTest = 'oci::publication_context::capture_tests::actual_source_free_capture_constructs_complete_conditional_context';
+const result = {status: 0, signal: null, timedOut: false, overflow: false, aborted: false,
+  orphaned: false, close_observed: true, retirement: {unitFixture: true},
+  stdout: Buffer.from('original stdout'), stderr: Buffer.from('original stderr')};
+let sequence = 0;
+async function unitLauncher({argv = ['/candidate-input/current-test-elf', '/workspace/conditional-capture', '12'],
+  original = result, throwResult = false, directory = true, realpath = '/workspace/conditional-capture'} = {}) {
+  const saved = process.argv;
+  const calls = [], writes = [];
+  const key = `candidateLauncherUnit${++sequence}`;
+  globalThis[key] = {writeFileSync: (...args) => writes.push(args),
+    lstatSync: () => ({isDirectory: () => directory}), realpathSync: () => realpath,
+    executeOwnedSdkCommand: async (...args) => {
+      calls.push(args);
+      if (throwResult) throw Object.assign(Error('fixture failure'), {result: original});
+      return original;
+    }};
+  // Only the test's in-memory copy substitutes dependencies. The on-disk
+  // launcher and both supervisor authority files remain unchanged.
+  const fsImport = "import {writeFileSync, lstatSync, realpathSync} from 'node:fs';";
+  const ownerImport = "import {executeOwnedSdkCommand} from './sdk-command-owner.mjs';";
+  assert(source.includes(fsImport) && source.includes(ownerImport));
+  const unit = source.replace(fsImport, `const {writeFileSync,lstatSync,realpathSync} = globalThis.${key};`)
+    .replace(ownerImport, `const {executeOwnedSdkCommand} = globalThis.${key};`);
+  process.argv = ['node', path, ...argv];
+  try {
+    await import(`data:text/javascript;base64,${Buffer.from(unit).toString('base64')}#${sequence}`);
+    return {calls, writes};
+  } finally {
+    process.argv = saved;
+    delete globalThis[key];
+  }
+}
+
+test('fixed candidate ELF, original exact case and entire original supervisor profile', async () => {
+  const {calls, writes} = await unitLauncher();
+  assert.equal(calls.length, 1);
+  assert.equal(calls[0][0], '/candidate-input/current-test-elf');
+  assert.deepEqual(calls[0][1], ['--exact', exactTest, '--nocapture']);
+  assert.deepEqual(calls[0][2], {profile: 'qualification', environment: process.env,
+    timeout: 12000, limit: 32 * 1024 * 1024, aggregate: true, interruptions: true});
+  assert.deepEqual(writes.map(w => w[0]), ['/workspace/conditional-capture/stdout',
+    '/workspace/conditional-capture/stderr', '/workspace/conditional-capture/command-result.json']);
+  assert(writes.every(w => w[2].flag === 'wx' && w[2].mode === 0o600));
+  assert.equal(writes[0][1], result.stdout);
+  assert.equal(writes[1][1], result.stderr);
+  assert.deepEqual(JSON.parse(writes[2][1]), {status: 0, signal: null, timedOut: false,
+    overflow: false, aborted: false, orphaned: false, close_observed: true, retirement: {unitFixture: true}});
+});
+
+test('failed supervisor result retains exact stdout, stderr and failure fields', async () => {
+  const failed = {...result, status: null, timedOut: true, overflow: true, aborted: true,
+    orphaned: true, close_observed: false, retirement: {unitFixture: 'unqualified'}};
+  const {writes} = await unitLauncher({original: failed, throwResult: true});
+  assert.equal(writes[0][1], result.stdout);
+  assert.equal(writes[1][1], result.stderr);
+  assert.equal(JSON.parse(writes[2][1]).retirement.unitFixture, 'unqualified');
+  assert.equal(JSON.parse(writes[2][1]).timedOut, true);
+});
+
+test('refuses alternative ELF/work/timeout/arity and aliased or missing directory', async () => {
+  for (const argv of [[], ['/workspace/conditional-capture/current-test-elf', '/workspace/conditional-capture', '1'],
+    ['/candidate-input/current-test-elf', '/other', '1'],
+    ...['0', '-1', '1.5', '2401', 'Infinity'].map(seconds =>
+      ['/candidate-input/current-test-elf', '/workspace/conditional-capture', seconds])]) {
+    await assert.rejects(unitLauncher({argv}));
+  }
+  await assert.rejects(unitLauncher({directory: false}));
+  await assert.rejects(unitLauncher({realpath: '/aliased'}));
+});
+
+test('actual Node process refuses wrong ELF before starting supervisor', () => {
+  const child = spawnSync(process.execPath, [path, '/wrong-elf', '/workspace/conditional-capture', '1'],
+    {timeout: 5000, maxBuffer: 1024 * 1024});
+  assert.equal(child.status, 1);
+  assert.match(child.stderr.toString(), /AssertionError/);
+  assert.equal(child.stdout.length, 0);
+});
